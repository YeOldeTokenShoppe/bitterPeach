        if (child.name === "Boombox.181" || child.name === "Boombox.173") {
          console.log(`Adding orange emissive glow to ${child.name}`);

          // Store original material properties if not already stored
          if (!child.userData.originalEmissive && child.material) {
            if (Array.isArray(child.material)) {
              child.userData.originalEmissive = child.material.map((mat) =>
                mat.emissive.clone()
              );
              child.userData.originalEmissiveIntensity = child.material.map(
                (mat) => mat.emissiveIntensity
              );
            } else {
              child.userData.originalEmissive = child.material.emissive.clone();
              child.userData.originalEmissiveIntensity =
                child.material.emissiveIntensity;
            }
          }

          // Apply orange emissive glow when in 80s mode
          if (is80sMode) {
            if (Array.isArray(child.material)) {
              child.material.forEach((mat) => {
                mat.emissive = new THREE.Color(0xff5500); // Orange color
                mat.emissiveIntensity = 0.3;
                mat.needsUpdate = true;
              });
            } else if (child.material) {
              child.material.emissive = new THREE.Color(0xff5500); // Orange color
              child.material.emissiveIntensity = 0.3;
              child.material.needsUpdate = true;
            }
          } else {
            // Restore original emissive properties when not in 80s mode
            if (child.userData.originalEmissive) {
              if (Array.isArray(child.material)) {
                child.material.forEach((mat, index) => {
                  mat.emissive.copy(
                    Array.isArray(child.userData.originalEmissive)
                      ? child.userData.originalEmissive[index]
                      : child.userData.originalEmissive
                  );
                  mat.emissiveIntensity = Array.isArray(
                    child.userData.originalEmissiveIntensity
                  )
                    ? child.userData.originalEmissiveIntensity[index]
                    : child.userData.originalEmissiveIntensity;
                  mat.needsUpdate = true;
                });
              } else if (child.material) {
                child.material.emissive.copy(child.userData.originalEmissive);
                child.material.emissiveIntensity =
                  child.userData.originalEmissiveIntensity;
                child.material.needsUpdate = true;
              }
            }
          }
        }

        // If it's a group with children, make sure all children are also visible/invisible
        if (child.children && child.children.length > 0) {
          child.children.forEach((childObj) => {
            childObj.visible = is80sMode;

            // Also check for the specific objects in children
            if (
              childObj.name === "Boombox.181" ||
              childObj.name === "Boombox.173"
            ) {
              if (is80sMode && childObj.material) {
                // Store original material properties if not already stored
                if (!childObj.userData.originalEmissive) {
                  if (Array.isArray(childObj.material)) {
                    childObj.userData.originalEmissive = childObj.material.map(
                      (mat) => mat.emissive.clone()
                    );
                    childObj.userData.originalEmissiveIntensity =
                      childObj.material.map((mat) => mat.emissiveIntensity);
                  } else {
                    childObj.userData.originalEmissive =
                      childObj.material.emissive.clone();
                    childObj.userData.originalEmissiveIntensity =
                      childObj.material.emissiveIntensity;
                  }
                }

                // Apply orange emissive
                if (Array.isArray(childObj.material)) {
                  childObj.material.forEach((mat) => {
                    mat.emissive = new THREE.Color(0xff5500); // Orange color
                    mat.emissiveIntensity = 0.3;
                    mat.needsUpdate = true;
                  });
                } else {
                  childObj.material.emissive = new THREE.Color(0xff5500); // Orange color
                  childObj.material.emissiveIntensity = 0.3;
                  childObj.material.needsUpdate = true;
                }
              }
            }
          });
        }
      }
    });

    // If no Boombox found by name, try alternative methods
    if (!boomboxFound) {
      // Try to find by texture
      modelRef.current.traverse((child) => {
        if (child.isMesh && child.material && child.material.map) {
          const textureName = child.material.map.name || "";
          if (
            textureName.toLowerCase().includes("boombox") ||
            textureName.toLowerCase().includes("stereo") ||
            textureName.toLowerCase().includes("radio")
          ) {
            console.log(
              `Toggling Boombox by texture: ${child.name}, visible: ${is80sMode}`
            );
            child.visible = is80sMode;
            boomboxFound = true;
          }
        }

        // Try to find by size/position
        if (child.isMesh && !boomboxFound) {
          const box = new THREE.Box3().setFromObject(child);
          const size = box.getSize(new THREE.Vector3());
          const position = child.position;

          if (
            size.x > 10 &&
            size.y > 5 &&
            size.z > 5 &&
            Math.abs(position.y) < 10 &&
            Math.abs(position.x) < 10
          ) {
            console.log(
              `Toggling Boombox by size/position: ${child.name}, visible: ${is80sMode}`
            );
            child.visible = is80sMode;
            boomboxFound = true;
          }
        }
      });
    }

    // Try root object approach if still not found
    if (
      !boomboxFound &&
      modelRef.current.name.toLowerCase().includes("boombox")
    ) {
      console.log(
        `Toggling root model as Boombox: ${modelRef.current.name}, visible: ${is80sMode}`
      );

      modelRef.current.traverse((child) => {
        if (
          child.isMesh &&
          (child.name.includes("speaker") ||
            child.name.includes("button") ||
            child.name.includes("display") ||
            child.name.includes("cassette") ||
            child.name.includes("tape"))
        ) {
          console.log(
            `Toggling Boombox component: ${child.name}, visible: ${is80sMode}`
          );
          child.visible = is80sMode;
        }
      });
    }
  }, [modelRef, is80sMode]);

  // Set up Boombox visibility and glow effect
  useEffect(() => {
    if (!gltf?.scene) return;
    const boomboxLED = gltf.scene.getObjectByName("BoomboxLED_2");
    if (boomboxLED) {
      console.log("🎵 Initial Boombox LED setup:", {
        name: boomboxLED.name,
        is80sMode,
        showSpotify,
      });

      boomboxRef.current = boomboxLED;
      boomboxLED.visible = is80sMode;

      if (boomboxLED.material) {
        boomboxLED.material.emissive = new THREE.Color("#736DFF");
        // Always start with LED off when Spotify is showing
        boomboxLED.material.emissiveIntensity = showSpotify ? 0.0 : 2.0;
        boomboxLED.material.toneMapped = false;
      }
    }
  }, [gltf, is80sMode, showSpotify]); // Add showSpotify dependency

  // Add effect to track showSpotify changes
  useEffect(() => {
    if (boomboxRef.current?.material) {
      console.log("🎵 showSpotify changed:", { showSpotify });
      // Immediately update LED state when showSpotify changes
      boomboxRef.current.material.emissiveIntensity = showSpotify ? 0.0 : 2.0;
    }
  }, [showSpotify]);

  // Use useFrame for continuous animation
  useFrame((state) => {
    if (!boomboxRef.current?.material || !is80sMode) return;

    const material = boomboxRef.current.material;

    // If Spotify is showing, ensure LED is off
    if (showSpotify) {
      if (material.emissiveIntensity !== 0.0) {
        console.log("🎵 Forcing LED off");
        material.emissiveIntensity = 0.0;
      }
      return; // Skip animation when Spotify is showing
    }

    // Only pulse if Spotify is not showing
    const intensity = 2.0 + Math.sin(state.clock.elapsedTime * 3) * 1.0;
    material.emissiveIntensity = intensity;
  });

  // Sync the internal ref with the parent ref
  useEffect(() => {
    if (modelRef) {
      modelRef.current = internalModelRef.current;
    }
  }, [modelRef, internalModelRef.current]);

  // Add a key handler to toggle candle type with the 'c' key
  useEffect(() => {
    const handleKeyDown = (event) => {
      if (event.key === "c" || event.key === "C") {
        console.log("C key pressed - toggling candle type");
        toggleCandleType();
      }
    };

    window.addEventListener("keydown", handleKeyDown);

    return () => {
      window.removeEventListener("keydown", handleKeyDown);
    };
  }, [toggleCandleType]);

  // Add a visual indicator to the found candle
  useEffect(() => {
    if (!internalModelRef.current) return;

    // Find a candle using the same logic as toggleCandleType
    let candle = null;

    // First, try to find any object that might be a candle
    internalModelRef.current.traverse((object) => {
      if (!candle && object.isMesh) {
        // Check for common candle-related names
        const name = object.name.toLowerCase();
        if (
          name.includes("candle") ||
          name.includes("votive") ||
          name.includes("flame") ||
          name.includes("light") ||
          name.includes("lamp")
        ) {
          candle = object;
        }
      }
    });

    // If still not found, try to find by position or size
    if (!candle) {
      internalModelRef.current.traverse((object) => {
        if (!candle && object.isMesh) {
          // Get the bounding box to check size
          const box = new THREE.Box3().setFromObject(object);
          const size = box.getSize(new THREE.Vector3());

          // Check if it's small and positioned on a surface (likely a candle)
          if (
            size.y < 10 && // Not too tall
            size.x < 5 && // Not too wide
            size.z < 5 && // Not too deep
            object.position.y > 0 // Positioned above ground
          ) {
            candle = object;
          }
        }
      });
    }

    if (candle) {
      console.log(`Adding visual indicator to candle: ${candle.name}`);

      // Create a small sphere to indicate this is the test candle
      const indicatorSize = 0.5;
      const indicator = new THREE.Mesh(
        new THREE.SphereGeometry(indicatorSize, 16, 16),
        new THREE.MeshBasicMaterial({
          color: 0xff0000,
          transparent: true,
          opacity: 0.7,
        })
      );

      // Position the indicator above the candle
      const candleWorldPos = new THREE.Vector3();
      candle.getWorldPosition(candleWorldPos);
      indicator.position.copy(candleWorldPos);
      indicator.position.y += 5; // Adjust height as needed

      // Make the indicator interactive
      indicator.userData = {
        isIndicator: true,
        candleRef: candle,
      };

      // Add the indicator to the scene
      scene.add(indicator);

      // Animate the indicator to make it more visible
      const animate = () => {
        if (indicator) {
          indicator.scale.x = 1 + Math.sin(Date.now() * 0.005) * 0.2;
          indicator.scale.y = 1 + Math.sin(Date.now() * 0.005) * 0.2;
          indicator.scale.z = 1 + Math.sin(Date.now() * 0.005) * 0.2;
          indicator.rotation.y += 0.01;
        }
      };

      // Add the animation to the render loop
      const animationId = setInterval(animate, 16);

      return () => {
        clearInterval(animationId);
        scene.remove(indicator);
      };
    }
  }, [internalModelRef, scene]);

  // Add click handler for the indicator
  useEffect(() => {
    if (!internalModelRef.current) return;

    // Create a raycaster for detecting clicks
    const raycaster = new THREE.Raycaster();
    const mouse = new THREE.Vector2();

    // Handle click events
    const handleClick = (event) => {
      // Calculate mouse position in normalized device coordinates
      const canvas = event.target;
      const rect = canvas.getBoundingClientRect();

      mouse.x = ((event.clientX - rect.left) / canvas.clientWidth) * 2 - 1;
      mouse.y = -((event.clientY - rect.top) / canvas.clientHeight) * 2 + 1;

      // Update the raycaster
      raycaster.setFromCamera(mouse, camera);

      // Find intersected objects
      const intersects = raycaster.intersectObjects(scene.children, true);

      // Check if we clicked on the indicator
      for (let i = 0; i < intersects.length; i++) {
        const object = intersects[i].object;

        if (object.userData && object.userData.isIndicator) {
          console.log("Indicator clicked - toggling candle type");
          toggleCandleType();
          break;
        }
      }
    };

    // Add event listener to the canvas
    const canvas = document.querySelector("canvas");
    if (canvas) {
      canvas.addEventListener("click", handleClick);

      return () => {
        canvas.removeEventListener("click", handleClick);
      };
    }
  }, [internalModelRef, scene, camera, toggleCandleType]);

  // Debug: Log all loaded models and their hierarchies
  useEffect(() => {
    if (!internalModelRef.current) return;

    console.log("=== DEBUG: SCENE HIERARCHY ===");

    // Helper function to print the scene hierarchy
    const printSceneHierarchy = (object, indent = 0) => {
      const indentStr = " ".repeat(indent * 2);
      const type = object.type;
      const name = object.name || "(unnamed)";
      const visible = object.visible;

      console.log(
        `${indentStr}- ${name} [${type}] ${visible ? "visible" : "hidden"}`
      );

      if (object.isMesh) {
        const material = object.material
          ? Array.isArray(object.material)
            ? object.material.map((m) => m.type).join(",")
            : object.material.type
          : "none";
        const position = object.position
          .toArray()
          .map((v) => v.toFixed(2))
          .join(", ");
        console.log(
          `${indentStr}  position: (${position}), material: ${material}`
        );
      }

      if (object.children && object.children.length > 0) {
        object.children.forEach((child) => {
          printSceneHierarchy(child, indent + 1);
        });
      }
    };

    // Print the main model hierarchy
    console.log("MAIN MODEL HIERARCHY:");
    printSceneHierarchy(internalModelRef.current);

    // Print the wax candle model hierarchy if available
    if (waxCandleModel && waxCandleModel.scene) {
      console.log("\nWAX CANDLE MODEL HIERARCHY:");
      printSceneHierarchy(waxCandleModel.scene);
    }

    // Print the entire scene hierarchy
    console.log("\nENTIRE SCENE HIERARCHY:");
    printSceneHierarchy(scene);

    console.log("=== END DEBUG ===");
  }, [internalModelRef, waxCandleModel, scene]);

  // Add a UI element to show the loading status of the wax candle model
  useEffect(() => {
    // Create a status element
    const createStatusElement = () => {
      const existingElement = document.getElementById("wax-candle-status");
      if (existingElement) {
        document.body.removeChild(existingElement);
      }

      const statusElement = document.createElement("div");
      statusElement.id = "wax-candle-status";
      statusElement.style.position = "absolute";
      statusElement.style.bottom = "10px";
      statusElement.style.left = "10px";
      statusElement.style.padding = "5px 10px";
      statusElement.style.borderRadius = "5px";
      statusElement.style.fontSize = "12px";
      statusElement.style.zIndex = "1000";

      return statusElement;
    };

    // Update the status based on the current state
    if (waxCandleLoadError) {
      const statusElement = createStatusElement();
      statusElement.style.background = "rgba(255, 0, 0, 0.7)";
      statusElement.style.color = "white";
      statusElement.textContent = `Error loading wax candle: ${waxCandleLoadError}`;
      document.body.appendChild(statusElement);
    } else if (!waxCandleModel) {
      const statusElement = createStatusElement();
      statusElement.style.background = "rgba(0, 0, 0, 0.7)";
      statusElement.style.color = "white";
      statusElement.textContent = "Loading wax candle model...";
      document.body.appendChild(statusElement);
    } else {
      // Remove the status element if it exists
      const existingElement = document.getElementById("wax-candle-status");
      if (existingElement) {
        document.body.removeChild(existingElement);
      }
    }

    // Cleanup function
    return () => {
      const existingElement = document.getElementById("wax-candle-status");
      if (existingElement) {
        document.body.removeChild(existingElement);
      }
    };
  }, [waxCandleModel, waxCandleLoadError]);

  return (
    <>
      <primitive
        ref={internalModelRef}
        object={gltf.scene}
        scale={[scale, scale, scale]}
        rotation={rotation}
        onClick={handleClick}
        style={{
          pointerEvents: showFloatingViewer ? "none" : "auto",
        }}
      />
      <DarkClouds />
    </>
  );
}

// Add this line at the bottom to preload the model
useGLTF.preload("/altarBoomboxCandles.glb");
useGLTF.preload("/XCandle.glb"); // Preload the wax candle model

export { Sun }; // Export the Sun component
export default Model;
