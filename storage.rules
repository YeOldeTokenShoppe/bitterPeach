rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Default rule - deny access unless specified below
    match /{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }
    
    // Audio folder - anyone can read, only admin can write
    match /audio/{file=**} {
      allow read: if true;  // Public read access
      allow write: if request.auth != null && request.auth.uid == 'user_2nWNryLvqBLjXW7MBXud0yeocdq';
    }
    
    // Models folder - anyone can read, only admin can write
    match /models/{file=**} {
      allow read: if true;  // Public read access
      allow write: if request.auth != null && request.auth.uid == 'user_2nWNryLvqBLjXW7MBXud0yeocdq';
    }
  }
}