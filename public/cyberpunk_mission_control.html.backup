      // Add a function to check for and click the mic button
      function checkAndClickMicButton() {
        console.log("Checking for SitePal mic button...");

        // Special handling for iOS
        if (isIOS || browserIsSafari) {
          console.log("Using iOS-specific mic button check");

          // On iOS, we may need to force the API call directly
          try {
            // Try direct API call first
            if (typeof AI_vhost_api === "function") {
              console.log("iOS: Using direct API call for mic activation");
              AI_vhost_api("startListening");
              return true;
            }

            // Then try finding the button
            const micButton = document.querySelector(".vhss-aiplayer-mic-p3");
            if (micButton) {
              console.log("iOS: Found mic button, simulating touch");

              // For iOS, simulate both click and touch events
              micButton.dispatchEvent(
                new MouseEvent("mousedown", {
                  bubbles: true,
                  cancelable: true,
                  view: window,
                })
              );

              micButton.dispatchEvent(
                new MouseEvent("click", {
                  bubbles: true,
                  cancelable: true,
                  view: window,
                })
              );

              // iOS Safari may not support TouchEvent constructor
              try {
                // Check if TouchEvent constructor exists
                if (typeof TouchEvent === "function") {
                  micButton.dispatchEvent(
                    new TouchEvent("touchstart", {
                      bubbles: true,
                      cancelable: true,
                      view: window,
                      touches: [
                        new Touch({
                          identifier: Date.now(),
                          target: micButton,
                          clientX: 10,
                          clientY: 10,
                          screenX: 10,
                          screenY: 10,
                          pageX: 10,
                          pageY: 10,
                          radiusX: 2,
                          radiusY: 2,
                        }),
                      ],
                    })
                  );
                } else {
                  // Fallback for browsers that don't support TouchEvent constructor
                  console.log(
                    "TouchEvent constructor not supported, using alternative approach"
                  );

                  // Create and dispatch a synthetic touchstart event
                  const touchEvent = document.createEvent("Event");
                  touchEvent.initEvent("touchstart", true, true);
                  micButton.dispatchEvent(touchEvent);
                }
              } catch (e) {
                console.error("Error creating touch event:", e);
              }

              // Even if these don't work, we'll return true to update the UI
              return true;
            }
          } catch (e) {
            console.error("iOS mic button error:", e);
          }

          // For iOS, we'll pretend we succeeded to update the UI
          return true;
        }

        // Standard path for non-iOS devices
        // Try to find the button in the document
        const micButton = document.querySelector(".vhss-aiplayer-mic-p3");
        if (micButton) {
          console.log("Found SitePal mic button in document, clicking it");
          micButton.click();
          return true;
        }

        // Try to find in iframes
        const iframes = document.querySelectorAll("iframe");
        for (let i = 0; i < iframes.length; i++) {
          try {
            const iframeDoc =
              iframes[i].contentDocument || iframes[i].contentWindow.document;
            const iframeMicButton = iframeDoc.querySelector(
              ".vhss-aiplayer-mic-p3"
            );
            if (iframeMicButton) {
              console.log(
                `Found SitePal mic button in iframe ${i}, clicking it`
              );
              iframeMicButton.click();
              return true;
            }
          } catch (e) {
            console.warn(`Cannot access iframe ${i} content:`, e);
          }
        }

        return false;
      }

      // Function to initialize SitePal on iOS devices
      function initSitePalOnIOS() {
        console.log("Initializing SitePal for iOS...");

        // First, ensure we have a clean container
        const sitepalContainer = document.getElementById("sitepal-container");
        if (!sitepalContainer) {
          console.error("SitePal container not found");
          return;
        }

        // Create a fresh vhss_aiPlayer div
        const aiPlayer = document.createElement("div");
        aiPlayer.id = "vhss_aiPlayer";
        aiPlayer.style.cssText = "text-align: center; color: #67e8f9;";
        aiPlayer.innerHTML = "Loading AI Agent...";
        sitepalContainer.innerHTML = ""; // Clear existing content
        sitepalContainer.appendChild(aiPlayer);

        // Load the embed script if needed
        if (typeof AI_vhost_embed !== "function") {
          console.log("Loading SitePal embed script for iOS...");
          const scriptEl = document.createElement("script");
          scriptEl.src =
            "//vhss-d.oddcast.com/vhost_embed_functions_v4.php?acc=9157686&js=1";
          scriptEl.type = "text/javascript";

          // Use a promise to handle script loading
          new Promise((resolve, reject) => {
            scriptEl.onload = resolve;
            scriptEl.onerror = reject;
            document.head.appendChild(scriptEl);
          })
            .then(() => {
              console.log("SitePal embed script loaded for iOS");
              setTimeout(performIOSEmbed, 500);
            })
            .catch((error) => {
              console.error("Failed to load SitePal script:", error);
            });
        } else {
          performIOSEmbed();
        }

        function performIOSEmbed() {
          try {
            console.log("Performing SitePal embed for iOS...");

            // Define the scene loaded callback *before* embedding
            window.vh_sceneLoaded = function (sceneIndex, portal) {
              console.log(
                `vh_sceneLoaded callback fired for sceneIndex: ${sceneIndex}, portal: ${portal} (iOS)`
              );
              window.sitepalInitialized = true;
              setupIOSHandlers(); // Existing iOS setup

              // Fade out the transmission video
              const deadAir = document.getElementById("deadAir");
              if (deadAir) {
                console.log(
                  "Scene loaded (iOS), fading out transmission video..."
                );
                deadAir.style.opacity = 0;
                setTimeout(() => {
                  console.log("Pausing transmission video after fade (iOS).");
                  deadAir.pause();
                }, 500); // Matches CSS transition duration
              }

              // Attempt microphone activation *after* scene is loaded
              console.log("Scene loaded, attempting microphone activation...");
              activateMicrophone();

              // Notify parent frame that SitePal is ready
              window.parent.postMessage({ type: "SITEPAL_READY" }, "*");

              // Prime audio playback on iOS/Safari using silent speech
              try {
                console.log("Priming browser with silent playback (iOS)...");
                window.saySilent(0);
              } catch (e) {
                console.warn("saySilent(0) failed (iOS):", e);
              }

              // Make the character say "Greetings" (after delay)
              setTimeout(() => {
                try {
                  console.log("Now making AI say 'Greetings' (iOS)...");
                  // Using sayText based on docs for initial greeting
                  sayText("Greetings, how can I help you today?", 8, 1, 6);
                  /* // Previous sayAI call:
                  const response = sayAI(
                    "Greetings", // what to send to the AI
                    244, // voice ID
                    1, // language ID
                    3, // TTS engine ID
                    "", "", // Effects
                    "CB", // Vendor
                    "Bif" // Bot Name
                  );
                  console.log("sayAI('Greetings') status (iOS):", response);
                  */
                } catch (e) {
                  console.error("Error calling sayText (iOS):", e);
                }
              }, 200); // 200ms delay
            };

            // Set up listening status callback (remains the same)
            window.vh_listeningStatusUpdate = function (isListening) {
              console.log("SitePal listening status update:", isListening);
              window.parent.postMessage(
                {
                  type: "SITEPAL_STATE_CHANGE",
                  isListening: isListening,
                },
                "*"
              );
            };

            // Perform the embed with load=0
            AI_vhost_embed(280, 180, 9157686, 244, 1, 0);

            // Trigger the scene load via API
            setTimeout(() => {
              try {
                console.log("Calling loadSceneByID (iOS)...");
                AI_vhost_api("loadSceneByID", "vhss_aiPlayer");
              } catch (e) {
                console.error("Error calling loadSceneByID (iOS):", e);
              }
            }, 100);
          } catch (e) {
            console.error("Error during iOS SitePal embed:", e);
          }
        }

        function setupIOSHandlers() {
          console.log("Setting up iOS handlers...");

          // Mark as initialized
          window.sitepalInitialized = true;
          window.parent.postMessage({ type: "SITEPAL_READY" }, "*");

          // Try to prime audio context
          try {
            if (typeof saySilent === "function") {
              saySilent(0);
              console.log("Audio primed for iOS");
            }
          } catch (e) {
            console.log("iOS audio priming failed:", e);
          }

          // Update UI to DISCONNECT state
          if (callButton) {
            callButton.textContent = "DISCONNECT";
            callButton.classList.add("disconnect");
          }

          // Automatically try to activate the microphone
          setTimeout(() => {
            console.log("Attempting automatic mic activation for iOS...");

            // Try multiple approaches
            const activateMic = () => {
              // 1. Try API call first
              if (typeof AI_vhost_api === "function") {
                console.log("iOS: Using direct API call");
                AI_vhost_api("startListening");
              }

              // 2. Try finding and clicking the button
              const micButton = document.querySelector(".vhss-aiplayer-mic-p3");
              if (micButton) {
                console.log("iOS: Found mic button, clicking it");
                micButton.click();
              }

              // 3. Try iframe buttons
              const sitepalFrame = document.querySelector("#SitePal iframe");
              if (sitepalFrame) {
                try {
                  const iframeDoc =
                    sitepalFrame.contentDocument ||
                    sitepalFrame.contentWindow.document;
                  const iframeButtons = iframeDoc.querySelectorAll(
                    ".vhss-aiplayer-mic-p3"
                  );
                  if (iframeButtons.length > 0) {
                    console.log("iOS: Found mic button in iframe");
                    iframeButtons[0].click();
                  }
                } catch (frameError) {
                  console.log("Cannot access iframe content:", frameError);
                }
              }

              // Notify that we're listening
              window.parent.postMessage(
                {
                  type: "SITEPAL_STATE_CHANGE",
                  isListening: true,
                },
                "*"
              );
            };

            // Try activation immediately and after a short delay
            activateMic();
            setTimeout(activateMic, 1000);
          }, 500);
        }
      }

      // Function to clean up SitePal
      function cleanupSitePal() {
        console.log("Cleaning up SitePal...");

        try {
          // Stop any ongoing processes
          if (typeof AI_vhost_api === "function") {
            console.log("Calling stopSpeaking...");
            AI_vhost_api("stopSpeaking");
            console.log("Calling stopListening...");
            AI_vhost_api("stopListening");
            console.log("Calling unloadScene...");
            AI_vhost_api("unloadScene");
          }

          // Also call the older stop function for robustness
          if (typeof AI_vhost_stop === "function") {
            console.log("Calling AI_vhost_stop()...");
            AI_vhost_stop();
          }

          // Clear the container
          const container = document.getElementById("vhss_aiPlayer");
          if (container) {
            container.innerHTML = "";
          }

          // Remove any lingering iframes
          const iframes = document.querySelectorAll("#SitePal iframe");
          iframes.forEach((iframe) => {
            iframe.src = "about:blank";
            iframe.remove();
          });

          // Reset state
          window.sitepalInitialized = false;

          return true;
        } catch (e) {
          console.error("Error during cleanup:", e);
          return false;
        }
      }

      // Function to update UI when recording starts
      function updateUIForRecording() {
        console.log("Updating UI for recording state");

        // Update button state
        if (callButton) {
          callButton.textContent = "DISCONNECT";
          callButton.classList.add("disconnect");
        }

        // Notify parent frame that we're listening
        window.parent.postMessage(
          {
            type: "SITEPAL_STATE_CHANGE",
            isListening: true,
          },
          "*"
        );

        // Clear the iOS button timer if it exists
        if (window.iosButtonTimer) {
          clearInterval(window.iosButtonTimer);
          window.iosButtonTimer = null;
        }
      }

      // Initialize UI
      updateCallUI();
      updateStationDisplay();

      // Apply appropriate UI state based on URL parameters
      const urlParams = new URLSearchParams(window.location.search);
      const startIn80sMode = urlParams.get("eighties") === "true";

      if (startIn80sMode) {
        isEightiesMode = true;
        updateEightiesUI(true);
      } else {
        isEightiesMode = false;
        updateEightiesUI(false);

        // If not starting in 80s mode, ensure 3D effect is applied
        const missionControlPanel = document.getElementById("mission-control");
      }

      updateLeaderboardUI();

      // Ensure system status is always on
      if (systemStatus) systemStatus.classList.add("active");

      // Add global test functions to \
      // Toggle Leaderboard
      leaderboardToggle.addEventListener("click", () => {
        isLeaderboardExpanded = !isLeaderboardExpanded;
        updateLeaderboardUI();
      });

      // Event Listeners for Control Buttons
      document.querySelectorAll(".control-button").forEach((button) => {
        button.addEventListener("click", () => {
          playClickSound();
          const action = button.getAttribute("data-action");
          handleControlAction(action);
        });
      });

      // Handle Control Actions
      function handleControlAction(action) {
        const indicator = document.querySelector(
          `[data-action="${action}"] .button-indicator`
        );
        if (!indicator) return;

        indicator.classList.add("active");
        setTimeout(() => {
          indicator.classList.remove("active");
        }, 200);

        // Add specific action handling here
        switch (action) {
          case "launch":
            console.log("Launch sequence initiated");
            break;
          case "orbit":
            console.log("Orbit adjustment in progress");
            break;
          case "signal":
            console.log("Signal broadcast initiated");
            break;
          case "return":
            console.log("Return sequence activated");
            break;
        }
      }
    </script>
  </body>
</html>
