<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cyberpunk Mission Control Panel</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap"
      rel="stylesheet"
    />
    <!-- Firebase SDKs (Add these) -->
    <script src="https://www.gstatic.com/firebasejs/9.6.7/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.6.7/firebase-storage-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.6.7/firebase-firestore-compat.js"></script>

    <style>
      body {
        margin: 0;
        padding: 0;
        font-family: monospace;
        background-color: transparent !important;
        color: #67e8f9;
        display: flex;
        justify-content: center;
        height: 100%;
        overflow: hidden;
        width: 100%;
        position: relative;
      }

      .mission-control {
        width: 100%;
        max-width: 450px;
        height: auto; /* Allow height to adjust to content */
        background-image: linear-gradient(to bottom, #0f172a, #1e293b);
        display: flex;
        flex-direction: column;
        padding: 16px;
        border-left: 1px solid #0e7490;
        border-right: 1px solid #0e7490;
        box-shadow: 0 0 15px rgba(6, 182, 212, 0.3),
          inset 0 0 10px rgba(6, 182, 212, 0.1);
        overflow-y: auto;
        position: relative;
        z-index: 1;
        clip-path: inset(0 0 0 0);
        -webkit-clip-path: inset(0 0 0 0);
        box-sizing: border-box;
      }

      .panel-header {
        text-align: center;
        margin-bottom: 16px;
        padding-bottom: 8px;
        border-bottom: 1px solid #0e7490;
      }

      .panel-title {
        font-size: 1.05rem;
        line-height: 1.2;
        letter-spacing: 0.2em;
        font-weight: bold;
        color: #67e8f9;
        text-shadow: -2px 0 #ff0040, 2px 0 #00b4ff;
        margin: 0;
        position: relative;
        /* animation: threedy-flicker 4s infinite; */
      }

      .panel-subtitle {
        font-size: 0.75rem;
        line-height: 1.4;
        color: white;
        text-shadow: -1px 0 #ff0040, 1px 0 #00b4ff;
        letter-spacing: 0.1em;
        margin-top: 4px;
      }

      .video-call {
        margin-bottom: 16px;
        background-color: #000;
        border: 1px solid #134e4a;
        border-radius: 4px;
        overflow: visible;
        position: relative;
        z-index: 50;
      }

      .video-header {
        background-color: #111827;
        padding: 4px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #134e4a;
        font-size: 0.75rem;
      }

      .video-status {
        height: 8px;
        width: 8px;
        border-radius: 50%;
        background-color: #4b5563;
      }

      .video-status.active {
        background-color: #ef4444;
        animation: pulse 2s infinite;
      }

      .video-display {
        height: 180px;
        position: relative;
        background: linear-gradient(45deg, #041c2c, #000);
        overflow: hidden;
      }

      #vhss-aiplayer-inner * {
        position: absolute !important;
        top: 0 !important;
        left: 0 !important;
        width: 100% !important;
        height: 100% !important;
        z-index: 10;
        -webkit-overflow-scrolling: touch;
      }

      /* SitePal main container styles */
      .vhss_bgVideo {
        position: absolute !important;
        top: 0 !important;
        left: 0 !important;
        width: 100% !important;
        height: 100% !important;
        margin: 0 !important;
        background-size: cover !important;
        background-position: center center !important;
        background-repeat: no-repeat !important;
        z-index: 10;
        top: 0 !important;
      }

      /* SitePal character container */
      .vhss_character {
        position: absolute !important;
        bottom: 0 !important;
        left: 0 !important;
        width: 100% !important;
        height: 100% !important;
        z-index: 11;
      }

      /* SitePal canvas */
      .vhss_character canvas {
        position: absolute !important;
        bottom: 0 !important;
        left: 0 !important;
        width: 100% !important;
        height: 100% !important;
        z-index: 12;
      }

      /* SitePal button holder */
      .vhsshtml5_button_holder {
        position: absolute !important;
        bottom: 50.5px !important;
        left: 0 !important;
        width: 100% !important;
        z-index: 13;
      }

      /* SitePal loading logo */
      .waiting_logo {
        position: absolute !important;
        top: 0 !important;
        left: 0 !important;
        width: 100% !important;
        height: 100% !important;
        z-index: 14;
      }

      /* SitePal transcript */
      .vhsshtml5_transcript {
        position: absolute !important;
        bottom: 0 !important;
        left: 0 !important;
        width: 100% !important;
        z-index: 15;
      }

      #sitepal-container {
        position: absolute !important;
        top: 0 !important;
        left: 0 !important;
        width: 100% !important;
        height: 100% !important;
        z-index: 10;
        display: none;
        -webkit-overflow-scrolling: touch;
      }

      #sitepal-container.active {
        display: block;
      }

      /* Ensure video stays behind sitepal when active */
      #video-feed {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 1;
      }

      #video-feed video {
        width: 100%;
        height: 100%;
        object-fit: cover;
        /* Add transition and initial z-index */
        transition: opacity 0.5s ease-out;
        z-index: 15; /* Ensure it's above sitepal-container (z-index 10) during effect */
        display: none; /* Hide initially */
      }

      .video-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-image: repeating-linear-gradient(
          transparent,
          transparent 1px,
          rgba(6, 182, 212, 0.05) 1px,
          rgba(6, 182, 212, 0.05) 2px
        );
        background-size: 100% 2px;
        pointer-events: none;
        z-index: 10;
        display: none;
        -webkit-overflow-scrolling: touch;
      }

      /* 3D video overlay */
      .threedy-mode .video-overlay {
        background-image: repeating-linear-gradient(
          transparent,
          transparent 1px,
          rgba(255, 0, 64, 0.05) 1px,
          rgba(0, 180, 255, 0.05) 2px
        );
        background-size: 100% 2px;
        box-shadow: inset -2px 0 10px rgba(255, 0, 64, 0.1),
          inset 2px 0 10px rgba(0, 180, 255, 0.1);
      }

      /* 80s video overlay */
      .eighties-active .video-overlay {
        background-image: repeating-linear-gradient(
          transparent,
          transparent 1px,
          rgba(217, 70, 239, 0.05) 1px,
          rgba(34, 211, 238, 0.05) 2px
        );
        background-size: 100% 2px;
        box-shadow: inset 0 0 20px rgba(217, 70, 239, 0.1);
        opacity: 0.8;
      }

      .video-gradient {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-image: linear-gradient(
          to bottom,
          transparent,
          rgba(0, 0, 0, 0.5)
        );
        pointer-events: none;
      }

      .video-feed {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        color: #4b5563;
      }

      .video-feed.offline::before,
      .video-feed.offline::after {
        content: "";
        position: absolute;
        background-color: #1f2937;
      }

      .video-feed.offline::before {
        width: 100%;
        height: 1px;
        top: 50%;
      }

      .video-feed.offline::after {
        height: 100%;
        width: 1px;
        left: 50%;
      }

      .self-view {
        position: absolute;
        bottom: 8px;
        right: 8px;
        width: 60px;
        height: 40px;
        background-color: #111827;
        border: 1px solid #0e7490;
        border-radius: 2px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        z-index: 20; /* Ensure it stays above SitePal elements */
      }

      .self-view img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .self-view .emoji-placeholder {
        font-size: 1.75rem;
        color: #67e8f9;
        text-shadow: 0 0 5px #06b6d4;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
        line-height: 1;
      }

      .live-indicator {
        position: absolute;
        bottom: 8px;
        left: 8px;
        font-size: 0.75rem;
        color: #22d3ee;
        animation: pulse 2s infinite;
      }

      .video-controls {
        background-color: #111827;
        padding: 4px;
        display: flex;
        justify-content: space-between;
        position: relative;
        z-index: 100;
      }

      .call-button {
        font-size: 0.75rem;
        font-family: monospace;
        padding: 4px 8px;
        border-radius: 4px;
        cursor: pointer;
        background-color: #1f2937;
        color: #22d3ee;
        border: 1px solid #134e4a;
        box-shadow: 0 0 5px rgba(6, 182, 212, 0.3);
        position: relative;
        z-index: 101;
      }

      .call-button.disconnect {
        color: #f87171;
        border-color: #7f1d1d;
        box-shadow: 0 0 5px rgba(220, 38, 38, 0.3);
      }

      .station-select {
        background-color: #1f2937;
        color: #22d3ee;
        font-size: 0.75rem;
        font-family: monospace;
        padding: 0 4px;
        border: 1px solid #134e4a;
        border-radius: 4px;
        box-shadow: 0 0 3px rgba(6, 182, 212, 0.2);
        position: relative;
        z-index: 101;
      }

      .button-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-bottom: 16px;
      }

      .control-button {
        background-color: #1f2937;
        border-left: 2px solid #ff0040;
        border-right: 2px solid #00b4ff;
        border-top: 1px solid transparent; /* Add transparent top/bottom for consistency */
        border-bottom: 1px solid transparent;
        border-radius: 4px;
        padding: 12px;
        color: #67e8f9;
        font-family: monospace;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center; /* Vertically center content */
        min-height: 62px; /* Ensure consistent minimum height */
        cursor: pointer;
        transition: all 0.3s;
        box-shadow: -2px 0 5px rgba(255, 0, 64, 0.3),
          2px 0 5px rgba(0, 180, 255, 0.3), 0 0 5px rgba(6, 182, 212, 0.2),
          inset 0 0 10px rgba(6, 182, 212, 0.05);
      }

      .control-button:hover {
        background-color: #374151;
        border-left: 2px solid #ff4080;
        border-right: 2px solid #40b4ff;
        box-shadow: -3px 0 10px rgba(255, 0, 64, 0.5),
          3px 0 10px rgba(0, 180, 255, 0.5);
      }

      .button-prefix {
        font-size: 0.75rem;
        line-height: 1.3;
        margin-bottom: 4px;
        opacity: 0.7;
      }

      .button-label {
        font-weight: bold;
        letter-spacing: 0.1em;
        font-size: 0.875rem;
        line-height: 1.3;
      }

      .button-indicator {
        width: 32px;
        height: 4px;
        margin-top: 4px;
        background-color: #0e7490;
        border-radius: 9999px;
      }

      .toggle-section {
        margin-bottom: 16px;
        background-color: #111827;
        padding: 12px;
        border-radius: 4px;
        border: 1px solid #134e4a;
        box-shadow: inset 0 0 10px rgba(0, 0, 0, 0.5);
      }

      .toggle-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
      }

      .toggle-row.music-row {
        flex-wrap: wrap;
      }

      .toggle-row .label-switch-container {
        display: flex;
        width: 100%;
        justify-content: space-between;
        align-items: center;
      }

      .toggle-row:last-child {
        margin-bottom: 0;
      }

      .toggle-label {
        font-size: 0.875rem;
        line-height: 1.4;
      }

      .toggle-switch {
        width: 48px;
        height: 24px;
        background-color: #1f2937;
        border-radius: 9999px;
        position: relative;
        padding: 2px;
        cursor: pointer;
        transition: background-color 0.3s;
      }

      .toggle-switch.active {
        background-color: #134e4a;
        box-shadow: 0 0 5px rgba(6, 182, 212, 0.5);
      }

      .toggle-switch.eighties.active {
        background-color: #4c1d95;
        box-shadow: 0 0 5px rgba(147, 51, 234, 0.5);
      }

      .toggle-switch.music.active {
        background-color: #ca8a04;
        box-shadow: 0 0 5px rgba(234, 179, 8, 0.5);
      }

      .toggle-switch.music:hover {
        box-shadow: 0 0 8px rgba(234, 179, 8, 0.7);
      }

      .toggle-handle {
        width: 18px;
        height: 18px;
        background-color: #e5e7eb;
        border-radius: 50%;
        position: absolute;
        top: 3px;
        left: 3px;
        transition: transform 0.3s;
      }

      .toggle-switch.active .toggle-handle {
        transform: translateX(24px);
      }

      .leaderboard-header {
        width: 100%;
        background-color: #1f2937;
        border-radius: 4px;
        border: 1px solid #134e4a;
        padding: 4px;
        font-family: monospace;
        color: #22d3ee;
        font-size: 0.75rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 4px;
        cursor: pointer;
        box-shadow: 0 0 5px rgba(6, 182, 212, 0.2);
      }

      .leaderboard-content {
        background-color: #111827;
        border-radius: 4px;
        border: 1px solid #134e4a;
        padding: 8px;
        font-family: monospace;
        color: #22d3ee;
        font-size: 0.875rem;
        margin-bottom: 12px;
        box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.7);
        background-image: linear-gradient(to bottom, #0c1721, #0a0f16);
      }

      .leaderboard-header-row {
        display: flex;
        justify-content: space-between;
        font-size: 0.75rem;
        margin-bottom: 4px;
        padding-bottom: 4px;
        border-bottom: 1px solid #1f2937;
      }

      .leaderboard-scrollable {
        height: 128px;
        overflow-y: auto;
        background-image: repeating-linear-gradient(
          transparent,
          transparent 1px,
          rgba(6, 182, 212, 0.03) 1px,
          rgba(6, 182, 212, 0.03) 2px
        );
        background-size: 100% 2px;
      }

      .leaderboard-entry {
        display: flex;
        justify-content: space-between;
        padding: 4px 0;
      }

      .leaderboard-entry.top {
        color: #67e8f9;
        font-weight: bold;
        text-shadow: 0 0 5px #06b6d4;
      }

      .leaderboard-footer {
        margin-top: 8px;
        font-size: 0.75rem;
        text-align: center;
        color: #22d3ee;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .pulse-dot {
        height: 4px;
        width: 4px;
        border-radius: 50%;
        background-color: #22d3ee;
        margin-right: 4px;
        animation: pulse 2s infinite;
      }

      .status-bar {
        margin-top: 16px;
        display: flex;
        justify-content: space-between;
        margin-top: auto; /* Push status bar to the bottom */
      }

      .status-indicator {
        display: flex;
        align-items: center;
      }

      .status-light {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        margin-right: 8px;
        background-color: #ef4444;
      }

      .status-light.active {
        background-color: #22d3ee;
        animation: pulse 2s infinite;
        box-shadow: 0 0 5px #06b6d4, 0 0 5px 2px rgba(255, 255, 255, 0.7),
          -2px 0 8px #ff0040, 2px 0 8px #00b4ff;
      }

      .status-label {
        font-size: 0.75rem;
      }

      .version-info {
        font-size: 0.75rem;
        color: #4b5563;
      }

      .spacer {
        flex-grow: 1;
      }

      @keyframes pulse {
        0% {
          opacity: 1;
        }
        50% {
          opacity: 0.5;
        }
        100% {
          opacity: 1;
        }
      }

      /* Hide scrollbar for Chrome, Safari and Opera */
      .leaderboard-scrollable::-webkit-scrollbar {
        display: none;
      }

      /* Hide scrollbar for IE, Edge and Firefox */
      .leaderboard-scrollable {
        -ms-overflow-style: none; /* IE and Edge */
        scrollbar-width: none; /* Firefox */
      }

      .control-button[data-action="launch"] {
        position: relative;
      }

      .control-button[data-action="launch"]:after {
        content: "";
        position: absolute;
        top: -2px;
        left: -2px;
        right: -2px;
        bottom: -2px;
        border-radius: 6px;
        background: transparent;
        transition: all 0.3s;
      }

      .control-button[data-action="launch"].active {
        background-color: #450a0a;
        border-color: #dc2626;
      }

      .control-button[data-action="launch"].active:after {
        background: linear-gradient(45deg, #dc2626, #450a0a);
        filter: blur(8px);
        opacity: 0.6;
        z-index: -1;
      }

      .control-button[data-action="launch"] .button-indicator {
        background-color: #dc2626;
        transition: all 0.3s;
      }

      .control-button[data-action="launch"].active .button-indicator {
        animation: redPulse 2s infinite;
      }

      .toggle-switch.emergency.active {
        background-color: #991b1b;
        box-shadow: 0 0 15px rgba(239, 68, 68, 0.5);
      }

      .toggle-switch.emergency.active .toggle-handle {
        background-color: #fecaca;
      }

      #vhss-aiplayer-aiformlogs {
        display: none !important;
        opacity: 0 !important;
      }

      /* 80s mode styles */
      .mission-control.eighties-active {
        /* background-image: linear-gradient(to bottom, #0b132b, #2a1786); */
        border-left: 1px solid #d946ef;
        box-shadow: 0 0 12px rgba(217, 70, 239, 0.3),
          inset 0 0 8px rgba(217, 70, 239, 0.1);
      }

      .eighties-active .panel-title {
        color: #d946ef;
        text-shadow: 0 0 3px #d946ef, 0 0 6px #d946ef;
        font-family: "Press Start 2P", cursive;
        font-size: 0.8rem; /* Slightly smaller to match height */
        line-height: 1.5; /* Adjusted line height */
      }

      .eighties-active .panel-subtitle {
        color: #22d3ee;
        font-family: "Press Start 2P", cursive;
        font-size: 0.6rem;
        line-height: 1.4;
      }

      .eighties-active .toggle-label,
      .eighties-active .button-label,
      .eighties-active .button-prefix,
      .eighties-active .status-label {
        font-family: "Press Start 2P", cursive;
        font-size: 0.6rem; /* Adjusted size */
        line-height: 1.5; /* Adjusted line height */
      }

      .eighties-active .control-button {
        border: 1px solid #d946ef !important; /* Consistent 1px border */
        padding: 12px !important; /* Use same padding as base */
        min-height: 62px !important; /* Ensure override for consistency */
        box-shadow: 0 0 3px rgba(217, 70, 239, 0.3) !important;
        background-image: linear-gradient(
          to bottom,
          #0f172a,
          #2a1786
        ) !important;
        border-left: 1px solid #d946ef !important;
        border-right: 1px solid #d946ef !important;
        transition: all 0.3s;
      }

      .eighties-active .control-button:hover {
        /* background-image: linear-gradient(to bottom, #2a1786, #0f172a); */
        transform: translateY(-2px);
        box-shadow: 0 0 6px rgba(217, 70, 239, 0.5);
      }

      .eighties-active .button-indicator {
        background-color: #d946ef;
        box-shadow: 0 0 3px #d946ef;
      }

      .eighties-active .toggle-section,
      .eighties-active .leaderboard-header,
      .eighties-active .leaderboard-content {
        border-color: #d946ef;
      }

      .eighties-active .status-light.active {
        background-color: #22d3ee;
        box-shadow: 0 0 6px #22d3ee;
        animation: flicker 2s infinite;
      }

      /* VHS glitch effect */
      /* @keyframes glitch {
        0% {
          transform: translate(0);
        }
        20% {
          transform: translate(-2px, 2px);
        }
        40% {
          transform: translate(-2px, -2px);
        }
        60% {
          transform: translate(2px, 2px);
        }
        80% {
          transform: translate(2px, -2px);
        }
        100% {
          transform: translate(0);
        }
      } */

      @keyframes flicker {
        0% {
          opacity: 1;
        }
        25% {
          opacity: 0.8;
        }
        30% {
          opacity: 1;
        }
        35% {
          opacity: 0.6;
        }
        40% {
          opacity: 1;
        }
        50% {
          opacity: 0.9;
        }
        75% {
          opacity: 1;
        }
        80% {
          opacity: 0.7;
        }
        100% {
          opacity: 1;
        }
      }

      .eighties-active .panel-title {
        animation: glitch 5s infinite;
      }

      /* Color shifting for VHS effect */
      .color-shift {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        mix-blend-mode: screen;
        pointer-events: none;
        opacity: 0;
        z-index: 998;
        transition: opacity 0.3s ease;
      }

      .color-shift.active {
        opacity: 0.02;
        animation: color-drift 8s infinite;
      }

      .color-shift-red {
        background-color: #ff0000;
        transform: translateX(-1px);
      }

      .color-shift-blue {
        background-color: #0000ff;
        transform: translateX(1px);
      }

      /* Scan line effect for 80s mode */
      .scan-lines {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(
          to bottom,
          rgba(255, 255, 255, 0.02) 50%,
          rgba(0, 0, 0, 0.08) 50%
        );
        background-size: 100% 4px;
        pointer-events: none;
        z-index: 999;
        opacity: 0;
        transition: opacity 0.3s ease;
      }

      .scan-lines.active {
        opacity: 0.7;
      }

      /* CRT power on/off effect */
      .crt-effect {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(2, 6, 23, 0.7); /* Dark blue instead of white */
        opacity: 0;
        pointer-events: none;
        z-index: 1000;
        transition: all 0.15s ease-out;
      }

      /* CRT on animation */
      @keyframes crtOn {
        0% {
          opacity: 0.4; /* Less opaque */
          transform: scale(1);
        }
        50% {
          opacity: 0.3; /* Even less opaque */
          transform: scale(0.98);
        }
        75% {
          opacity: 0.2; /* Even less opaque */
          transform: scale(0.99);
        }
        100% {
          opacity: 0;
          transform: scale(1);
        }
      }

      .crt-on {
        animation: crtOn 0.4s forwards;
      }

      /* Retro cursor for 80s mode */
      .eighties-active * {
        cursor: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' style='fill:none;stroke:%23ff00ff;stroke-width:2px'><rect width='8' height='12'/></svg>")
            0 0,
          auto !important;
      }

      /* Blinking text effect */
      @keyframes blink {
        0%,
        49% {
          opacity: 1;
        }
        50%,
        100% {
          opacity: 0;
        }
      }

      .eighties-active .blinking-cursor {
        display: inline-block;
        width: 8px;
        height: 12px;
        background-color: #ff00ff;
        animation: blink 1s infinite;
        margin-left: 4px;
        vertical-align: middle;
      }

      /* Button press effect */
      .eighties-active .control-button:active {
        transform: translateY(1px);
        box-shadow: 0 0 15px rgba(255, 0, 255, 1);
      }

      /* Button active state for 80s mode */
      .eighties-active .control-button.activated {
        background-image: linear-gradient(to bottom, #3a0ca3, #000000);
        border-color: #00ffff;
        box-shadow: 0 0 10px rgba(0, 255, 255, 0.6);
      }

      .eighties-active .control-button.activated .button-indicator {
        background-color: #00ffff;
        box-shadow: 0 0 5px #00ffff;
      }

      .toggle-switch.eighties:hover {
        box-shadow: 0 0 8px rgba(147, 51, 234, 0.7);
      }

      /* 3D glasses mode styles */
      .threedy-mode {
        position: relative;
        overflow: hidden;
      }

      .threedy-mode .panel-title {
        position: relative;
        text-shadow: -2px 0 #ff0040, 2px 0 #00b4ff;
        color: white;
      }

      .threedy-mode .panel-subtitle {
        position: relative;
        text-shadow: -1px 0 #ff0040, 1px 0 #00b4ff;
        color: white;
      }

      .threedy-mode .button-label,
      .threedy-mode .toggle-label,
      .threedy-mode .status-label,
      .threedy-mode #station-display {
        position: relative;
        text-shadow: -1px 0 #ff0040, 1px 0 #00b4ff;
      }

      .threedy-shadow-red,
      .threedy-shadow-blue {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        opacity: 0.03;
      }

      .threedy-shadow-red {
        box-shadow: inset 0 0 15px 2px #ff0040;
        transform: translateX(-1px);
        z-index: 10;
      }

      .threedy-shadow-blue {
        box-shadow: inset 0 0 15px 2px #00b4ff;
        transform: translateX(1px);
        z-index: 11;
      }

      .threedy-mode .control-button {
        position: relative;
        border: 1px solid transparent; /* Base border */
        border-left: 2px solid #ff0040;
        border-right: 2px solid #00b4ff;
        padding: 11px; /* Keep padding consistent */
        box-shadow: -2px 0 5px rgba(255, 0, 64, 0.3),
          2px 0 5px rgba(0, 180, 255, 0.3);
        transition: all 0.3s ease;
      }

      .threedy-mode .control-button:hover {
        border-left: 2px solid #ff4080;
        border-right: 2px solid #40b4ff;
        box-shadow: -3px 0 10px rgba(255, 0, 64, 0.5),
          3px 0 10px rgba(0, 180, 255, 0.5);
      }

      .threedy-mode .toggle-switch {
        border-left: 1px solid #ff0040;
        border-right: 1px solid #00b4ff;
        box-shadow: -1px 0 3px rgba(255, 0, 64, 0.3),
          1px 0 3px rgba(0, 180, 255, 0.3);
      }

      .threedy-mode .toggle-switch.active {
        background: linear-gradient(
          90deg,
          rgba(255, 0, 64, 0.3),
          rgba(0, 180, 255, 0.3)
        );
      }

      .threedy-mode .toggle-handle {
        box-shadow: -1px 0 2px rgba(255, 0, 64, 0.5),
          1px 0 2px rgba(0, 180, 255, 0.5);
      }

      .threedy-mode .video-call,
      .threedy-mode .toggle-section,
      .threedy-mode .leaderboard-header,
      .threedy-mode .leaderboard-content {
        border-left: 1px solid #ff0040;
        border-right: 1px solid #00b4ff;
        box-shadow: -2px 0 5px rgba(255, 0, 64, 0.2),
          2px 0 5px rgba(0, 180, 255, 0.2);
      }

      .threedy-mode .status-light.active {
        box-shadow: 0 0 5px 2px rgba(255, 255, 255, 0.7), -2px 0 8px #ff0040,
          2px 0 8px #00b4ff;
      }

      /* Flicker and glitch effects for 3D glasses mode */
      @keyframes threedy-flicker {
        0%,
        100% {
          text-shadow: -2px 0 #ff0040, 2px 0 #00b4ff;
        }
        25% {
          text-shadow: -2.5px 0 #ff0040, 1.8px 0 #00b4ff;
        }
        50% {
          text-shadow: -1.8px 0 #ff0040, 2.5px 0 #00b4ff;
        }
        75% {
          text-shadow: -2.2px 0 #ff0040, 2.2px 0 #00b4ff;
        }
      }

      .threedy-mode .panel-title {
        animation: threedy-flicker 4s infinite;
      }

      /* 3D toggle button */
      .toggle-switch.threedy-toggle.active {
        background: linear-gradient(90deg, #ff0040, #00b4ff);
        box-shadow: 0 0 10px rgba(255, 255, 255, 0.5);
      }

      .toggle-switch.threedy-toggle:hover {
        box-shadow: 0 0 8px rgba(255, 255, 255, 0.7);
      }

      /* 80s mode with 3D enhancements - remove these to keep modes separate */
      .eighties-active.threedy-mode .panel-title,
      .eighties-active.threedy-mode .panel-subtitle,
      .eighties-active.threedy-mode .toggle-label,
      .eighties-active.threedy-mode .button-label,
      .eighties-active.threedy-mode .button-prefix,
      .eighties-active.threedy-mode .control-button,
      .eighties-active.threedy-mode .status-label {
        /* Override with blank styles to prevent inheritance */
        text-shadow: none;
        border-left: none;
        border-right: none;
        box-shadow: none;
      }

      /* Override specific 80s styles to ensure they take precedence */
      .eighties-active .panel-title {
        color: #d946ef;
        text-shadow: 0 0 3px #d946ef, 0 0 6px #d946ef !important;
        font-family: "Press Start 2P", cursive;
        font-size: 0.8rem !important; /* Ensure override */
        line-height: 1.5 !important; /* Ensure override */
        animation: glitch 5s infinite;
      }

      .eighties-active .panel-subtitle {
        color: #22d3ee;
        text-shadow: 0 0 3px #22d3ee !important;
        font-family: "Press Start 2P", cursive;
        font-size: 0.6rem !important; /* Ensure override */
        line-height: 1.4 !important; /* Ensure override */
      }

      .eighties-active .toggle-label,
      .eighties-active .button-label,
      .eighties-active .button-prefix,
      .eighties-active .status-label {
        font-family: "Press Start 2P", cursive;
        font-size: 0.6rem !important; /* Ensure override */
        line-height: 1.5 !important; /* Ensure override */
        text-shadow: 0 0 3px #d946ef !important;
      }

      .eighties-active .control-button {
        border: 1px solid #d946ef !important;
        padding: 12px !important; /* Use same padding as base */
        min-height: 62px !important; /* Ensure override for consistency */
        box-shadow: 0 0 3px rgba(217, 70, 239, 0.3) !important;
        background-image: linear-gradient(
          to bottom,
          #0f172a,
          #2a1786
        ) !important;
        border-left: 1px solid #d946ef !important;
        border-right: 1px solid #d946ef !important;
        transition: all 0.3s;
      }

      .stereo-component {
        background-color: #0c1821;
        border-radius: 4px;
        border: 1px solid #134e4a;
        padding: 6px;
        margin-bottom: 10px;
        border-left: 1px solid #ff0040;
        border-right: 1px solid #00b4ff;
        box-shadow: -2px 0 5px rgba(255, 0, 64, 0.2),
          2px 0 5px rgba(0, 180, 255, 0.2), inset 0 0 10px rgba(0, 0, 0, 0.7);
      }

      .stereo-display {
        background-color: #041c2c;
        height: 32px;
        border-radius: 2px;
        margin-bottom: 4px;
        padding: 2px;
        display: flex;
        position: relative;
        overflow: hidden;
        border-left: 1px solid #ff0040;
        border-right: 1px solid #00b4ff;
      }

      .stereo-visualizer {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        width: 100%;
        height: 100%;
        padding: 1px;
      }

      .stereo-bar {
        width: 3px;
        background-color: #22d3ee;
        height: 4px;
        border-radius: 1px;
        transition: height 0.05s ease;
        box-shadow: 0 0 3px rgba(6, 182, 212, 0.5);
      }

      .stereo-active .stereo-bar {
        animation: stereo-bar-animation 0.5s infinite alternate;
      }

      .stereo-controls {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 4px;
      }

      .stereo-button {
        font-family: monospace;
        background-color: #1f2937;
        border: none;
        border-radius: 2px;
        color: #67e8f9;
        font-size: 0.65rem;
        padding: 3px 2px;
        cursor: pointer;
        display: flex;
        justify-content: center;
        align-items: center;
        transition: all 0.3s;
        border-left: 1px solid #ff0040;
        border-right: 1px solid #00b4ff;
        box-shadow: -1px 0 2px rgba(255, 0, 64, 0.2),
          1px 0 2px rgba(0, 180, 255, 0.2);
      }

      .stereo-button:hover {
        background-color: #374151;
      }

      /* Enhance active power button style */
      .stereo-button#stereo-power.active {
        background-color: #06b6d4; /* Cyber blue-teal */
        color: #f0fdf4; /* Light text for contrast */
        box-shadow: 0 0 10px rgba(6, 182, 212, 0.7),
          /* Teal glow */ inset 0 0 5px rgba(6, 182, 212, 0.5),
          -1px 0 2px rgba(255, 0, 64, 0.2), 1px 0 2px rgba(0, 180, 255, 0.2); /* Keep 3D split */
      }

      .stereo-button i {
        margin-right: 2px;
        font-size: 0.75rem;
      }

      .stereo-info {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        font-size: 0.65rem;
        color: #22d3ee;
        white-space: nowrap;
        text-align: center;
        text-shadow: -1px 0 #ff0040, 1px 0 #00b4ff;
        z-index: 10;
        pointer-events: none;
        width: 100%;
      }

      .stereo-track-info {
        animation: marquee 10s linear infinite;
      }

      @keyframes marquee {
        0% {
          transform: translateX(100%);
        }
        100% {
          transform: translateX(-100%);
        }
      }

      /* Enhance active stereo display */
      .stereo-active .stereo-display {
        border: 1px solid #22d3ee; /* Brighter border */
        box-shadow: inset 0 0 8px rgba(6, 182, 212, 0.6),
          0 0 5px rgba(6, 182, 212, 0.4); /* Inner and outer glow */
      }

      /* 80s mode stereo */
      .eighties-active .stereo-component {
        background-color: #0f172a;
        border-color: #d946ef;
        border-left: 1px solid #d946ef;
        border-right: 1px solid #22d3ee;
        box-shadow: -1px 0 3px rgba(217, 70, 239, 0.3),
          1px 0 3px rgba(34, 211, 238, 0.3);
      }

      .eighties-active .stereo-display {
        background-color: #020617;
        border-left: 1px solid #d946ef;
        border-right: 1px solid #22d3ee;
      }

      .eighties-active .stereo-bar {
        background-color: #d946ef;
        box-shadow: 0 0 2px rgba(217, 70, 239, 0.5);
      }

      .eighties-active .stereo-button {
        font-family: "Press Start 2P", cursive;
        font-size: 0.5rem;
        background-color: #0f172a;
        border-left: 1px solid #d946ef;
        border-right: 1px solid #22d3ee;
        color: #fff;
        box-shadow: -1px 0 1px rgba(217, 70, 239, 0.3),
          1px 0 1px rgba(34, 211, 238, 0.3);
      }

      .eighties-active .stereo-button:hover {
        background-color: #2a1786;
      }

      .eighties-active .stereo-button.active {
        background-color: #2a1786;
        box-shadow: 0 0 3px rgba(217, 70, 239, 0.5),
          -1px 0 1px rgba(217, 70, 239, 0.3), 1px 0 1px rgba(34, 211, 238, 0.3);
      }

      .eighties-active .stereo-info {
        font-family: "Press Start 2P", cursive;
        font-size: 0.5rem;
        color: #22d3ee;
        text-shadow: 0 0 3px #22d3ee;
      }

      /* MusicPlayer3 indicator style */
      .mp3-indicator {
        position: absolute;
        top: 1px;
        right: 2px;
        font-size: 0.5rem;
        color: #d946ef;
        text-shadow: 0 0 2px #d946ef;
        opacity: 0;
        transition: opacity 0.3s ease;
      }

      .eighties-active .stereo-active .mp3-indicator {
        opacity: 1;
        animation: mp3-pulse 1.5s infinite alternate;
      }

      @keyframes mp3-pulse {
        0% {
          opacity: 0.5;
        }
        100% {
          opacity: 1;
        }
      }

      /* MusicPlayer3 special styles for 80s mode */
      .eighties-active.mp3-mode .stereo-bar {
        background-color: #d946ef;
        box-shadow: 0 0 2px rgba(217, 70, 239, 0.5);
      }

      /* Special animation for MusicPlayer3 bars */
      @keyframes mp3-bar-animation {
        0% {
          height: var(--min-height, 2px);
        }
        100% {
          height: var(--max-height, 24px);
        }
      }

      .eighties-active.mp3-mode .stereo-active .stereo-bar {
        animation: stereo-bar-animation 0.5s infinite alternate;
      }

      /* Special MP3 track display */
      .eighties-active.mp3-mode .stereo-track-info {
        font-family: "Press Start 2P", cursive;
        color: #22d3ee;
        text-shadow: 0 0 3px #22d3ee;
      }

      /* Stereo bar animation */
      @keyframes stereo-bar-animation {
        0% {
          height: var(--min-height, 2px);
        }
        100% {
          height: var(--max-height, 24px);
        }
      }

      .stereo-active .stereo-bar {
        animation: stereo-bar-animation 0.5s infinite alternate;
      }

      .leaderboard-container {
        margin-top: 10px;
      }

      .leaderboard-header {
        width: 100%;
        background-color: #1f2937;
        border-radius: 4px;
        border: 1px solid #134e4a;
        padding: 4px;
        font-family: monospace;
        color: #22d3ee;
        font-size: 0.75rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 4px;
        cursor: pointer;
        box-shadow: 0 0 5px rgba(6, 182, 212, 0.2);
      }

      /* 3D glasses mode styles for video call */
      .threedy-mode .video-call {
        border-left: 1px solid #ff0040;
        border-right: 1px solid #00b4ff;
        box-shadow: -2px 0 5px rgba(255, 0, 64, 0.2),
          2px 0 5px rgba(0, 180, 255, 0.2);
      }

      .threedy-mode #station-display {
        position: relative;
        text-shadow: -1px 0 #ff0040, 1px 0 #00b4ff;
      }

      .threedy-mode .call-button {
        border-left: 1px solid #ff0040;
        border-right: 1px solid #00b4ff;
        box-shadow: -1px 0 3px rgba(255, 0, 64, 0.2),
          1px 0 3px rgba(0, 180, 255, 0.2);
        text-shadow: -1px 0 #ff0040, 1px 0 #00b4ff;
      }

      .threedy-mode .call-button:hover {
        box-shadow: -2px 0 5px rgba(255, 0, 64, 0.4),
          2px 0 5px rgba(0, 180, 255, 0.4);
      }

      .threedy-mode .call-button.disconnect {
        border-left: 1px solid #ff0040;
        border-right: 1px solid #00b4ff;
        text-shadow: -1px 0 #ff0040, 1px 0 #00b4ff;
      }

      .threedy-mode .station-select {
        border-left: 1px solid #ff0040;
        border-right: 1px solid #00b4ff;
        box-shadow: -1px 0 3px rgba(255, 0, 64, 0.2),
          1px 0 3px rgba(0, 180, 255, 0.2);
        text-shadow: -1px 0 #ff0040, 1px 0 #00b4ff;
      }

      .threedy-mode .station-select:hover {
        box-shadow: -2px 0 5px rgba(255, 0, 64, 0.4),
          2px 0 5px rgba(0, 180, 255, 0.4);
      }

      .threedy-mode .video-status.active {
        box-shadow: 0 0 5px #ef4444, -1px 0 5px #ff0040, 1px 0 5px #00b4ff;
      }

      /* 80s mode video call styles */
      .eighties-active .video-call {
        border: 1px solid #d946ef;
        background-color: #020617;
        box-shadow: 0 0 8px rgba(217, 70, 239, 0.3);
      }

      .eighties-active .video-header {
        background-color: #0f172a;
        border-bottom: 1px solid #d946ef;
        font-family: "Press Start 2P", cursive;
        font-size: 0.55rem;
        color: #22d3ee;
      }

      .eighties-active #station-display {
        color: #22d3ee;
        text-shadow: 0 0 3px #22d3ee;
        font-family: "Press Start 2P", cursive;
        font-size: 0.55rem;
      }

      .eighties-active .video-status.active {
        background-color: #ef4444;
        box-shadow: 0 0 5px #ef4444;
      }

      .eighties-active .video-controls {
        background-color: #0f172a;
        border-top: 1px solid #d946ef;
      }

      .eighties-active .call-button {
        font-family: "Press Start 2P", cursive;
        font-size: 0.55rem;
        background-color: #0f172a;
        border: 1px solid #d946ef;
        color: #22d3ee;
        box-shadow: 0 0 3px rgba(217, 70, 239, 0.4);
      }

      .eighties-active .call-button.disconnect {
        border-color: #ef4444;
        color: #ef4444;
        box-shadow: 0 0 3px rgba(239, 68, 68, 0.4);
      }

      .eighties-active .call-button:hover {
        background-color: #2a1786;
      }

      .eighties-active .station-select {
        font-family: "Press Start 2P", cursive;
        font-size: 0.55rem;
        background-color: #0f172a;
        border: 1px solid #d946ef;
        color: #22d3ee;
        box-shadow: 0 0 3px rgba(217, 70, 239, 0.4);
      }

      .eighties-active .station-select:hover {
        background-color: #2a1786;
      }

      /* Hide SitePal's default loading spinner */
      #sitepal-container .waiting_logo {
        display: none !important;
      }

      /* Styles for the Offline Display */
      #offline-display {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #111827; /* Equivalent to bg-gray-900 */
        color: #4b5563; /* Equivalent to text-gray-600 */
        font-size: 0.875rem; /* text-sm */
        font-family: monospace;
        z-index: 5; /* Below video during transition */
      }

      #offline-display .crosshair-h,
      #offline-display .crosshair-v {
        position: absolute;
        background-color: #374151; /* Equivalent to bg-gray-800 */
      }

      #offline-display .crosshair-h {
        width: 100%;
        height: 1px;
        top: 50%;
        left: 0;
      }

      #offline-display .crosshair-v {
        height: 100%;
        width: 1px;
        left: 50%;
        top: 0;
      }

      #offline-display .scanlines-overlay {
        position: absolute;
        inset: 0;
        background-image: repeating-linear-gradient(
          transparent,
          transparent 1px,
          rgba(6, 182, 212, 0.02) 1px,
          rgba(6, 182, 212, 0.02) 2px
        );
        background-size: 100% 2px;
        pointer-events: none;
      }
      /* End Offline Display Styles */

      /* Connect Button Pulse Animation */
      @keyframes connect-pulse {
        0% {
          box-shadow: 0 0 5px rgba(6, 182, 212, 0.3),
            0 0 8px rgba(34, 211, 238, 0.2);
          border-color: #134e4a;
        }
        50% {
          box-shadow: 0 0 10px rgba(6, 182, 212, 0.6),
            0 0 15px rgba(34, 211, 238, 0.4);
          border-color: #22d3ee;
        }
        100% {
          box-shadow: 0 0 5px rgba(6, 182, 212, 0.3),
            0 0 8px rgba(34, 211, 238, 0.2);
          border-color: #134e4a;
        }
      }

      .initial-pulse {
        animation: connect-pulse 1.5s infinite ease-in-out;
      }
      /* End Connect Button Pulse */

      /* Remove unnecessary music visualizer and equalizer code */
      .music-equalizer,
      .music-bar,
      .music-active .music-bar:nth-child(1),
      .music-active .music-bar:nth-child(2),
      .music-active .music-bar:nth-child(3),
      .music-active .music-bar:nth-child(4),
      .music-active .music-bar:nth-child(5) {
        display: none;
      }

      /* Remove unused animation keyframes by setting to no-op */
      @keyframes equalizer {
        0%,
        100% {
          height: 4px;
        }
      }

      @keyframes color-drift {
        0%,
        100% {
          filter: none;
        }
      }

      @keyframes music-bounce {
        0%,
        100% {
          transform: none;
        }
      }

      @keyframes visualize {
        0%,
        100% {
          transform: none;
        }
      }

      /* Remove unused typing effect styles */
      .typing-container,
      .typing-text {
        display: none;
      }

      /* Remove all music player related styles */
      .music-equalizer,
      .music-active,
      .music-bar,
      .music-title-animation,
      .mission-control-music-active,
      .stereo-component,
      .stereo-display,
      .stereo-visualizer,
      .stereo-bar,
      .stereo-info,
      .stereo-controls,
      .stereo-button,
      .stereo-track-info,
      .mp3-indicator {
        display: none;
      }
    </style>
  </head>
  <body>
    <div class="scan-lines" id="scan-lines"></div>
    <div class="color-shift color-shift-red" id="color-shift-red"></div>
    <div class="color-shift color-shift-blue" id="color-shift-blue"></div>
    <div class="crt-effect" id="crt-effect"></div>
    <div class="mission-control" id="mission-control">
      <div class="threedy-shadow-red" id="threedy-shadow-red"></div>
      <div class="threedy-shadow-blue" id="threedy-shadow-blue"></div>
      <div class="panel-header">
        <h1 class="panel-title">INFIN8O-LUNAR</h1>
        <div class="panel-subtitle">MISSION CONTROL v2.0.80</div>
      </div>

      <!-- Video Call Section -->
      <div class="video-call">
        <div class="video-header">
          <span id="station-display">COMM:/lunar_base_alpha</span>
          <div id="call-status" class="video-status"></div>
        </div>

        <div class="video-display">
          <div id="video-feed" class="video-feed">
            <video
              id="deadAir"
              loop
              muted
              playsinline
              webkit-playsinline
              style="width: 100%; height: 100%; object-fit: cover"
            >
              <source src="/deadAir.mp4" type="video/mp4" />
            </video>
            <!-- Add Offline Display -->
            <div id="offline-display">
              <span>SYS//OFFLINE</span>
              <div class="crosshair-h"></div>
              <div class="crosshair-v"></div>
              <div class="scanlines-overlay"></div>
            </div>
            <div
              id="sitepal-container"
              style="
                display: none;
                width: 100%;
                height: 100%;
                -webkit-overflow-scrolling: touch;
              "
            >
              <script
                type="text/javascript"
                src="//vhss-d.oddcast.com/ai_embed_functions_v1.php"
              ></script>
              <script type="text/javascript">
                // Replace verbose console logging with empty operations in production
                if (location.hostname !== "localhost") {
                  console.log = function () {};
                  console.debug = function () {};
                }

                // Global helper for SitePal API access
                window.sitePalHelper = {
                  initialized: false,

                  initApi: function () {
                    if (
                      typeof AI_vhost_stop === "function" &&
                      typeof AI_vhost_api === "function" &&
                      typeof AI_vhost_destroy === "function"
                    ) {
                      console.log("SitePal API functions accessed globally");
                      this.initialized = true;
                      return true;
                    }
                    return false;
                  },

                  startListening: function () {
                    if (this.initApi() || this.initialized) {
                      try {
                        console.log("Starting SitePal listening via helper");

                        // First try to find and click the mic button directly
                        const micButton = document.querySelector(
                          ".vhss-aiplayer-mic-p3"
                        );
                        if (micButton) {
                          console.log("Found mic button directly, clicking it");
                          micButton.click();
                          return true;
                        }

                        // If button not found, try using the API
                        if (typeof saySilent === "function") {
                          saySilent(0);
                        }
                        setTimeout(() => {
                          AI_vhost_api("startListening");
                        }, 300);
                        return true;
                      } catch (e) {
                        console.error("Error starting SitePal listening:", e);
                      }
                    }
                    return false;
                  },

                  stopListening: function () {
                    if (this.initApi() || this.initialized) {
                      try {
                        console.log("Stopping SitePal listening via helper");
                        AI_vhost_api("stopListening");
                        return true;
                      } catch (e) {
                        console.error("Error stopping SitePal listening:", e);
                      }
                    }
                    return false;
                  },
                };

                function initSitePal() {
                  console.log("Starting SitePal initialization...");

                  // Set a visible loading state
                  const sitepalContainer =
                    document.getElementById("sitepal-container");
                  if (sitepalContainer) {
                    sitepalContainer.innerHTML =
                      '<div id="vhss_aiPlayer" style="text-align: center; color: #67e8f9;">Loading AI Agent...</div>';
                  }

                  // Special iOS initialization path
                  if (isIOS || browserIsSafari) {
                    console.log("Using iOS-specific initialization path");
                    initSitePalOnIOS();
                    return;
                  }

                  // Clear any existing initialization
                  cleanupSitePal();

                  // Load the embed script if not present
                  if (typeof AI_vhost_embed !== "function") {
                    console.log("Loading SitePal embed script...");
                    const scriptEl = document.createElement("script");
                    scriptEl.src =
                      "//vhss-d.oddcast.com/vhost_embed_functions_v4.php?acc=9157686&js=1";
                    scriptEl.type = "text/javascript";
                    document.head.appendChild(scriptEl);

                    scriptEl.onload = function () {
                      console.log("SitePal embed script loaded");
                      setTimeout(performEmbed, 500);
                    };
                  } else {
                    console.log("SitePal embed script already loaded");
                    performEmbed();
                  }

                  function performEmbed() {
                    try {
                      console.log("Performing SitePal embed...");

                      // Set up scene loaded callback before embed
                      window.vh_sceneLoaded = function (sceneIndex, portal) {
                        console.log(
                          `vh_sceneLoaded callback fired for sceneIndex: ${sceneIndex}, portal: ${portal}`
                        );
                        window.sitepalSceneReady = true; // Set flag

                        // Fade out the transmission video
                        const deadAir = document.getElementById("deadAir");
                        if (deadAir) {
                          console.log(
                            "Scene loaded, fading out transmission video..."
                          );
                          deadAir.style.opacity = 0;
                          setTimeout(() => {
                            console.log(
                              "Pausing transmission video after fade."
                            );
                            deadAir.pause();
                          }, 500); // Matches CSS transition duration
                        }

                        // Attempt microphone activation *after* scene is loaded
                        console.log(
                          "Scene loaded, attempting microphone activation..."
                        );
                        activateMicrophone();

                        // Notify parent frame that SitePal is ready
                        window.parent.postMessage(
                          { type: "SITEPAL_READY" },
                          "*"
                        );

                        // Prime audio playback on iOS/Safari using silent speech
                        try {
                          console.log(
                            "Priming browser with silent playback..."
                          );
                          window.saySilent(0);
                        } catch (e) {
                          console.warn("saySilent(0) failed:", e);
                        }

                        // Make the character say "Greetings" (after delay)
                        setTimeout(() => {
                          try {
                            console.log("Now making AI say 'Greetings'...");
                            // Using sayText based on docs for initial greeting
                            sayText(
                              "Greetings, how can I help you today?",
                              8,
                              1,
                              6
                            );
                            /* // Previous sayAI call:
                            const response = sayAI(
                              "Greetings", // what to send to the AI
                              244, // voice ID
                              1, // language ID
                              3, // TTS engine ID
                              "", "", // Effects
                              "CB", // Vendor
                              "Bif" // Bot Name
                            );
                            console.log("sayAI('Greetings') status:", response);
                            */
                          } catch (e) {
                            console.error("Error calling sayText:", e);
                          }
                        }, 200); // 200ms delay
                      };

                      // Set up listening status callback (remains the same)
                      window.vh_listeningStatusUpdate = function (isListening) {
                        console.log(
                          "SitePal listening status update:",
                          isListening
                        );
                        window.parent.postMessage(
                          {
                            type: "SITEPAL_STATE_CHANGE",
                            isListening: isListening,
                          },
                          "*"
                        );
                      };

                      // Perform the embed
                      AI_vhost_embed(280, 180, 9157686, 244, 1, 1);

                      // Set up initialization check
                      let checkCount = 0;
                      const maxChecks = 20;

                      const checkInterval = setInterval(() => {
                        checkCount++;
                        console.log(
                          `Checking SitePal initialization (${checkCount}/${maxChecks})...`
                        );

                        if (window.sitepalInitialized) {
                          console.log("SitePal initialization confirmed");
                          clearInterval(checkInterval);
                          activateMicrophone();
                          return;
                        }

                        // Try to find the mic button
                        const micButton = document.querySelector(
                          ".vhss-aiplayer-mic-p3"
                        );
                        if (micButton) {
                          console.log("Found SitePal mic button!");
                          window.sitepalInitialized = true;
                          clearInterval(checkInterval);
                          window.parent.postMessage(
                            { type: "SITEPAL_READY" },
                            "*"
                          );
                          activateMicrophone();
                          return;
                        }

                        // Check iframes
                        const iframes = document.querySelectorAll("iframe");
                        for (let iframe of iframes) {
                          try {
                            const iframeDoc =
                              iframe.contentDocument ||
                              iframe.contentWindow.document;
                            const iframeMicButton = iframeDoc.querySelector(
                              ".vhss-aiplayer-mic-p3"
                            );
                            if (iframeMicButton) {
                              console.log(
                                "Found SitePal mic button in iframe!"
                              );
                              window.sitepalInitialized = true;
                              clearInterval(checkInterval);
                              window.parent.postMessage(
                                { type: "SITEPAL_READY" },
                                "*"
                              );
                              activateMicrophone();
                              return;
                            }
                          } catch (e) {
                            // Ignore iframe access errors
                          }
                        }

                        if (checkCount >= maxChecks) {
                          console.warn(
                            "SitePal initialization check timed out"
                          );
                          clearInterval(checkInterval);
                          // Try one last time
                          activateMicrophone();
                        }
                      }, 1000);
                    } catch (e) {
                      console.error("Error during SitePal embed:", e);
                    }
                  }
                }

                // New function to handle microphone activation
                function activateMicrophone() {
                  console.log("Attempting to activate microphone...");

                  // Try multiple approaches to activate the microphone
                  let success = false;

                  // 1. Try direct API call first
                  try {
                    if (typeof AI_vhost_api === "function") {
                      console.log("Using direct API call to start listening");
                      AI_vhost_api("startListening");
                      success = true;
                    }
                  } catch (e) {
                    console.warn("API call failed:", e);
                  }

                  // 2. Try finding and clicking the button directly
                  if (!success) {
                    const micButton = document.querySelector(
                      ".vhss-aiplayer-mic-p3"
                    );
                    if (micButton) {
                      console.log("Found mic button directly, clicking it");
                      micButton.click();
                      success = true;
                    }
                  }

                  // 3. Try finding the button in iframes
                  if (!success) {
                    const iframes = document.querySelectorAll("iframe");
                    for (let iframe of iframes) {
                      try {
                        const iframeDoc =
                          iframe.contentDocument ||
                          iframe.contentWindow.document;
                        const iframeMicButton = iframeDoc.querySelector(
                          ".vhss-aiplayer-mic-p3"
                        );
                        if (iframeMicButton) {
                          console.log(
                            "Found mic button in iframe, clicking it"
                          );
                          iframeMicButton.click();
                          success = true;
                          break;
                        }
                      } catch (e) {
                        console.warn("Cannot access iframe content:", e);
                      }
                    }
                  }

                  // 4. Try using the helper
                  if (
                    !success &&
                    window.sitePalHelper &&
                    window.sitePalHelper.startListening
                  ) {
                    console.log("Using sitePalHelper to start listening");
                    if (window.sitePalHelper.startListening()) {
                      success = true;
                    }
                  }

                  // If any method was successful, update the UI
                  if (success) {
                    console.log("Successfully activated microphone");
                    updateUIForRecording();
                  } else {
                    console.warn(
                      "Failed to activate microphone, will retry in 1 second"
                    );
                    // Retry once after a delay
                    setTimeout(activateMicrophone, 1000);
                  }
                }

                // Add message listener for SitePal API calls
                window.addEventListener("message", function (event) {
                  if (event.data.type === "SITEPAL_API_CALL") {
                    console.log("Received SITEPAL_API_CALL:", event.data);

                    // Try to find and click the mic button directly
                    const micButton = document.querySelector(
                      ".vhss-aiplayer-mic-p3"
                    );
                    if (micButton) {
                      console.log("Found mic button, clicking it");
                      micButton.click();
                      return;
                    }

                    // Try API call if button not found
                    try {
                      if (typeof AI_vhost_api === "function") {
                        AI_vhost_api(event.data.command);
                        console.log("API call successful");
                      } else {
                        console.error("AI_vhost_api not available");
                      }
                    } catch (e) {
                      console.error("Error making API call:", e);
                    }
                  }
                });

                // Special handling for ACTIVATE_SITEPAL_MIC message
                window.addEventListener("message", function (event) {
                  if (event.data.type === "ACTIVATE_SITEPAL_MIC") {
                    console.log("Received ACTIVATE_SITEPAL_MIC message");

                    // Try multiple approaches to activate the microphone
                    setTimeout(() => {
                      // 1. Try direct button click
                      const micButton = document.querySelector(
                        ".vhss-aiplayer-mic-p3"
                      );
                      if (micButton) {
                        console.log("Found mic button directly, clicking it");
                        micButton.click();
                        return;
                      }

                      // 2. Try API call
                      if (typeof AI_vhost_api === "function") {
                        console.log("Using API to start listening");
                        AI_vhost_api("startListening");
                        return;
                      }

                      // 3. Try helper
                      if (
                        window.sitePalHelper &&
                        window.sitePalHelper.startListening
                      ) {
                        console.log("Using sitePalHelper to start listening");
                        window.sitePalHelper.startListening();
                      }
                    }, 500);
                  }
                });

                // Add a timer to check and click the mic button when in UN-MUTE state
                /* // Commenting out this interval as it causes ReferenceError
                setInterval(() => {
                  if (isCallActive && callButton.textContent === "UN-MUTE") {
                    console.log("Checking for mic button in interval...");
                    if (checkAndClickMicButton()) {
                      console.log("Successfully clicked mic button");
                      updateUIForRecording();
                    }
                  }
                }, 5000);
                */
              </script>
              <div id="vhss_aiPlayer"></div>
              <!-- Add placeholder elements that SitePal expects -->
              <div id="vhss-aiplayer-aiformlogs"></div>
              <div id="vhss-aiplayer-aiformtranscript"></div>
              <div id="vhss-aiplayer-aiformstatus"></div>
              <div id="vhss-aiplayer-aiformerror"></div>
              <!-- Add the actual mic button class that SitePal uses -->
              <div
                class="vhss-aiplayer-mic-p3"
                id="vhss-aiplayer-mic-p3"
                style="display: none"
              ></div>
            </div>
          </div>
          <div class="video-overlay"></div>
          <div id="self-view" class="self-view" style="display: none"></div>
          <div id="live-indicator" class="live-indicator" style="display: none">
            LIVE//REC
          </div>
          <div class="video-gradient"></div>
        </div>

        <div class="video-controls">
          <button id="call-button" class="call-button">CONNECT</button>
          <select id="station-select" class="station-select">
            <option>LUNAR BASE ALPHA</option>
            <option>MARS OUTPOST</option>
            <option>ORBITAL STATION</option>
            <option>EARTH HQ</option>
          </select>
        </div>
      </div>

      <!-- Button Grid -->
      <div class="button-grid">
        <button class="control-button" data-action="launch">
          <span class="button-prefix">//SYS</span>
          <span class="button-label">LAUNCH</span>
          <div class="button-indicator"></div>
        </button>

        <button class="control-button" data-action="orbit">
          <span class="button-prefix">//NAV</span>
          <span class="button-label">ORBIT</span>
          <div class="button-indicator"></div>
        </button>

        <button class="control-button" data-action="signal">
          <span class="button-prefix">//COM</span>
          <span class="button-label">SIGNAL</span>
          <div class="button-indicator"></div>
        </button>

        <button class="control-button" data-action="return">
          <span class="button-prefix">//RTN</span>
          <span class="button-label">RETURN</span>
          <div class="button-indicator"></div>
        </button>
      </div>

      <!-- Toggle Switches -->
      <div class="toggle-section">
        <div class="toggle-row">
          <span class="toggle-label">80s//MODE</span>
          <div id="eighties-toggle" class="toggle-switch eighties">
            <div class="toggle-handle"></div>
          </div>
        </div>
      </div>

      <!-- Remove Stereo Component -->
      <div class="collapsible-leaderboard">
        <!-- Collapsible Leaderboard -->
        <div class="leaderboard-container">
          <button id="leaderboard-toggle" class="leaderboard-header">
            <span>L34D3RBOARD//v1.2</span>
            <span id="leaderboard-arrow">▼</span>
          </button>

          <div
            id="leaderboard-content"
            class="leaderboard-content"
            style="display: none"
          >
            <div class="leaderboard-header-row">
              <span>USER_ID</span>
              <span>SCR_PTS</span>
            </div>

            <div class="leaderboard-scrollable">
              <div class="leaderboard-entry top">
                <span>Armstrong</span>
                <span>1969</span>
              </div>
              <div class="leaderboard-entry">
                <span>Aldrin</span>
                <span>1890</span>
              </div>
              <div class="leaderboard-entry">
                <span>Collins</span>
                <span>1850</span>
              </div>
              <div class="leaderboard-entry">
                <span>Lovell</span>
                <span>1800</span>
              </div>
              <div class="leaderboard-entry">
                <span>Cernan</span>
                <span>1750</span>
              </div>
            </div>

            <div class="leaderboard-footer">
              <div class="pulse-dot"></div>
              <span>LIVE_DATA//STREAM</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Status Bar -->
      <div class="status-bar">
        <div class="status-indicator">
          <div id="system-status" class="status-light active"></div>
          <span class="status-label">STATUS//OK</span>
          <span
            class="blinking-cursor"
            id="blinking-cursor"
            style="display: none"
          ></span>
        </div>
        <div class="version-info">CYBERCORE_77</div>
      </div>
    </div>

    <script>
      // DOM elements
      const callButton = document.getElementById("call-button");
      const callStatus = document.getElementById("call-status");
      const videoFeed = document.getElementById("video-feed");
      const selfView = document.getElementById("self-view");
      const liveIndicator = document.getElementById("live-indicator");
      const stationSelect = document.getElementById("station-select");
      const stationDisplay = document.getElementById("station-display");
      const eightiesToggle = document.getElementById("eighties-toggle");
      const stereoPower = document.getElementById("stereo-power");
      const stereoNext = document.getElementById("stereo-next");
      const stereoPrev = document.getElementById("stereo-prev");
      const stereoPlayPause = document.getElementById("stereo-play-pause");
      const stereoComponent = document.getElementById("stereo-component");
      const stereoInfo = document.getElementById("stereo-info");
      const systemStatus = document.getElementById("system-status");
      const leaderboardToggle = document.getElementById("leaderboard-toggle");
      const leaderboardContent = document.getElementById("leaderboard-content");
      const leaderboardArrow = document.getElementById("leaderboard-arrow");
      const controlButtons = document.querySelectorAll(".control-button");

      // Helper function to load scripts
      function loadScript(src) {
        return new Promise((resolve, reject) => {
          const script = document.createElement("script");
          script.src = src;
          script.onload = resolve;
          script.onerror = reject;
          document.head.appendChild(script);
        });
      }

      // State
      let isCallActive = false;
      let isEightiesMode = false;

      function playClickSound() {
        try {
          const audioContext = new (window.AudioContext ||
            window.webkitAudioContext)();
          const oscillator = audioContext.createOscillator();
          const gainNode = audioContext.createGain();
          oscillator.type = "sine";
          oscillator.frequency.setValueAtTime(880, audioContext.currentTime); // A5
          gainNode.gain.setValueAtTime(0.1, audioContext.currentTime);
          gainNode.gain.exponentialRampToValueAtTime(
            0.01,
            audioContext.currentTime + 0.1
          );
          oscillator.connect(gainNode);
          gainNode.connect(audioContext.destination);
          oscillator.start();
          oscillator.stop(audioContext.currentTime + 0.1);
        } catch (e) {
          console.log("Audio context error:", e);
        }
      }

      let isLeaderboardExpanded = false;

      // Add iOS detection
      const isIOS =
        /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;
      const browserIsSafari = /^((?!chrome|android).)*safari/i.test(
        navigator.userAgent
      );

      // Log device detection
      console.log("Device detection:", {
        isIOS: isIOS,
        browserIsSafari: browserIsSafari,
        userAgent: navigator.userAgent,
      });

      // Handle initial video playback for iOS
      document.addEventListener("DOMContentLoaded", () => {
        const deadAir = document.getElementById("deadAir");
        const offlineDisplay = document.getElementById("offline-display");
        const callButton = document.getElementById("call-button"); // Get call button

        offlineDisplay.style.display = "flex"; // Show offline state
        deadAir.style.display = "none"; // Hide video initially
        deadAir.pause(); // Ensure video is paused initially

        // Add initial pulse to CONNECT button
        if (callButton) {
          // Check if button exists
          callButton.classList.add("initial-pulse");
        }

        // Special handling for iOS
        if (isIOS || browserIsSafari) {
          console.log("iOS/Safari detected - applying special handling");

          // Add a click handler to the whole document to initialize audio on iOS
          document.addEventListener(
            "click",
            function iosAudioInit() {
              console.log("iOS document click - initializing audio context");
              deadAir
                .play()
                .catch((e) => console.log("iOS initial play rejected:", e));

              // Try to prime the audio early
              try {
                if (typeof saySilent === "function") {
                  saySilent(0);
                }
              } catch (e) {
                console.log("Early audio priming failed:", e);
              }

              // Remove the listener after first click
              document.removeEventListener("click", iosAudioInit);
            },
            { once: true }
          );

          // For iOS we need to specially handle the call button click
          callButton.addEventListener(
            "click",
            function (e) {
              console.log("Call button clicked on iOS");

              // If we're connecting, make sure we always show the UN-MUTE button
              if (!isCallActive) {
                // Set a flag to force the UN-MUTE state on iOS
                window.forceUnmuteOnIOS = true;
              }
            },
            { capture: true }
          );
        }

        // Removed initial play attempt here, now paused by default
        // deadAir
        //   .play()
        //   .catch((e) => console.log("Initial auto-play prevented:", e));
      });

      // --- Audio Priming for Mobile ---
      let hasPrimed = false;
      function primeAudio() {
        if (!hasPrimed) {
          try {
            // Use SitePal's silent function if available, otherwise ignore
            if (typeof window.saySilent === "function") {
              window.saySilent(0); // Play silent audio
              console.log("SitePal saySilent(0) used for audio priming.");
            } else {
              console.log("saySilent not available, skipping audio priming.");
            }
            hasPrimed = true;
          } catch (e) {
            console.error("Error during audio priming:", e);
          }
        }
      }
      // Attach priming to first user interaction
      document.addEventListener("click", primeAudio, { once: true });
      document.addEventListener("touchstart", primeAudio, { once: true });
      // --- End Audio Priming ---

      // Toggle call - Refactored Logic with special iOS handling
      callButton.addEventListener("click", () => {
        if (!isCallActive) {
          // ---- Connect Flow ----
          console.log("Connecting call and initializing SitePal...");
          isCallActive = true;

          // --- Transmission Effect Start ---
          const deadAir = document.getElementById("deadAir");
          const sitepalContainer = document.getElementById("sitepal-container");
          const offlineDisplay = document.getElementById("offline-display"); // Get offline display
          const transmissionEffectDuration = 3500; // ms - Shortened duration
          const fadeOutDuration = 500; // ms (should match CSS transition)

          // Hide offline display
          offlineDisplay.style.display = "none";

          // Make video visible and opaque, then play
          deadAir.style.display = "block";
          deadAir.style.opacity = 1;
          deadAir.muted = true;
          deadAir.loop = true;
          deadAir
            .play()
            .catch((e) => console.error("Transmission video play failed:", e));

          // Show SitePal container behind the video
          sitepalContainer.style.display = "block";
          // --- End Transmission Effect Start ---

          // Activate call status indicator
          callStatus.classList.add("active");

          // REMOVED: deadAir.style.display = 'none'; deadAir.pause();

          // Clean up any existing instance
          if (sitepalContainer.dataset.initialized === "true") {
            console.log("Cleaning up previous SitePal instance...");
            cleanupSitePal();
          }

          // Initialize SitePal
          initSitePal();
          sitepalContainer.dataset.initialized = "true";

          // Update UI
          selfView.style.display = "block";
          updateSelfView();
          liveIndicator.style.display = "block";
          stationSelect.disabled = true;

          // Go directly to DISCONNECT state
          callButton.textContent = "DISCONNECT";
          callButton.classList.add("disconnect");
          console.log("Call connected, button set to DISCONNECT");

          // Try to activate microphone after a short delay
          setTimeout(activateMicrophone, 2000);

          // Add initial pulse to CONNECT button
          callButton.classList.add("initial-pulse");

          // Special handling for iOS
          if (isIOS || browserIsSafari) {
            console.log("iOS/Safari detected - applying special handling");

            // Add a click handler to the whole document to initialize audio on iOS
            document.addEventListener(
              "click",
              function iosAudioInit() {
                console.log("iOS document click - initializing audio context");
                deadAir
                  .play()
                  .catch((e) => console.log("iOS initial play rejected:", e));

                // Try to prime the audio early
                try {
                  if (typeof saySilent === "function") {
                    saySilent(0);
                  }
                } catch (e) {
                  console.log("Early audio priming failed:", e);
                }

                // Remove the listener after first click
                document.removeEventListener("click", iosAudioInit);
              },
              { once: true }
            );

            // For iOS we need to specially handle the call button click
            callButton.addEventListener(
              "click",
              function (e) {
                console.log("Call button clicked on iOS");

                // If we're connecting, make sure we always show the UN-MUTE button
                if (!isCallActive) {
                  // Set a flag to force the UN-MUTE state on iOS
                  window.forceUnmuteOnIOS = true;
                }
              },
              { capture: true }
            );
          }
        } else {
          // ---- Disconnect Flow ----
          console.log("Disconnecting call with static effect...");
          isCallActive = false;

          // 1. Initiate SitePal cleanup immediately
          const sitepalContainer = document.getElementById("sitepal-container");
          if (
            sitepalContainer &&
            sitepalContainer.dataset.initialized === "true"
          ) {
            console.log("Calling cleanupSitePal...");
            if (cleanupSitePal()) {
              sitepalContainer.dataset.initialized = "false";
            }
          }
          // Hide the SitePal container right away
          if (sitepalContainer) {
            sitepalContainer.style.display = "none";
          }

          // 2. Start brief static effect
          const deadAir = document.getElementById("deadAir");
          const offlineDisplay = document.getElementById("offline-display");
          const disconnectStaticDuration = 1500; // ms

          if (deadAir) {
            deadAir.style.display = "block";
            deadAir.style.opacity = 1; // Ensure it's visible
            deadAir.loop = false; // Don't loop for disconnect effect
            deadAir.currentTime = 0; // Rewind to start
            deadAir
              .play()
              .catch((e) => console.error("Disconnect static play failed:", e));
          }

          // 3. Set timeout to switch to offline display
          setTimeout(() => {
            console.log(
              "Disconnect static effect finished. Switching to OFFLINE."
            );
            if (deadAir) {
              deadAir.pause();
              deadAir.style.display = "none"; // Hide video
            }
            if (offlineDisplay) {
              offlineDisplay.style.display = "flex"; // Show offline display
            }
            // Update the rest of the UI *after* the effect
            updateCallUI();
          }, disconnectStaticDuration);

          // REMOVED immediate call to updateCallUI() and manual video reset from here
        }
      });

      // Update station
      stationSelect.addEventListener("change", () => {
        updateStationDisplay();
      });

      // Toggle 80s mode
      eightiesToggle.addEventListener("click", () => {
        const crtEffect = document.getElementById("crt-effect");

        // CRT power on/off effect with less opacity
        crtEffect.style.opacity = "0.4"; // Reduced opacity
        crtEffect.classList.add("crt-on");

        // Toggle the isEightiesMode state
        isEightiesMode = !isEightiesMode;

        // Update UI directly
        updateEightiesUI(isEightiesMode);

        // Play toggle sound
        try {
          const audioContext = new (window.AudioContext ||
            window.webkitAudioContext)();
          const oscillator = audioContext.createOscillator();
          const gainNode = audioContext.createGain();

          oscillator.type = "sine";
          oscillator.frequency.setValueAtTime(
            isEightiesMode ? 800 : 400,
            audioContext.currentTime
          );
          oscillator.frequency.exponentialRampToValueAtTime(
            isEightiesMode ? 400 : 800,
            audioContext.currentTime + 0.1
          );

          gainNode.gain.setValueAtTime(0.1, audioContext.currentTime);
          gainNode.gain.exponentialRampToValueAtTime(
            0.01,
            audioContext.currentTime + 0.1
          );

          oscillator.connect(gainNode);
          gainNode.connect(audioContext.destination);

          oscillator.start();
          oscillator.stop(audioContext.currentTime + 0.1);
        } catch (e) {
          console.log("Audio context not supported");
        }

        // Notify parent of the mode change
        window.parent.postMessage({ type: "EIGHTIES_MODE_CHANGE" }, "*");

        setTimeout(() => {
          crtEffect.style.opacity = "0";
          crtEffect.classList.remove("crt-on");
        }, 150);
      });

      // Update UI functions
      function updateCallUI() {
        // Note: isCallActive state and button text/class are primarily managed
        // by the main callButton event listener now. This function reflects
        // the state onto other UI elements and handles the disconnect cleanup.

        if (isCallActive) {
          // This path is less critical now, mostly for refreshing UI if needed,
          // but the initial setup happens in the event listener.
          if (callStatus) callStatus.classList.add("active");
          const deadAir = document.getElementById("deadAir");
          if (deadAir) {
            deadAir.style.display = "none";
            deadAir.pause();
          }
          const sitepalContainer = document.getElementById("sitepal-container");
          if (sitepalContainer) sitepalContainer.style.display = "block";
          if (selfView) selfView.style.display = "block";
          if (liveIndicator) liveIndicator.style.display = "block";
          if (stationSelect) stationSelect.disabled = true;

          // Ensure button remains clickable (redundant but safe)
          callButton.style.pointerEvents = "auto";

          // Ensure system status is active
          if (systemStatus) systemStatus.classList.add("active");
        } else {
          // ---- Disconnect UI Cleanup ----
          console.log("Updating UI for disconnected state.");
          callButton.textContent = "CONNECT";
          callButton.classList.remove("disconnect");
          callButton.style.pointerEvents = "auto"; // Ensure connect button is clickable
          if (callStatus) callStatus.classList.remove("active");

          const deadAir = document.getElementById("deadAir");
          if (deadAir) {
            // Ensure video is paused and hidden on disconnect
            deadAir.pause();
            deadAir.style.opacity = 1; // Ensure ready for next connect effect
            deadAir.style.display = "none"; // Keep video hidden
          }
          // Show offline display again
          if (offlineDisplay) {
            offlineDisplay.style.display = "flex";
          }

          const sitepalContainer = document.getElementById("sitepal-container");
          if (sitepalContainer) {
            sitepalContainer.style.display = "none";
            // Ensure SitePal is cleaned up if it was initialized
            if (sitepalContainer.dataset.initialized === "true") {
              console.log(
                "Cleaning up SitePal via updateCallUI (disconnect path)"
              );
              if (cleanupSitePal()) {
                sitepalContainer.dataset.initialized = "false";
              }
            }
          }

          if (selfView) selfView.style.display = "none";
          if (liveIndicator) liveIndicator.style.display = "none";
          if (stationSelect) stationSelect.disabled = false;

          // Ensure system status is active
          if (systemStatus) systemStatus.classList.add("active");
        }
      }

      function updateStationDisplay() {
        const station = stationSelect.value.toLowerCase().replace(" ", "_");
        stationDisplay.textContent = `COMM:/${station}`;
      }

      function updatePowerUI() {
        // Empty stub function
      }

      function updateEightiesUI(isActive) {
        const missionControl = document.getElementById("mission-control");
        const scanLines = document.getElementById("scan-lines");
        const colorShiftRed = document.getElementById("color-shift-red");
        const colorShiftBlue = document.getElementById("color-shift-blue");
        const blinkingCursor = document.getElementById("blinking-cursor");
        const mp3Indicator = document.getElementById("mp3-indicator");
        const threeRedShadow = document.getElementById("threedy-shadow-red");
        const threeBlueShadow = document.getElementById("threedy-shadow-blue");
        const wireframeBackdrop = document.getElementById("wireframe-backdrop");

        // Clear any previous intervals
        if (window.eightiesInterval) {
          clearInterval(window.eightiesInterval);
          window.eightiesInterval = null;
        }

        if (isActive) {
          eightiesToggle.classList.add("active");
          if (missionControl) {
            missionControl.classList.add("eighties-active");
            missionControl.classList.remove("threedy-mode");
          }
          if (scanLines) scanLines.classList.add("active");
          if (colorShiftRed) colorShiftRed.classList.add("active");
          if (colorShiftBlue) colorShiftBlue.classList.add("active");
          if (blinkingCursor) blinkingCursor.style.display = "inline-block";

          isEightiesMode = true;

          // Hide 3D shadows in 80s mode
          if (threeRedShadow) threeRedShadow.style.display = "none";
          if (threeBlueShadow) threeBlueShadow.style.display = "none";

          // Update system status text
          const statusLabel = document.querySelector(".status-label");
          if (statusLabel) {
            statusLabel.textContent = "RETRO";
            // Remove 3D text shadows for 80s mode
            statusLabel.style.textShadow = "0 0 3px #22d3ee";
          }

          // Remove 3D text shadows from all elements in 80s mode
          document
            .querySelectorAll(
              ".control-button, .toggle-label, .status-label, .leaderboard-header"
            )
            .forEach((element) => {
              // Use appropriate 80s text shadow instead
              element.style.textShadow = "0 0 3px #d946ef";
            });

          // Add some random glitches (reduced frequency and opacity)
          window.eightiesInterval = setInterval(() => {
            if (Math.random() > 0.97 && scanLines) {
              scanLines.style.opacity = "0.6";
              setTimeout(() => {
                if (scanLines) scanLines.style.opacity = "0.7";
              }, 100);
            }
          }, 3000);

          // If music is active, notify the parent to use
          // Add class to body for additional styles
          document.body.classList.add("eighties-mode");
        } else {
          eightiesToggle.classList.remove("active");
          if (missionControl) {
            missionControl.classList.remove("eighties-active");
            missionControl.classList.add("threedy-mode");
          }
          if (scanLines) scanLines.classList.remove("active");
          if (colorShiftRed) colorShiftRed.classList.remove("active");
          if (colorShiftBlue) colorShiftBlue.classList.remove("active");
          if (blinkingCursor) blinkingCursor.style.display = "none";

          // Fade out wireframe backdrop

          isEightiesMode = false;

          // Show 3D shadows when not in 80s mode
          if (threeRedShadow) threeRedShadow.style.display = "block";
          if (threeBlueShadow) threeBlueShadow.style.display = "block";

          // Hide MP3 indicator
          if (mp3Indicator) {
            mp3Indicator.style.display = "none";
          }

          // Reset status text to 3D style
          const statusLabel = document.querySelector(".status-label");
          if (statusLabel) {
            statusLabel.textContent = "3D//ACTIVE";
            statusLabel.style.textShadow = "-1px 0 #ff0040, 1px 0 #00b4ff";
          }

          // Apply 3D text shadows to all elements when not in 80s mode
          document
            .querySelectorAll(
              ".control-button, .toggle-label, .status-label, .leaderboard-header"
            )
            .forEach((element) => {
              element.style.textShadow = "-1px 0 #ff0040, 1px 0 #00b4ff";
            });

          // Remove eighties mode class from body
          document.body.classList.remove("eighties-mode");
        }

        document.documentElement.style.setProperty(
          "--eighties-color",
          isActive ? "#2a1786" : "transparent"
        );

        // REMOVED: The problematic code that was forcing 3D mode and hiding wireframe
        // regardless of the eighties mode setting
      }

      // Remove music note
      const panelSubtitle = document.querySelector(".panel-subtitle");

      if (panelSubtitle && musicNote) {
        panelSubtitle.innerHTML = "MISSION CONTROL v2.0.80";
      }

      // Notify parent that music should be hidden

