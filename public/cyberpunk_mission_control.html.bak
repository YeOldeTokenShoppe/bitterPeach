        <!-- Collapsible Leaderboard -->
        <div class="leaderboard-container">
          <button id="leaderboard-toggle" class="leaderboard-header">
            <span>L34D3RBOARD//v1.2</span>
            <span id="leaderboard-arrow">▼</span>
          </button>

          <div
            id="leaderboard-content"
            class="leaderboard-content"
            style="display: none"
          >
            <div class="leaderboard-header-row">
              <span>USER_ID</span>
              <span>SCR_PTS</span>
            </div>

            <div class="leaderboard-scrollable">
              <div class="leaderboard-entry top">
                <span>Armstrong</span>
                <span>1969</span>
              </div>
              <div class="leaderboard-entry">
                <span>Aldrin</span>
                <span>1890</span>
              </div>
              <div class="leaderboard-entry">
                <span>Collins</span>
                <span>1850</span>
              </div>
              <div class="leaderboard-entry">
                <span>Lovell</span>
                <span>1800</span>
              </div>
              <div class="leaderboard-entry">
                <span>Cernan</span>
