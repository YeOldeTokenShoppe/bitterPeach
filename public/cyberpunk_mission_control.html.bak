<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cyberpunk Mission Control Panel</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap"
      rel="stylesheet"
    />

    <style>
      /* Ensure full height on all devices */
      html,
      body {
        height: 100vh;
        margin: 0;
        padding: 0;
        overflow-x: hidden;
      }

      body {
        margin: 0;
        padding: 0;
        font-family: monospace;
        background-color: transparent !important;
        color: #67e8f9;
        display: flex;
        justify-content: center;
        width: 100%;
        position: relative;
        min-height: 100vh; /* Minimum height to ensure it fills viewport */
        overflow-y: auto; /* Allow vertical scrolling if needed */
      }

      .mission-control {
        width: 100%;
        max-width: 450px;
        min-height: 100vh; /* Use min-height instead of fixed height */
        background-image: linear-gradient(to bottom, #0f172a, #1e293b);
        display: flex;
        flex-direction: column;
        padding: 16px;
        border-left: 1px solid #0e7490;
        border-right: 1px solid #0e7490;
        box-shadow: 0 0 15px rgba(6, 182, 212, 0.3),
          inset 0 0 10px rgba(6, 182, 212, 0.1);
        overflow-y: auto;
        overflow-x: hidden; /* Hide horizontal scrollbar */
        position: relative;
        z-index: 1;
        box-sizing: border-box;
      }

      /* Fix panel header height */
      .panel-header {
        min-height: 60px;
        height: 60px;
        max-height: 60px;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        margin-bottom: 16px;
        padding-bottom: 8px;
        border-bottom: 1px solid #0e7490;
      }

      /* Fix panel title height */
      .panel-title {
        height: 22px;
        line-height: 1.2;
        margin: 0;
        padding: 0;
        font-size: 1.05rem;
        letter-spacing: 0.2em;
        font-weight: bold;
        color: #67e8f9;
        text-shadow: -2px 0 #ff0040, 2px 0 #00b4ff;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
      }

      .panel-subtitle {
        font-size: 0.75rem;
        line-height: 1.4;
        color: white;
        text-shadow: -1px 0 #ff0040, 1px 0 #00b4ff;
        letter-spacing: 0.1em;
        margin-top: 4px;
      }

      .video-call {
        margin-bottom: 16px;
        background-color: #000;
        border: 1px solid #134e4a;
        border-radius: 4px;
        overflow: visible;
        position: relative;
        z-index: 50;
      }

      .video-header {
        background-color: #111827;
        padding: 4px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #134e4a;
        font-size: 0.75rem;
      }

      .video-status {
        height: 8px;
        width: 8px;
        border-radius: 50%;
        background-color: #4b5563;
      }

      .video-status.active {
        background-color: #ef4444;
        animation: pulse 2s infinite;
      }

      /* Default video display state - always expanded on non-mobile screens */
      .video-display {
        height: 180px;
        position: relative;
        background: linear-gradient(45deg, #041c2c, #000);
        overflow: hidden;
        transition: height 0.3s ease-out;
      }

      /* Media query for shorter screens (likely mobile) - allow collapsing */
      @media (max-height: 700px) {
        /* Default collapsed height on mobile when inactive */
        .video-display:not(.active) {
          height: 40px;
        }

        /* When active, maintain original height */
        .video-display.active {
          height: 180px;
        }

        /* Add an indicator for the collapsed state */
        .video-display:not(.active)::after {
          content: "Tap to expand";
          position: absolute;
          top: 50%;
          left: 50%;
          transform: translate(-50%, -50%);
          color: #67e8f9;
          font-size: 0.75rem;
          text-shadow: 0 0 5px #06b6d4;
        }

        /* Add expand/collapse indicators */
        .video-display::before {
          content: "▼";
          position: absolute;
          right: 8px;
          top: 10px;
          color: #67e8f9;
          font-size: 0.7rem;
          opacity: 0.8;
          z-index: 20;
          pointer-events: none;
          transition: transform 0.3s;
        }

        .video-display.active::before {
          transform: rotate(180deg);
          top: 8px;
        }

        /* Add touch hint on first load */
        .video-display:not(.touched):not(.active)::after {
          animation: pulse 2s infinite;
        }
      }

      /* Collapsed state for the video display - REMOVE THIS as we're handling it in the media query */

      /* SitePal loading logo */
      .waiting_logo {
        position: absolute !important;
        top: 0 !important;
        left: 0 !important;
        width: 100% !important;
        height: 100% !important;
        z-index: 14;
      }

      #sitepal-container {
        position: absolute !important;
        top: 0 !important;
        left: 0 !important;
        width: 100% !important;
        height: 100% !important;
        z-index: 10;
        display: none;
        -webkit-overflow-scrolling: touch;
      }

      #sitepal-container.active {
        display: block;
      }

      /* Make sure SitePal player is visible */
      #vhss_aiPlayer {
        width: 100% !important;
        height: 100% !important;
        z-index: 20 !important;
      }

      /* Ensure video stays behind sitepal when active */
      #video-feed {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 1;
      }

      #video-feed video {
        width: 100%;
        height: 100%;
        object-fit: cover;
        /* Add transition and initial z-index */
        transition: opacity 0.5s ease-out;
        z-index: 15; /* Ensure it's above sitepal-container (z-index 10) during effect */
        display: none; /* Hide initially */
      }

      .video-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-image: repeating-linear-gradient(
          transparent,
          transparent 1px,
          rgba(6, 182, 212, 0.05) 1px,
          rgba(6, 182, 212, 0.05) 2px
        );
        background-size: 100% 2px;
        pointer-events: none;
        z-index: 10;
        display: none;
        -webkit-overflow-scrolling: touch;
      }

      /* 3D video overlay */
      .threedy-mode .video-overlay {
        background-image: repeating-linear-gradient(
          transparent,
          transparent 1px,
          rgba(255, 0, 64, 0.05) 1px,
          rgba(0, 180, 255, 0.05) 2px
        );
        background-size: 100% 2px;
        box-shadow: inset -2px 0 10px rgba(255, 0, 64, 0.1),
          inset 2px 0 10px rgba(0, 180, 255, 0.1);
      }

      /* 80s video overlay */
      .eighties-active .video-overlay {
        background-image: repeating-linear-gradient(
          transparent,
          transparent 1px,
          rgba(217, 70, 239, 0.05) 1px,
          rgba(34, 211, 238, 0.05) 2px
        );
        background-size: 100% 2px;
        box-shadow: inset 0 0 20px rgba(217, 70, 239, 0.1);
        opacity: 0.8;
      }

      .video-gradient {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-image: linear-gradient(
          to bottom,
          transparent,
          rgba(0, 0, 0, 0.5)
        );
        pointer-events: none;
      }

      .video-feed {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        color: #4b5563;
      }

      .video-feed.offline::before,
      .video-feed.offline::after {
        content: "";
        position: absolute;
        background-color: #1f2937;
      }

      .video-feed.offline::before {
        width: 100%;
        height: 1px;
        top: 50%;
      }

      .video-feed.offline::after {
        height: 100%;
        width: 1px;
        left: 50%;
      }

      .self-view {
        position: absolute;
        bottom: 8px;
        right: 8px;
        width: 60px;
        height: 40px;
        background-color: #111827;
        border: 1px solid #0e7490;
        border-radius: 2px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        z-index: 20; /* Ensure it stays above SitePal elements */
      }

      .self-view img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .self-view .emoji-placeholder {
        font-size: 1.75rem;
        color: #67e8f9;
        text-shadow: 0 0 5px #06b6d4;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
        line-height: 1;
      }

      .live-indicator {
        position: absolute;
        bottom: 8px;
        left: 8px;
        font-size: 0.75rem;
        color: #22d3ee;
        animation: pulse 2s infinite;
      }

      .video-controls {
        background-color: #111827;
        padding: 4px;
        display: flex;
        justify-content: space-between;
        position: relative;
        z-index: 100;
      }

      .call-button {
        font-size: 0.75rem;
        font-family: monospace;
        padding: 4px 8px;
        border-radius: 4px;
        cursor: pointer;
        background-color: #1f2937;
        color: #22d3ee;
        border: 1px solid #134e4a;
        box-shadow: 0 0 5px rgba(6, 182, 212, 0.3);
        position: relative;
        z-index: 101;
      }

      .call-button.disconnect {
        color: #f87171;
        border-color: #7f1d1d;
        box-shadow: 0 0 5px rgba(220, 38, 38, 0.3);
      }

      .station-select {
        background-color: #1f2937;
        color: #22d3ee;
        font-size: 0.75rem;
        font-family: monospace;
        padding: 0 4px;
        border: 1px solid #134e4a;
        border-radius: 4px;
        box-shadow: 0 0 3px rgba(6, 182, 212, 0.2);
        position: relative;
        z-index: 101;
      }

      .button-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-bottom: 16px;
      }

      .control-button {
        background-color: #1f2937;
        border-left: 2px solid #ff0040;
        border-right: 2px solid #00b4ff;
        border-top: 1px solid transparent; /* Add transparent top/bottom for consistency */
        border-bottom: 1px solid transparent;
        border-radius: 4px;
        padding: 12px;
        color: #67e8f9;
        font-family: monospace;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center; /* Vertically center content */
        min-height: 62px; /* Ensure consistent minimum height */
        cursor: pointer;
        transition: all 0.3s;
        box-shadow: -2px 0 5px rgba(255, 0, 64, 0.3),
          2px 0 5px rgba(0, 180, 255, 0.3), 0 0 5px rgba(6, 182, 212, 0.2),
          inset 0 0 10px rgba(6, 182, 212, 0.05);
      }

      .control-button:hover {
        background-color: #374151;
        border-left: 2px solid #ff4080;
        border-right: 2px solid #40b4ff;
        box-shadow: -3px 0 10px rgba(255, 0, 64, 0.5),
          3px 0 10px rgba(0, 180, 255, 0.5);
      }

      .button-prefix {
        font-size: 0.75rem;
        line-height: 1.3;
        margin-bottom: 4px;
        opacity: 0.7;
      }

      .button-label {
        font-weight: bold;
        letter-spacing: 0.1em;
        font-size: 0.875rem;
        line-height: 1.3;
      }

      .button-indicator {
        width: 32px;
        height: 4px;
        margin-top: 4px;
        background-color: #0e7490;
        border-radius: 9999px;
      }

      .toggle-section {
        margin-bottom: 16px;
        background-color: #111827;
        padding: 12px;
        border-radius: 4px;
        border: 1px solid #134e4a;
        box-shadow: inset 0 0 10px rgba(0, 0, 0, 0.5);
      }

      .toggle-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
      }

      .toggle-row .label-switch-container {
        display: flex;
        width: 100%;
        justify-content: space-between;
        align-items: center;
      }

      .toggle-row:last-child {
        margin-bottom: 0;
      }

      .toggle-label {
        font-size: 0.875rem;
        line-height: 1.4;
      }

      .toggle-switch {
        width: 48px;
        height: 24px;
        background-color: #1f2937;
        border-radius: 9999px;
        position: relative;
        padding: 2px;
        cursor: pointer;
        transition: background-color 0.3s;
      }

      .toggle-switch.active {
        background-color: #134e4a;
        box-shadow: 0 0 5px rgba(6, 182, 212, 0.5);
      }

      .toggle-switch.eighties.active {
        background-color: #4c1d95;
        box-shadow: 0 0 5px rgba(147, 51, 234, 0.5);
      }

      .toggle-switch.music.active {
        background-color: #ca8a04;
        box-shadow: 0 0 5px rgba(234, 179, 8, 0.5);
      }

      .toggle-switch.music:hover {
        box-shadow: 0 0 8px rgba(234, 179, 8, 0.7);
      }

      .toggle-handle {
        width: 18px;
        height: 18px;
        background-color: #e5e7eb;
        border-radius: 50%;
        position: absolute;
        top: 3px;
        left: 3px;
        transition: transform 0.3s;
      }

      .toggle-switch.active .toggle-handle {
        transform: translateX(24px);
      }

      .leaderboard-header {
        width: 100%;
        background-color: #1f2937;
        border-radius: 4px;
        border: 1px solid #134e4a;
        padding: 4px;
        font-family: monospace;
        color: #22d3ee;
        font-size: 0.75rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 4px;
        cursor: pointer;
        box-shadow: 0 0 5px rgba(6, 182, 212, 0.2);
      }

      .leaderboard-content {
        background-color: #111827;
        border-radius: 4px;
        border: 1px solid #134e4a;
        padding: 8px;
        font-family: monospace;
        color: #22d3ee;
        font-size: 0.875rem;
        margin-bottom: 12px;
        box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.7);
        background-image: linear-gradient(to bottom, #0c1721, #0a0f16);
      }

      .leaderboard-header-row {
        display: flex;
        justify-content: space-between;
        font-size: 0.75rem;
        margin-bottom: 4px;
        padding-bottom: 4px;
        border-bottom: 1px solid #1f2937;
      }

      .leaderboard-scrollable {
        height: 128px;
        overflow-y: auto;
        background-image: repeating-linear-gradient(
          transparent,
          transparent 1px,
          rgba(6, 182, 212, 0.03) 1px,
          rgba(6, 182, 212, 0.03) 2px
        );
        background-size: 100% 2px;
      }

      .leaderboard-entry {
        display: flex;
        justify-content: space-between;
        padding: 4px 0;
      }

      .leaderboard-entry.top {
        color: #67e8f9;
        font-weight: bold;
        text-shadow: 0 0 5px #06b6d4;
      }

      .leaderboard-footer {
        margin-top: 8px;
        font-size: 0.75rem;
        text-align: center;
        color: #22d3ee;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .pulse-dot {
        height: 4px;
        width: 4px;
        border-radius: 50%;
        background-color: #22d3ee;
        margin-right: 4px;
        animation: pulse 2s infinite;
      }

      .status-bar {
        margin-top: 16px;
        display: flex;
        justify-content: space-between;
        margin-top: auto; /* Push status bar to the bottom */
      }

      .status-indicator {
        display: flex;
        align-items: center;
      }

      .status-light {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        margin-right: 8px;
        background-color: #ef4444;
      }

      .status-light.active {
        background-color: #22d3ee;
        animation: pulse 2s infinite;
        box-shadow: 0 0 5px #06b6d4, 0 0 5px 2px rgba(255, 255, 255, 0.7),
          -2px 0 8px #ff0040, 2px 0 8px #00b4ff;
      }

      .status-label {
        font-size: 0.75rem;
      }

      .version-info {
        font-size: 0.75rem;
        color: #4b5563;
      }

      .spacer {
        flex-grow: 1;
      }

      @keyframes pulse {
        0% {
          opacity: 1;
        }
        50% {
          opacity: 0.5;
        }
        100% {
          opacity: 1;
        }
      }

      /* Hide scrollbar for Chrome, Safari and Opera */
      .leaderboard-scrollable::-webkit-scrollbar {
        display: none;
      }

      /* Hide scrollbar for IE, Edge and Firefox */
      .leaderboard-scrollable {
        -ms-overflow-style: none; /* IE and Edge */
        scrollbar-width: none; /* Firefox */
      }

      .control-button[data-action="launch"] {
        position: relative;
      }

      .control-button[data-action="launch"]:after {
        content: "";
        position: absolute;
        top: -2px;
        left: -2px;
        right: -2px;
        bottom: -2px;
        border-radius: 6px;
        background: transparent;
        transition: all 0.3s;
      }

      .control-button[data-action="launch"].active {
        background-color: #450a0a;
        border-color: #dc2626;
      }

      .control-button[data-action="launch"].active:after {
        background: linear-gradient(45deg, #dc2626, #450a0a);
        filter: blur(8px);
        opacity: 0.6;
        z-index: -1;
      }

      .control-button[data-action="launch"] .button-indicator {
        background-color: #dc2626;
        transition: all 0.3s;
      }

      .control-button[data-action="launch"].active .button-indicator {
        animation: redPulse 2s infinite;
      }

      .toggle-switch.emergency.active {
        background-color: #991b1b;
        box-shadow: 0 0 15px rgba(239, 68, 68, 0.5);
      }

      .toggle-switch.emergency.active .toggle-handle {
        background-color: #fecaca;
      }

      #vhss-aiplayer-aiformlogs {
        display: none !important;
        opacity: 0 !important;
      }

      /* 80s mode styles */
      .mission-control.eighties-active {
        /* background-image: linear-gradient(to bottom, #0b132b, #2a1786); */
        border-left: 1px solid #d946ef;
        box-shadow: 0 0 12px rgba(217, 70, 239, 0.3),
          inset 0 0 8px rgba(217, 70, 239, 0.1);
      }

      .eighties-active .panel-title {
        height: 22px;
        line-height: 1.5;
        font-size: 0.8rem;
        color: #d946ef;
        text-shadow: 0 0 3px #d946ef, 0 0 6px #d946ef;
        font-family: "Press Start 2P", cursive;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
      }

      .eighties-active .panel-subtitle {
        height: 18px;
        line-height: 1.4;
        font-size: 0.6rem;
        color: #22d3ee;
        font-family: "Press Start 2P", cursive;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
      }

      .eighties-active .toggle-label,
      .eighties-active .button-label,
      .eighties-active .button-prefix,
      .eighties-active .status-label {
        font-family: "Press Start 2P", cursive;
        font-size: 0.6rem;
        line-height: 1.5;
      }

      .eighties-active .control-button {
        border: 1px solid #d946ef !important; /* Consistent 1px border */
        padding: 12px !important; /* Use same padding as base */
        min-height: 62px !important; /* Ensure override for consistency */
        box-shadow: 0 0 3px rgba(217, 70, 239, 0.3) !important;
        background-image: linear-gradient(
          to bottom,
          #0f172a,
          #2a1786
        ) !important;
        border-left: 1px solid #d946ef !important;
        border-right: 1px solid #d946ef !important;
        transition: all 0.3s;
      }

      .eighties-active .control-button:hover {
        /* background-image: linear-gradient(to bottom, #2a1786, #0f172a); */
        transform: translateY(-2px);
        box-shadow: 0 0 6px rgba(217, 70, 239, 0.5);
      }

      .eighties-active .button-indicator {
        background-color: #d946ef;
        box-shadow: 0 0 3px #d946ef;
      }

      .eighties-active .toggle-section,
      .eighties-active .leaderboard-header,
      .eighties-active .leaderboard-content {
        border-color: #d946ef;
      }

      .eighties-active .status-light.active {
        background-color: #22d3ee;
        box-shadow: 0 0 6px #22d3ee;
        animation: flicker 2s infinite;
      }

      @keyframes flicker {
        0% {
          opacity: 1;
        }
        25% {
          opacity: 0.8;
        }
        30% {
          opacity: 1;
        }
        35% {
          opacity: 0.6;
        }
        40% {
          opacity: 1;
        }
        50% {
          opacity: 0.9;
        }
        75% {
          opacity: 1;
        }
        80% {
          opacity: 0.7;
        }
        100% {
          opacity: 1;
        }
      }

      .eighties-active .panel-title {
        animation: glitch 5s infinite;
      }

      /* Color shifting for VHS effect */
      .color-shift {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        mix-blend-mode: screen;
        pointer-events: none;
        opacity: 0;
        z-index: 998;
        transition: opacity 0.3s ease;
      }

      .color-shift.active {
        opacity: 0.02;
        animation: color-drift 8s infinite;
      }

      .color-shift-red {
        background-color: #ff0000;
        transform: translateX(-1px);
      }

      .color-shift-blue {
        background-color: #0000ff;
        transform: translateX(1px);
      }

      /* Scan line effect for 80s mode */
      .scan-lines {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(
          to bottom,
          rgba(255, 255, 255, 0.02) 50%,
          rgba(0, 0, 0, 0.08) 50%
        );
        background-size: 100% 4px;
        pointer-events: none;
        z-index: 999;
        opacity: 0;
        transition: opacity 0.3s ease;
      }

      .scan-lines.active {
        opacity: 0.7;
      }

      /* Retro cursor for 80s mode */
      .eighties-active * {
        cursor: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' style='fill:none;stroke:%23ff00ff;stroke-width:2px'><rect width='8' height='12'/></svg>")
            0 0,
          auto !important;
      }

      /* Blinking text effect */
      @keyframes blink {
        0%,
        49% {
          opacity: 1;
        }
        50%,
        100% {
          opacity: 0;
        }
      }

      .eighties-active .blinking-cursor {
        display: inline-block;
        width: 8px;
        height: 12px;
        background-color: #ff00ff;
        animation: blink 1s infinite;
        margin-left: 4px;
        vertical-align: middle;
      }

      /* Button press effect */
      .eighties-active .control-button:active {
        transform: translateY(1px);
        box-shadow: 0 0 15px rgba(255, 0, 255, 1);
      }

      /* Button active state for 80s mode */
      .eighties-active .control-button.activated {
        background-image: linear-gradient(to bottom, #3a0ca3, #000000);
        border-color: #00ffff;
        box-shadow: 0 0 10px rgba(0, 255, 255, 0.6);
      }

      .eighties-active .control-button.activated .button-indicator {
        background-color: #00ffff;
        box-shadow: 0 0 5px #00ffff;
      }

      .toggle-switch.eighties:hover {
        box-shadow: 0 0 8px rgba(147, 51, 234, 0.7);
      }

      /* 3D glasses mode styles */
      .threedy-mode {
        position: relative;
        overflow: hidden;
      }

      .threedy-mode .panel-title {
        position: relative;
        text-shadow: -2px 0 #ff0040, 2px 0 #00b4ff;
        color: white;
      }

      .threedy-mode .panel-subtitle {
        position: relative;
        text-shadow: -1px 0 #ff0040, 1px 0 #00b4ff;
        color: white;
      }

      .threedy-mode .button-label,
      .threedy-mode .toggle-label,
      .threedy-mode .status-label,
      .threedy-mode #station-display {
        position: relative;
        text-shadow: -1px 0 #ff0040, 1px 0 #00b4ff;
      }

      .threedy-shadow-red,
      .threedy-shadow-blue {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        opacity: 0.03;
      }

      .threedy-shadow-red {
        box-shadow: inset 0 0 15px 2px #ff0040;
        transform: translateX(-1px);
        z-index: 10;
      }

      .threedy-shadow-blue {
        box-shadow: inset 0 0 15px 2px #00b4ff;
        transform: translateX(1px);
        z-index: 11;
      }

      .threedy-mode .control-button {
        position: relative;
        border: 1px solid transparent; /* Base border */
        border-left: 2px solid #ff0040;
        border-right: 2px solid #00b4ff;
        padding: 11px; /* Keep padding consistent */
        box-shadow: -2px 0 5px rgba(255, 0, 64, 0.3),
          2px 0 5px rgba(0, 180, 255, 0.3);
        transition: all 0.3s ease;
      }

      .threedy-mode .control-button:hover {
        border-left: 2px solid #ff4080;
        border-right: 2px solid #40b4ff;
        box-shadow: -3px 0 10px rgba(255, 0, 64, 0.5),
          3px 0 10px rgba(0, 180, 255, 0.5);
      }

      .threedy-mode .toggle-switch {
        border-left: 1px solid #ff0040;
        border-right: 1px solid #00b4ff;
        box-shadow: -1px 0 3px rgba(255, 0, 64, 0.3),
          1px 0 3px rgba(0, 180, 255, 0.3);
      }

      .threedy-mode .toggle-switch.active {
        background: linear-gradient(
          90deg,
          rgba(255, 0, 64, 0.3),
          rgba(0, 180, 255, 0.3)
        );
      }

      .threedy-mode .toggle-handle {
        box-shadow: -1px 0 2px rgba(255, 0, 64, 0.5),
          1px 0 2px rgba(0, 180, 255, 0.5);
      }

      .threedy-mode .video-call,
      .threedy-mode .toggle-section,
      .threedy-mode .leaderboard-header,
      .threedy-mode .leaderboard-content {
        border-left: 1px solid #ff0040;
        border-right: 1px solid #00b4ff;
        box-shadow: -2px 0 5px rgba(255, 0, 64, 0.2),
          2px 0 5px rgba(0, 180, 255, 0.2);
      }

      .threedy-mode .status-light.active {
        box-shadow: 0 0 5px 2px rgba(255, 255, 255, 0.7), -2px 0 8px #ff0040,
          2px 0 8px #00b4ff;
      }

      /* 3D toggle button */
      .toggle-switch.threedy-toggle.active {
        background: linear-gradient(90deg, #ff0040, #00b4ff);
        box-shadow: 0 0 10px rgba(255, 255, 255, 0.5);
      }

      .toggle-switch.threedy-toggle:hover {
        box-shadow: 0 0 8px rgba(255, 255, 255, 0.7);
      }

      /* 80s mode with 3D enhancements - remove these to keep modes separate */
      .eighties-active.threedy-mode .panel-title,
      .eighties-active.threedy-mode .panel-subtitle,
      .eighties-active.threedy-mode .toggle-label,
      .eighties-active.threedy-mode .button-label,
      .eighties-active.threedy-mode .button-prefix,
      .eighties-active.threedy-mode .control-button,
      .eighties-active.threedy-mode .status-label {
        /* Override with blank styles to prevent inheritance */
        text-shadow: none;
        border-left: none;
        border-right: none;
        box-shadow: none;
      }

      /* Override specific 80s styles to ensure they take precedence */
      .eighties-active .panel-title {
        color: #d946ef;
        text-shadow: 0 0 3px #d946ef, 0 0 6px #d946ef !important;
        font-family: "Press Start 2P", cursive;
        font-size: 0.8rem !important; /* Ensure override */
        line-height: 1.5 !important; /* Ensure override */
        animation: glitch 5s infinite;
      }

      .eighties-active .panel-subtitle {
        color: #22d3ee;
        text-shadow: 0 0 3px #22d3ee !important;
        font-family: "Press Start 2P", cursive;
        font-size: 0.6rem !important; /* Ensure override */
        line-height: 1.4 !important; /* Ensure override */
      }

      .eighties-active .toggle-label,
      .eighties-active .button-label,
      .eighties-active .button-prefix,
      .eighties-active .status-label {
        font-family: "Press Start 2P", cursive;
        font-size: 0.6rem !important; /* Ensure override */
        line-height: 1.5 !important; /* Ensure override */
        text-shadow: 0 0 3px #d946ef !important;
      }

      .eighties-active .control-button {
        border: 1px solid #d946ef !important;
        padding: 12px !important; /* Use same padding as base */
        min-height: 62px !important; /* Ensure override for consistency */
        box-shadow: 0 0 3px rgba(217, 70, 239, 0.3) !important;
        background-image: linear-gradient(
          to bottom,
          #0f172a,
          #2a1786
        ) !important;
        border-left: 1px solid #d946ef !important;
        border-right: 1px solid #d946ef !important;
        transition: all 0.3s;
      }

      .leaderboard-container {
        margin-top: 10px;
      }

      .leaderboard-header {
        width: 100%;
        background-color: #1f2937;
        border-radius: 4px;
        border: 1px solid #134e4a;
        padding: 4px;
        font-family: monospace;
        color: #22d3ee;
        font-size: 0.75rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 4px;
        cursor: pointer;
        box-shadow: 0 0 5px rgba(6, 182, 212, 0.2);
      }

      /* 3D glasses mode styles for video call */
      .threedy-mode .video-call {
        border-left: 1px solid #ff0040;
        border-right: 1px solid #00b4ff;
        box-shadow: -2px 0 5px rgba(255, 0, 64, 0.2),
          2px 0 5px rgba(0, 180, 255, 0.2);
      }

      .threedy-mode #station-display {
        position: relative;
        text-shadow: -1px 0 #ff0040, 1px 0 #00b4ff;
      }

      .threedy-mode .call-button {
        border-left: 1px solid #ff0040;
        border-right: 1px solid #00b4ff;
        box-shadow: -1px 0 3px rgba(255, 0, 64, 0.2),
          1px 0 3px rgba(0, 180, 255, 0.2);
        text-shadow: -1px 0 #ff0040, 1px 0 #00b4ff;
      }

      .threedy-mode .call-button:hover {
        box-shadow: -2px 0 5px rgba(255, 0, 64, 0.4),
          2px 0 5px rgba(0, 180, 255, 0.4);
      }

      .threedy-mode .call-button.disconnect {
        border-left: 1px solid #ff0040;
        border-right: 1px solid #00b4ff;
        text-shadow: -1px 0 #ff0040, 1px 0 #00b4ff;
      }

      .threedy-mode .station-select {
        border-left: 1px solid #ff0040;
        border-right: 1px solid #00b4ff;
        box-shadow: -1px 0 3px rgba(255, 0, 64, 0.2),
          1px 0 3px rgba(0, 180, 255, 0.2);
        text-shadow: -1px 0 #ff0040, 1px 0 #00b4ff;
      }

      .threedy-mode .station-select:hover {
        box-shadow: -2px 0 5px rgba(255, 0, 64, 0.4),
          2px 0 5px rgba(0, 180, 255, 0.4);
      }

      .threedy-mode .video-status.active {
        box-shadow: 0 0 5px #ef4444, -1px 0 5px #ff0040, 1px 0 5px #00b4ff;
      }

      /* 80s mode video call styles */
      .eighties-active .video-call {
        border: 1px solid #d946ef;
        background-color: #020617;
        box-shadow: 0 0 8px rgba(217, 70, 239, 0.3);
      }

      .eighties-active .video-header {
        background-color: #0f172a;
        border-bottom: 1px solid #d946ef;
        font-family: "Press Start 2P", cursive;
        font-size: 0.55rem;
        color: #22d3ee;
      }

      .eighties-active #station-display {
        color: #22d3ee;
        text-shadow: 0 0 3px #22d3ee;
        font-family: "Press Start 2P", cursive;
        font-size: 0.55rem;
      }

      .eighties-active .video-status.active {
        background-color: #ef4444;
        box-shadow: 0 0 5px #ef4444;
      }

      .eighties-active .video-controls {
        background-color: #0f172a;
        border-top: 1px solid #d946ef;
      }

      .eighties-active .call-button {
        font-family: "Press Start 2P", cursive;
        font-size: 0.55rem;
        background-color: #0f172a;
        border: 1px solid #d946ef;
        color: #22d3ee;
        box-shadow: 0 0 3px rgba(217, 70, 239, 0.4);
      }

      .eighties-active .call-button.disconnect {
        border-color: #ef4444;
        color: #ef4444;
        box-shadow: 0 0 3px rgba(239, 68, 68, 0.4);
      }

      .eighties-active .call-button:hover {
        background-color: #2a1786;
      }

      .eighties-active .station-select {
        font-family: "Press Start 2P", cursive;
        font-size: 0.55rem;
        background-color: #0f172a;
        border: 1px solid #d946ef;
        color: #22d3ee;
        box-shadow: 0 0 3px rgba(217, 70, 239, 0.4);
      }

      .eighties-active .station-select:hover {
        background-color: #2a1786;
      }

      /* Hide SitePal's default loading spinner */
      #sitepal-container .waiting_logo {
        display: none !important;
      }

      /* Styles for the Offline Display */
      #offline-display {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #111827; /* Equivalent to bg-gray-900 */
        color: #4b5563; /* Equivalent to text-gray-600 */
        font-size: 0.875rem; /* text-sm */
        font-family: monospace;
        z-index: 5; /* Below video during transition */
      }

      #offline-display .crosshair-h,
      #offline-display .crosshair-v {
        position: absolute;
        background-color: #374151; /* Equivalent to bg-gray-800 */
      }

      #offline-display .crosshair-h {
        width: 100%;
        height: 1px;
        top: 50%;
        left: 0;
      }

      #offline-display .crosshair-v {
        height: 100%;
        width: 1px;
        left: 50%;
        top: 0;
      }

      #offline-display .scanlines-overlay {
        position: absolute;
        inset: 0;
        background-image: repeating-linear-gradient(
          transparent,
          transparent 1px,
          rgba(6, 182, 212, 0.02) 1px,
          rgba(6, 182, 212, 0.02) 2px
        );
        background-size: 100% 2px;
        pointer-events: none;
      }
      /* End Offline Display Styles */

      /* Connect Button Pulse Animation */
      @keyframes connect-pulse {
        0% {
          box-shadow: 0 0 5px rgba(6, 182, 212, 0.3),
            0 0 8px rgba(34, 211, 238, 0.2);
          border-color: #134e4a;
        }
        50% {
          box-shadow: 0 0 10px rgba(6, 182, 212, 0.6),
            0 0 15px rgba(34, 211, 238, 0.4);
          border-color: #22d3ee;
        }
        100% {
          box-shadow: 0 0 5px rgba(6, 182, 212, 0.3),
            0 0 8px rgba(34, 211, 238, 0.2);
          border-color: #134e4a;
        }
      }

      .initial-pulse {
        animation: connect-pulse 1.5s infinite ease-in-out;
      }
      /* End Connect Button Pulse */

      /* Add UN-MUTE button style */
      .call-button.unmute {
        color: #22d3ee;
        border-color: #0e7490;
        box-shadow: 0 0 10px rgba(6, 182, 212, 0.5);
        animation: connect-pulse 1.5s infinite ease-in-out;
      }

      /* Update existing animation to pulse specifically designed for the UN-MUTE state */
      @keyframes connect-pulse {
        0% {
          box-shadow: 0 0 5px rgba(6, 182, 212, 0.3),
            0 0 8px rgba(34, 211, 238, 0.2);
          border-color: #134e4a;
        }
        50% {
          box-shadow: 0 0 10px rgba(6, 182, 212, 0.6),
            0 0 15px rgba(34, 211, 238, 0.4);
          border-color: #22d3ee;
        }
        100% {
          box-shadow: 0 0 5px rgba(6, 182, 212, 0.3),
            0 0 8px rgba(34, 211, 238, 0.2);
          border-color: #134e4a;
        }
      }

      /* 80s mode video call styles */
      .eighties-active .video-call {
        border: 1px solid #d946ef;
        background-color: #020617;
        box-shadow: 0 0 8px rgba(217, 70, 239, 0.3);
      }

      .eighties-active .video-header {
        background-color: #0f172a;
        border-bottom: 1px solid #d946ef;
        font-family: "Press Start 2P", cursive;
        font-size: 0.55rem;
        color: #22d3ee;
      }

      .eighties-active #station-display {
        color: #22d3ee;
        text-shadow: 0 0 3px #22d3ee;
        font-family: "Press Start 2P", cursive;
        font-size: 0.55rem;
      }

      .eighties-active .video-status.active {
        background-color: #ef4444;
        box-shadow: 0 0 5px #ef4444;
      }

      .eighties-active .video-controls {
        background-color: #0f172a;
        border-top: 1px solid #d946ef;
      }

      .eighties-active .call-button {
        font-family: "Press Start 2P", cursive;
        font-size: 0.55rem;
        background-color: #0f172a;
        border: 1px solid #d946ef;
        color: #22d3ee;
        box-shadow: 0 0 3px rgba(217, 70, 239, 0.4);
      }

      .eighties-active .call-button.unmute {
        border-color: #22d3ee;
        color: #d946ef;
        box-shadow: 0 0 8px rgba(34, 211, 238, 0.6);
        animation: eighties-pulse 1.5s infinite alternate;
      }

      @keyframes eighties-pulse {
        0% {
          box-shadow: 0 0 3px rgba(217, 70, 239, 0.4);
          border-color: #d946ef;
        }
        100% {
          box-shadow: 0 0 10px rgba(34, 211, 238, 0.7);
          border-color: #22d3ee;
        }
      }

      .eighties-active .call-button.disconnect {
        border-color: #ef4444;
        color: #ef4444;
        box-shadow: 0 0 3px rgba(239, 68, 68, 0.4);
      }

      .eighties-active .call-button:hover {
        background-color: #2a1786;
      }

      /* Add styles for the constellations toggle */
      .toggle-switch.constellations {
        background-color: #1e3a8a;
        border-color: #3b82f6;
      }

      .toggle-switch.constellations .toggle-handle {
        background-color: #93c5fd;
      }

      .toggle-switch.constellations.active {
        background-color: #1e40af;
        box-shadow: 0 0 15px rgba(59, 130, 246, 0.5);
      }

      .toggle-switch.constellations.active .toggle-handle {
        background-color: #bfdbfe;
      }

      /* Update eighties mode styles to include constellations toggle */
      .eighties-active .toggle-switch.constellations {
        background-color: #581c87;
        border-color: #d946ef;
      }

      .eighties-active .toggle-switch.constellations .toggle-handle {
        background-color: #e879f9;
      }

      .eighties-active .toggle-switch.constellations.active {
        background-color: #6b21a8;
        box-shadow: 0 0 15px rgba(217, 70, 239, 0.5);
      }

      .eighties-active .toggle-switch.constellations.active .toggle-handle {
        background-color: #f0abfc;
      }

      /* Add responsive styles for small screens */
      @media (max-width: 480px) {
        /* Default collapsed height on mobile when inactive */
        .video-display:not(.active) {
          height: 40px;
        }

        /* When active, maintain original height */
        .video-display.active {
          height: 180px;
        }

        /* Add an indicator for the collapsed state */
        .video-display:not(.active)::after {
          content: "Tap to expand";
          position: absolute;
          top: 50%;
          left: 50%;
          transform: translate(-50%, -50%);
          color: #67e8f9;
          font-size: 0.75rem;
          text-shadow: 0 0 5px #06b6d4;
        }

        /* Add expand/collapse indicators */
        .video-display::before {
          content: "▼";
          position: absolute;
          right: 8px;
          top: 10px;
          color: #67e8f9;
          font-size: 0.7rem;
          opacity: 0.8;
          z-index: 20;
          pointer-events: none;
          transition: transform 0.3s;
        }

        .video-display.active::before {
          transform: rotate(180deg);
          top: 8px;
        }

        /* Add touch hint on first load */
        .video-display:not(.touched):not(.active)::after {
          animation: pulse 2s infinite;
        }

        /* Optimize spacing */
        .mission-control {
          padding: 12px 10px;
        }

        /* Reduce spacing between elements */
        .panel-header {
          min-height: 50px;
          height: 50px;
          max-height: 50px;
          margin-bottom: 12px;
          padding-bottom: 4px;
        }

        .video-call {
          margin-bottom: 12px;
        }

        /* Further optimize button grid */
        .button-grid {
          gap: 8px;
          margin-bottom: 12px;
        }

        /* Make buttons significantly smaller and more compact */
        .control-button {
          padding: 6px 4px;
          min-height: 48px;
        }

        .button-prefix {
          font-size: 0.65rem;
          margin-bottom: 2px;
        }

        .button-label {
          font-size: 0.8rem;
        }

        .button-indicator {
          width: 24px;
          height: 3px;
          margin-top: 3px;
        }

        /* Make toggle sections more compact */
        .toggle-section {
          padding: 8px;
          margin-bottom: 12px;
        }

        /* Style the inline toggle groups - two lines for full-size screens */
        .toggle-row.mobile-inline {
          display: flex;
          flex-wrap: wrap;
          justify-content: space-between;
          gap: 20px;
          margin-bottom: 0;
        }

        .toggle-group {
          display: flex;
          align-items: center;
          justify-content: center;
          width: 45%;
          margin-bottom: 10px;
        }

        .toggle-group:nth-child(3) {
          width: 90%;
          margin-bottom: 0;
        }

        .toggle-label {
          font-size: 0.75rem;
          margin-right: 8px;
          white-space: nowrap;
          text-align: center;
        }

        .toggle-switch {
          width: 42px;
          height: 22px;
        }

        .toggle-handle {
          width: 18px;
          height: 18px;
        }

        /* Mobile adjustments */
        @media (max-width: 767px) {
          .toggle-row.mobile-inline {
            flex-wrap: nowrap;
            gap: 0;
          }

          .toggle-group {
            width: 33%;
            margin-bottom: 0;
          }

          .toggle-group:nth-child(3) {
            width: 33%;
          }

          .toggle-label {
            font-size: 0.65rem;
            margin-right: 4px;
          }

          .toggle-switch {
            width: 36px;
            height: 20px;
          }

          .toggle-handle {
            width: 16px;
            height: 16px;
          }
        }
      }

      /* Extra small screens */
      @media (max-width: 360px) {
        /* Make video even smaller when active on very small screens */
        .video-display.active {
          height: 150px;
        }

        /* Reduce padding further */
        .mission-control {
          padding: 8px 6px;
        }

        /* Make grid buttons even more compact */
        .button-grid {
          gap: 6px;
        }

        .control-button {
          padding: 4px;
          min-height: 44px;
        }

        .button-prefix {
          font-size: 0.6rem;
          margin-bottom: 1px;
        }

        .button-label {
          font-size: 0.75rem;
          letter-spacing: 0.05em;
        }

        .button-indicator {
          width: 20px;
          height: 2px;
          margin-top: 2px;
        }

        /* Further reduce toggle spacing */
        .toggle-section {
          padding: 6px;
          margin-bottom: 8px;
        }

        .toggle-row {
          margin-bottom: 6px;
        }

        .toggle-label {
          font-size: 0.75rem;
        }

        /* Even more compact toggles for very small screens */
        .toggle-group .toggle-label {
          font-size: 0.6rem;
          margin-right: 2px;
        }

        .toggle-group .toggle-switch {
          width: 30px;
          height: 16px;
        }

        .toggle-group .toggle-handle {
          width: 12px;
          height: 12px;
          top: 2px;
        }

        .toggle-group .toggle-switch.active .toggle-handle {
          transform: translateX(14px);
        }

        /* Smaller toggle switches */
        .toggle-switch {
          width: 42px;
          height: 20px;
        }

        .toggle-switch .toggle-handle {
          width: 16px;
          height: 16px;
          top: 2px;
        }

        .toggle-switch.active .toggle-handle {
          transform: translateX(20px);
        }

        /* Even smaller leaderboard */
        .leaderboard-scrollable {
          height: 90px;
        }
      }

      /* Full-screen mode adjustments for toggle buttons */
      @media (min-width: 768px) {
        .toggle-row.mobile-inline {
          flex-wrap: wrap;
          justify-content: space-around;
          padding: 10px 0;
        }

        .toggle-group {
          width: 45%;
          margin-bottom: 15px;
          justify-content: center;
        }

        .toggle-group:nth-child(2) {
          left: 0;
          position: static;
        }

        .toggle-group:nth-child(3) {
          width: 90%;
          justify-content: center;
        }

        .toggle-group .toggle-label {
          font-size: 0.75rem;
          margin-right: 8px;
        }

        .toggle-group .toggle-switch {
          width: 42px;
          height: 22px;
        }

        .toggle-group .toggle-handle {
          width: 18px;
          height: 18px;
        }
      }
    </style>
  </head>
  <body>
    <div class="scan-lines" id="scan-lines"></div>
