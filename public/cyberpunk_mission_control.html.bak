    <script>
      // DOM elements
      const callButton = document.getElementById("call-button");
      const callStatus = document.getElementById("call-status");
      const videoFeed = document.getElementById("video-feed");
      const selfView = document.getElementById("self-view");
      const liveIndicator = document.getElementById("live-indicator");
      const stationSelect = document.getElementById("station-select");
      const stationDisplay = document.getElementById("station-display");
      const eightiesToggle = document.getElementById("eighties-toggle");
      const constellationToggle = document.getElementById(
        "constellation-toggle"
      );
      const musicToggle = document.getElementById("music-toggle");
      const stereoPower = document.getElementById("stereo-power");
      const stereoNext = document.getElementById("stereo-next");
      const stereoPrev = document.getElementById("stereo-prev");
      const stereoPlayPause = document.getElementById("stereo-play-pause");

      const stereoInfo = document.getElementById("stereo-info");
      const systemStatus = document.getElementById("system-status");

      const leaderboardContent = document.getElementById("leaderboard-content");
      const leaderboardArrow = document.getElementById("leaderboard-arrow");
      const controlButtons = document.querySelectorAll(".control-button");

      // Helper function to load scripts
      function loadScript(src) {
        return new Promise((resolve, reject) => {
          const script = document.createElement("script");
          script.src = src;
          script.onload = resolve;
          script.onerror = reject;
          document.head.appendChild(script);
        });
      }

      // State
      let isCallActive = false;
      let isEightiesMode = false;
      let isLeaderboardExpanded = false; // Add leaderboard state variable

      // Music toggle starts off by default
      musicToggle.classList.remove("active");

      function playClickSound() {
        try {
          const audioContext = new (window.AudioContext ||
            window.webkitAudioContext)();
          const oscillator = audioContext.createOscillator();
          const gainNode = audioContext.createGain();
          oscillator.type = "sine";
          oscillator.frequency.setValueAtTime(880, audioContext.currentTime); // A5
          gainNode.gain.setValueAtTime(0.1, audioContext.currentTime);
          gainNode.gain.exponentialRampToValueAtTime(
            0.01,
            audioContext.currentTime + 0.1
          );
          oscillator.connect(gainNode);
          gainNode.connect(audioContext.destination);
          oscillator.start();
          oscillator.stop(audioContext.currentTime + 0.1);
        } catch (e) {
          console.log("Audio context error:", e);
        }
      }

      // Add iOS detection
      const isIOS =
        /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;
      const browserIsSafari = /^((?!chrome|android).)*safari/i.test(
        navigator.userAgent
      );

      // Log device detection
      console.log("Device detection:", {
        isIOS: isIOS,
        browserIsSafari: browserIsSafari,
        userAgent: navigator.userAgent,
      });

      // Handle initial video playback for iOS
      document.addEventListener("DOMContentLoaded", () => {
        const deadAir = document.getElementById("deadAir");
        const offlineDisplay = document.getElementById("offline-display");
        const callButton = document.getElementById("call-button"); // Get call button

        offlineDisplay.style.display = "flex"; // Show offline state
        deadAir.style.display = "none"; // Hide video initially
        deadAir.pause(); // Ensure video is paused initially

        // Add initial pulse to CONNECT button
        if (callButton) {
          // Check if button exists
          callButton.classList.add("initial-pulse");
        }

        // Special handling for iOS
        if (isIOS || browserIsSafari) {
          console.log("iOS/Safari detected - applying special handling");

          // Add a click handler to the whole document to initialize audio on iOS
          document.addEventListener(
            "click",
            function iosAudioInit() {
              console.log("iOS document click - initializing audio context");
              deadAir
                .play()
                .catch((e) => console.log("iOS initial play rejected:", e));

              // Try to prime the audio early
              try {
                if (typeof saySilent === "function") {
                  saySilent(0);
                }
              } catch (e) {
                console.log("Early audio priming failed:", e);
              }

              // Remove the listener after first click
              document.removeEventListener("click", iosAudioInit);
            },
            { once: true }
          );

          // For iOS we need to specially handle the call button click
          callButton.addEventListener(
            "click",
            function (e) {
              console.log("Call button clicked on iOS");

              // If we're connecting, make sure we always show the UN-MUTE button
              if (!isCallActive) {
                window.forceUnmuteOnIOS = true;

                // Create a temporary audio context to help initialize audio system
                try {
                  const tempContext = new (window.AudioContext ||
                    window.webkitAudioContext)();
                  tempContext.resume().then(() => {
                    console.log("Temporary audio context resumed");
                  });

                  // Create and play a brief silent sound
                  const oscillator = tempContext.createOscillator();
                  const gainNode = tempContext.createGain();
                  gainNode.gain.value = 0.0001; // Nearly silent
                  oscillator.connect(gainNode);
                  gainNode.connect(tempContext.destination);
                  oscillator.start(0);
                  oscillator.stop(tempContext.currentTime + 0.001);
                } catch (e) {
                  console.warn("Temporary audio context creation failed:", e);
                }
              }

              // Try to prime audio regardless of browser
              try {
                if (typeof window.saySilent === "function") {
                  window.saySilent(0);
                  // Add a small delay before any subsequent audio operations
                  setTimeout(() => {
                    try {
                      // Try to start listening after priming
                      if (typeof AI_vhost_api === "function") {
                        AI_vhost_api("startListening");
                      }
                    } catch (err) {
                      console.log(
                        "Post-prime listening activation failed:",
                        err
                      );
                    }
                  }, 100);
                }
              } catch (err) {
                console.log("Audio priming on CONNECT click failed:", err);
              }
            },
            { capture: true }
          );
        }

        // Removed initial play attempt here, now paused by default
        // deadAir
        //   .play()
        //   .catch((e) => console.log("Initial auto-play prevented:", e));
      });

      // --- Audio Priming for Mobile ---
      let hasPrimed = false;
      function primeAudio() {
        if (!hasPrimed) {
          try {
            // Use SitePal's silent function if available, otherwise ignore
            if (typeof window.saySilent === "function") {
              window.saySilent(0); // Play silent audio
              console.log("SitePal saySilent(0) used for audio priming.");
            } else {
              console.log("saySilent not available, skipping audio priming.");
            }
            hasPrimed = true;
          } catch (e) {
            console.error("Error during audio priming:", e);
          }
        }
      }
      // Attach priming to first user interaction
      document.addEventListener("click", primeAudio, { once: true });
      document.addEventListener("touchstart", primeAudio, { once: true });
      // --- End Audio Priming ---

      // Add a function to detect if the three-state approach is needed
      function needsUnmuteState() {
        // iOS and Safari always need the three-state approach
        if (isIOS || browserIsSafari) {
          console.log("iOS/Safari detected - using three-state approach");
          return true;
        }

        // Mobile devices generally need the user interaction
        if (
          /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(
            navigator.userAgent
          )
        ) {
          console.log("Mobile browser detected - using three-state approach");
          return true;
        }

        // Check if URL parameter explicitly requests it
        const urlParams = new URLSearchParams(window.location.search);
        if (
          urlParams.get("unmute") === "true" ||
          urlParams.get("three-state") === "true"
        ) {
          console.log("Three-state approach explicitly requested via URL");
          return true;
        }

        // For Chrome and other browsers on desktop, auto-transition is generally fine
        console.log(
          "Desktop non-Safari browser detected - will use auto-transition"
        );
        return false;
      }

      // Set the global flag early
      window.needsUnmuteFlow = /iPhone|iPad|iPod|Android|Mobile/i.test(
        navigator.userAgent
      );
      const videoDisplay = document.querySelector(".video-display");
      // Toggle call - Refactored Logic with special iOS handling
      callButton.addEventListener("click", () => {
        console.log(
          "Call button clicked, current text:",
          callButton.textContent
        );

        if (callButton.textContent === "CONNECT") {
          // ---- Connect Flow ----
          console.log("Connecting call and initializing SitePal...");
          isCallActive = true;
          window.sceneAlreadyLoaded = false; // Reset this flag when connecting
          window.allowButtonTransition = true; // Allow transitions on new connection
          window.greetingPlayed = false; // Reset greeting flag

          // Reset flag in case needsUnmuteState changes (e.g., browser change)
          window.needsUnmuteFlow = needsUnmuteState();

          // --- Transmission Effect Start ---
          const deadAir = document.getElementById("deadAir");
          const sitepalContainer = document.getElementById("sitepal-container");
          const offlineDisplay = document.getElementById("offline-display"); // Get offline display
          const transmissionEffectDuration = 3500; // ms - Shortened duration
          const fadeOutDuration = 500; // ms (should match CSS transition)

          // Hide offline display
          offlineDisplay.style.display = "none";

          // Make video visible and opaque, then play
          deadAir.style.display = "block";
          deadAir.style.opacity = 1;
          deadAir.muted = true;
          deadAir.loop = true;
          deadAir
            .play()
            .catch((e) => console.error("Transmission video play failed:", e));

          // Show SitePal container behind the video
          sitepalContainer.style.display = "block";
          // --- End Transmission Effect Start ---

          // Activate call status indicator
          callStatus.classList.add("active");

          // Clean up any existing instance
          if (sitepalContainer.dataset.initialized === "true") {
            console.log("Cleaning up previous SitePal instance...");
            cleanupSitePal();
          }

          // Initialize SitePal
          initSitePal();
          sitepalContainer.dataset.initialized = "true";

          // Update UI
          function updateSelfView() {
            const selfView = document.getElementById("self-view");
            if (!selfView) {
              console.error("Self view element not found");
              return;
            }

            selfView.innerHTML = '<div class="emoji-placeholder">😎</div>'; // Set default immediately
            console.log("Requesting avatar from parent...");

            // Request avatar from parent
            window.parent.postMessage({ type: "REQUEST_AVATAR" }, "*");
          }

          selfView.style.display = "block";
          updateSelfView();
          liveIndicator.style.display = "block";
          stationSelect.disabled = true;

          // Set to UN-MUTE state initially instead of DISCONNECT
          callButton.textContent = "UN-MUTE";
          callButton.classList.add("unmute"); // Add a new class for styling
          callButton.classList.remove("disconnect");
          console.log("Call connected, button set to UN-MUTE");

          // Remove initial pulse from CONNECT button
          callButton.classList.remove("initial-pulse");

          // Special handling for iOS - maintain but don't activate mic yet
          if (isIOS || browserIsSafari) {
            console.log(
              "iOS/Safari detected - deferring mic activation until UN-MUTE"
            );

            // Try to prime audio system
            try {
              const tempContext = new (window.AudioContext ||
                window.webkitAudioContext)();
              tempContext.resume().then(() => {
                console.log("Temporary audio context resumed");
              });

              // Create and play a brief silent sound
              const oscillator = tempContext.createOscillator();
              const gainNode = tempContext.createGain();
              gainNode.gain.value = 0.0001; // Nearly silent
              oscillator.connect(gainNode);
              gainNode.connect(tempContext.destination);
              oscillator.start(0);
              oscillator.stop(tempContext.currentTime + 0.001);
            } catch (e) {
              console.warn("Temporary audio context creation failed:", e);
            }
          }

          // Expand video display when connecting
          if (videoDisplay) {
            videoDisplay.classList.add("active");
          }
        } else if (callButton.textContent === "UN-MUTE") {
          // ---- UN-MUTE Flow ----
          console.log("UN-MUTE clicked, activating microphone and audio...");

          // Temporarily disable button to prevent double clicks
          callButton.disabled = true;

          // Force button state change immediately to ensure it happens
          setTimeout(() => {
            callButton.textContent = "DISCONNECT";
            callButton.classList.remove("unmute");
            callButton.classList.add("disconnect");
            callButton.disabled = false;
            console.log("Updated button to DISCONNECT state");
          }, 100);

          // Try to play greeting with all possible methods
          try {
            console.log("Attempting to play greeting...");

            // Try with window methods first (more reliable)
            const windowSayText = typeof window.sayText === "function";
            const windowVhostApi = typeof window.AI_vhost_api === "function";
            const localSayText = typeof sayText === "function";
            const localVhostApi = typeof AI_vhost_api === "function";

            console.log("Available speech APIs:", {
              windowSayText,
              windowVhostApi,
              localSayText,
              localVhostApi,
            });

            if (windowSayText) {
              console.log("Using window.sayText for greeting");
              try {
                // Attempt with different parameter combinations
                window.sayText("Hello, I am ready to assist you.", 1, 1, 6);
                // If the above doesn't work, this will execute in 2 seconds as a backup
                setTimeout(() => {
                  try {
                    window.sayText("Hello, I am ready to assist you.", 1);
                  } catch (e) {
                    console.warn("Backup greeting 1 failed:", e);
                  }
                }, 2000);
              } catch (e) {
                console.warn("First greeting attempt failed:", e);
              }
            } else if (windowVhostApi) {
              console.log("Using window.AI_vhost_api for greeting");
              window.AI_vhost_api("say", "Hello, I am ready to assist you.");
            } else if (localSayText) {
              console.log("Using local sayText for greeting");
              try {
                // Try different parameter combinations
                sayText("Hello, I am ready to assist you.", 1, 1, 6);
                // Backup in case the first attempt fails
                setTimeout(() => {
                  try {
                    sayText("Hello, I am ready to assist you.", 1);
                  } catch (e) {
                    console.warn("Backup local greeting failed:", e);
                  }
                }, 2000);
              } catch (e) {
                console.warn("First local greeting attempt failed:", e);
              }
            } else if (localVhostApi) {
              console.log("Using local AI_vhost_api for greeting");
              AI_vhost_api("say", "Hello, I am ready to assist you.");
            } else {
              console.warn("⚠️ No speech APIs found for greeting");

              // Last resort - try to find any SitePal API in the iframe context
              try {
                console.log(
                  "Attempting to find SitePal API in iframe context..."
                );
                const iframes = document.getElementsByTagName("iframe");
                for (let i = 0; i < iframes.length; i++) {
                  try {
                    const iframeWindow = iframes[i].contentWindow;
                    if (
                      iframeWindow &&
                      typeof iframeWindow.sayText === "function"
                    ) {
                      console.log("Found sayText in iframe", i);
                      iframeWindow.sayText(
                        "Hello, I am ready to assist you.",
                        1
                      );
                      break;
                    } else if (
                      iframeWindow &&
                      typeof iframeWindow.AI_vhost_api === "function"
                    ) {
                      console.log("Found AI_vhost_api in iframe", i);
                      iframeWindow.AI_vhost_api(
                        "say",
                        "Hello, I am ready to assist you."
                      );
                      break;
                    }
                  } catch (frameErr) {
                    console.warn("Error accessing iframe", i, frameErr);
                  }
                }
              } catch (e) {
                console.error("Last resort greeting attempt failed:", e);
              }
            }
          } catch (e) {
            console.error("Error playing greeting:", e);
          }

          // Prime audio again with saySilent for good measure
          setTimeout(() => {
            try {
              if (typeof window.saySilent === "function") {
                console.log("Priming with window.saySilent(0)");
                window.saySilent(0);
              } else if (typeof saySilent === "function") {
                console.log("Priming with saySilent(0)");
                saySilent(0);
              }
            } catch (e) {
              console.warn("Error during audio priming:", e);
            }

            // Start listening after a delay
            setTimeout(() => {
              try {
                console.log("Starting listening...");
                if (typeof window.AI_vhost_api === "function") {
                  window.AI_vhost_api("startListening");
                  console.log("Started listening with window.AI_vhost_api");
                } else if (typeof AI_vhost_api === "function") {
                  AI_vhost_api("startListening");
                  console.log("Started listening with AI_vhost_api");
                } else {
                  console.warn("No listening API available");
                }
              } catch (e) {
                console.error("Error starting listening:", e);
              }

              // Notify parent of state change
              window.parent.postMessage(
                { type: "SITEPAL_STATE_CHANGE", isListening: true },
                "*"
              );
            }, 500);
          }, 1000);
        } else {
          // ---- Disconnect Flow ----
          console.log("Disconnecting call with static effect...");
          isCallActive = false;
          window.sceneAlreadyLoaded = false; // Reset scene loaded flag on disconnect

          // Start brief static effect
          const deadAir = document.getElementById("deadAir");
          const staticEffectDuration = 1500; // ms

          if (deadAir) {
            deadAir.style.display = "block";
            deadAir.style.opacity = 1; // Ensure it's visible
            deadAir.loop = false; // Don't loop for disconnect effect
            deadAir.currentTime = 0; // Rewind to start
            deadAir
              .play()
              .catch((e) => console.error("Disconnect static play failed:", e));
          }

          // Set timeout to disconnect after static effect
          setTimeout(() => {
            console.log(
              "Disconnect static effect finished. Calling disconnectCall()."
            );
            // Use our new disconnectCall function
            disconnectCall();
          }, staticEffectDuration);
        }
      });

      // Update station
      stationSelect.addEventListener("change", () => {
        updateStationDisplay();
      });

      // Toggle 80s mode
      eightiesToggle.addEventListener("click", () => {
        const toggleRow = document.querySelector(".toggle-row.mobile-inline");

        // Toggle the isEightiesMode state
        isEightiesMode = !isEightiesMode;

        // Update UI directly
        updateEightiesUI(isEightiesMode);

        // Apply fullscreen layout in 80s mode if screen is wide enough
        if (window.innerWidth >= 768) {
          if (isEightiesMode) {
            toggleRow.classList.add("fullscreen");
          } else {
            toggleRow.classList.remove("fullscreen");
          }
        }

        // Play toggle sound
        try {
          const audioContext = new (window.AudioContext ||
            window.webkitAudioContext)();
          const oscillator = audioContext.createOscillator();
          const gainNode = audioContext.createGain();

          oscillator.type = "sine";
          oscillator.frequency.setValueAtTime(
            isEightiesMode ? 800 : 400,
            audioContext.currentTime
          );
          oscillator.frequency.exponentialRampToValueAtTime(
            isEightiesMode ? 400 : 800,
            audioContext.currentTime + 0.1
          );

          gainNode.gain.setValueAtTime(0.1, audioContext.currentTime);
          gainNode.gain.exponentialRampToValueAtTime(
            0.01,
            audioContext.currentTime + 0.1
          );

          oscillator.connect(gainNode);
          gainNode.connect(audioContext.destination);

          oscillator.start();
          oscillator.stop(audioContext.currentTime + 0.1);
        } catch (e) {
          console.log("Audio context not supported");
        }

        // Notify parent of the mode change
        window.parent.postMessage({ type: "EIGHTIES_MODE_CHANGE" }, "*");
      });

      // Toggle music
      musicToggle.addEventListener("click", () => {
        // Toggle the active state visually
        musicToggle.classList.toggle("active");

        // Get the current state
        const isMusicEnabled = musicToggle.classList.contains("active");

        // Play toggle sound
        try {
          const audioContext = new (window.AudioContext ||
            window.webkitAudioContext)();
          const oscillator = audioContext.createOscillator();
          const gainNode = audioContext.createGain();

          oscillator.type = "sine";
          oscillator.frequency.setValueAtTime(
            isMusicEnabled ? 600 : 300,
            audioContext.currentTime
          );
          oscillator.frequency.exponentialRampToValueAtTime(
            isMusicEnabled ? 300 : 600,
            audioContext.currentTime + 0.1
          );

          gainNode.gain.setValueAtTime(0.1, audioContext.currentTime);
          gainNode.gain.exponentialRampToValueAtTime(
            0.01,
            audioContext.currentTime + 0.1
          );

          oscillator.connect(gainNode);
          gainNode.connect(audioContext.destination);

          oscillator.start();
          oscillator.stop(audioContext.currentTime + 0.1);
        } catch (e) {
          console.log("Audio context not supported");
        }

        // Notify parent of the music toggle - this will control both MusicPlayer2 and MusicPlayer3
        window.parent.postMessage(
          {
            type: "MUSIC_TOGGLE",
            enabled: isMusicEnabled,
          },
          "*"
        );
      });

      // Toggle constellations
      constellationToggle.addEventListener("click", () => {
        // Toggle the active state visually
        constellationToggle.classList.toggle("active");

        // Get the current state
        const isConstellationsEnabled =
          constellationToggle.classList.contains("active");

        // Play toggle sound
        try {
          const audioContext = new (window.AudioContext ||
            window.webkitAudioContext)();
          const oscillator = audioContext.createOscillator();
          const gainNode = audioContext.createGain();

          oscillator.type = "sine";
          oscillator.frequency.setValueAtTime(
            isConstellationsEnabled ? 500 : 300,
            audioContext.currentTime
          );
          oscillator.frequency.exponentialRampToValueAtTime(
            isConstellationsEnabled ? 300 : 500,
            audioContext.currentTime + 0.1
          );

          gainNode.gain.setValueAtTime(0.1, audioContext.currentTime);
          gainNode.gain.exponentialRampToValueAtTime(
            0.01,
            audioContext.currentTime + 0.1
          );

          oscillator.connect(gainNode);
          gainNode.connect(audioContext.destination);

          oscillator.start();
          oscillator.stop(audioContext.currentTime + 0.1);
        } catch (e) {
          console.log("Audio context not supported");
        }

        // Notify parent of the constellation toggle
        window.parent.postMessage(
          {
            type: "CONSTELLATION_TOGGLE",
            enabled: isConstellationsEnabled,
          },
          "*"
        );

        console.log("Constellations toggled:", isConstellationsEnabled);
      });

      function updateEightiesUI(isActive) {
        const missionControl = document.getElementById("mission-control");
        const scanLines = document.getElementById("scan-lines");
        const colorShiftRed = document.getElementById("color-shift-red");
        const colorShiftBlue = document.getElementById("color-shift-blue");
        const blinkingCursor = document.getElementById("blinking-cursor");
        const mp3Indicator = document.getElementById("mp3-indicator");
        const threeRedShadow = document.getElementById("threedy-shadow-red");
        const threeBlueShadow = document.getElementById("threedy-shadow-blue");
        const wireframeBackdrop = document.getElementById("wireframe-backdrop");

        // Clear any previous intervals
        if (window.eightiesInterval) {
          clearInterval(window.eightiesInterval);
          window.eightiesInterval = null;
        }

        if (isActive) {
          eightiesToggle.classList.add("active");
          if (missionControl) {
            missionControl.classList.add("eighties-active");
            missionControl.classList.remove("threedy-mode");
          }
          if (scanLines) scanLines.classList.add("active");
          if (colorShiftRed) colorShiftRed.classList.add("active");
          if (colorShiftBlue) colorShiftBlue.classList.add("active");
          if (blinkingCursor) blinkingCursor.style.display = "inline-block";

          isEightiesMode = true;

          // Hide 3D shadows in 80s mode
          if (threeRedShadow) threeRedShadow.style.display = "none";
          if (threeBlueShadow) threeBlueShadow.style.display = "none";

          // Update system status text
          const statusLabel = document.querySelector(".status-label");
          if (statusLabel) {
            statusLabel.textContent = "RETRO";
            // Remove 3D text shadows for 80s mode
            statusLabel.style.textShadow = "0 0 3px #22d3ee";
          }

          // Remove 3D text shadows from all elements in 80s mode
          document
            .querySelectorAll(
              ".control-button, .toggle-label, .status-label, .leaderboard-header"
            )
            .forEach((element) => {
              // Use appropriate 80s text shadow instead
              element.style.textShadow = "0 0 3px #d946ef";
            });

          // Add some random glitches (reduced frequency and opacity)
          window.eightiesInterval = setInterval(() => {
            if (Math.random() > 0.97 && scanLines) {
              scanLines.style.opacity = "0.6";
              setTimeout(() => {
                if (scanLines) scanLines.style.opacity = "0.7";
              }, 100);
            }
          }, 3000);

          // If music is active, notify the parent to use
          // Add class to body for additional styles
          document.body.classList.add("eighties-mode");
        } else {
          eightiesToggle.classList.remove("active");
          if (missionControl) {
            missionControl.classList.remove("eighties-active");
            missionControl.classList.add("threedy-mode");
          }
          if (scanLines) scanLines.classList.remove("active");
          if (colorShiftRed) colorShiftRed.classList.remove("active");
          if (colorShiftBlue) colorShiftBlue.classList.remove("active");
          if (blinkingCursor) blinkingCursor.style.display = "none";

          // Fade out wireframe backdrop

          isEightiesMode = false;

          // Show 3D shadows when not in 80s mode
          if (threeRedShadow) threeRedShadow.style.display = "block";
          if (threeBlueShadow) threeBlueShadow.style.display = "block";

          // Hide MP3 indicator
          if (mp3Indicator) {
            mp3Indicator.style.display = "none";
          }

          // Reset status text to 3D style
          const statusLabel = document.querySelector(".status-label");
          if (statusLabel) {
            statusLabel.textContent = "3D//ACTIVE";
            statusLabel.style.textShadow = "-1px 0 #ff0040, 1px 0 #00b4ff";
          }

          // Apply 3D text shadows to all elements when not in 80s mode
          document
            .querySelectorAll(
              ".control-button, .toggle-label, .status-label, .leaderboard-header"
            )
            .forEach((element) => {
              element.style.textShadow = "-1px 0 #ff0040, 1px 0 #00b4ff";
            });

          // Remove eighties mode class from body
          document.body.classList.remove("eighties-mode");
        }

        document.documentElement.style.setProperty(
          "--eighties-color",
          isActive ? "#2a1786" : "transparent"
        );

        // REMOVED: The problematic code that was forcing 3D mode and hiding wireframe
        // regardless of the eighties mode setting
      }

      // Notify parent that music should be hidden

      function updateLeaderboardUI() {
        if (isLeaderboardExpanded) {
          leaderboardContent.style.display = "block";
          leaderboardArrow.textContent = "▲";
        } else {
          leaderboardContent.style.display = "none";
          leaderboardArrow.textContent = "▼";
        }
      }

      updateLeaderboardUI(); // Initialize leaderboard state

      // Apply appropriate UI state based on URL parameters
      const urlParams = new URLSearchParams(window.location.search);
      const startIn80sMode = urlParams.get("eighties") === "true";

      if (startIn80sMode) {
        isEightiesMode = true;
        updateEightiesUI(true);
      } else {
        isEightiesMode = false;
        updateEightiesUI(false);

        // If not starting in 80s mode, ensure 3D effect is applied
        const missionControlPanel = document.getElementById("mission-control");
      }

      // Ensure system status is always on
      if (systemStatus) systemStatus.classList.add("active");

      // Toggle Leaderboard
      const leaderboardToggle = document.getElementById("leaderboard-toggle");
      if (leaderboardToggle) {
        leaderboardToggle.addEventListener("click", () => {
          isLeaderboardExpanded = !isLeaderboardExpanded;
          updateLeaderboardUI();
          playClickSound(); // Add click sound feedback
        });
      }

      // Event Listeners for Control Buttons
      document.querySelectorAll(".control-button").forEach((button) => {
        button.addEventListener("click", () => {
          playClickSound();
          const action = button.getAttribute("data-action");
          handleControlAction(action);
        });
      });

      // Handle Control Actions
      function handleControlAction(action) {
        const button = document.querySelector(`[data-action="${action}"]`);
        const indicator = button.querySelector(".button-indicator");
        if (!indicator) return;

        // Add active state to the button
        button.classList.add("active");
        indicator.classList.add("active");

        // Handle specific actions
        switch (action) {
          case "launch":
            console.log("Launch sequence initiated");
            // Send message to parent to toggle launch mode
            window.parent.postMessage({ type: "LAUNCH_MODE_TOGGLE" }, "*");
            break;
          case "orbit":
            console.log("Orbit adjustment in progress");
            break;
          case "signal":
            console.log("Signal broadcast initiated");
            break;
          case "return":
            console.log("Return sequence activated");
            break;
        }

        // Remove active states after animation
        setTimeout(() => {
          button.classList.remove("active");
          indicator.classList.remove("active");
        }, 2000);
      }

      // At the end of the file, add this script to resize the container
      document.addEventListener("DOMContentLoaded", function () {
        // Function to adjust height to fill viewport
        function adjustHeight() {
          const missionControl = document.querySelector(".mission-control");
          if (missionControl) {
            const viewportHeight = window.innerHeight;
            missionControl.style.minHeight = `${viewportHeight}px`;
          }
        }

        // Run on load and resize
        adjustHeight();
        window.addEventListener("resize", adjustHeight);
      });

      // Add click handler for collapsed video display
      document.addEventListener("DOMContentLoaded", function () {
        const videoDisplay = document.querySelector(".video-display");
        if (videoDisplay) {
          // Initialize the display state based on screen height and call state
          if (window.innerHeight <= 700 && !isCallActive) {
            videoDisplay.classList.remove("active");
          } else {
            videoDisplay.classList.add("active");
          }

          videoDisplay.addEventListener("click", function () {
            // Add a "touched" class to stop the pulsing animation
            this.classList.add("touched");

            // Only trigger expansion if in collapsed state on mobile
            if (
              window.innerHeight <= 700 &&
              !this.classList.contains("active") &&
              !isCallActive
            ) {
              this.classList.add("active");
              // Auto-collapse after 5 seconds if no call initiated
              setTimeout(() => {
                if (!isCallActive) {
                  this.classList.remove("active");
                }
              }, 5000);
            } else if (
              window.innerHeight <= 700 &&
              this.classList.contains("active") &&
              !isCallActive
            ) {
              // Allow collapsing when clicked if already expanded and not in a call
              this.classList.remove("active");
            }
          });
        }
      });

      // Modify the existing disconnectCall function to handle collapsing on mobile
      function disconnectCall() {
        isCallActive = false;
        if (typeof AI_vhost_api === "function") {
          console.log("🛑 Stopping SitePal character...");
          AI_vhost_api("stop");
        } else {
          console.warn("AI_vhost_api is not available to stop.");
        }

        // Hide SitePal container
        const container = document.getElementById("sitepal-container");
        if (container) {
          container.style.display = "none";
          container.innerHTML = ""; // optional: clear inner content
        }
        // Collapse video display when disconnecting on mobile
        const videoDisplay = document.querySelector(".video-display");
        if (videoDisplay && window.innerHeight <= 700) {
          videoDisplay.classList.remove("active");
        }

        // Existing disconnect logic
        const callButton = document.getElementById("call-button");
        const callStatus = document.getElementById("call-status");
        const stationSelect = document.getElementById("station-select");
        const selfView = document.getElementById("self-view");
        const liveIndicator = document.getElementById("live-indicator");
        const sitepalContainer = document.getElementById("sitepal-container");
        const deadAir = document.getElementById("deadAir");
        const offlineDisplay = document.getElementById("offline-display");

        // Reset all UI elements
        callButton.textContent = "CONNECT";
        callButton.classList.remove("disconnect", "unmute");
        callStatus.classList.remove("active");
        stationSelect.disabled = false;
        selfView.style.display = "none";
        liveIndicator.style.display = "none";

        // Show offline display
        offlineDisplay.style.display = "flex";

        // Hide and stop video, hide SitePal
        deadAir.style.display = "none";
        deadAir.pause();
        sitepalContainer.style.display = "none";

        // Clean up SitePal instance
        // cleanupSitePal();

        // Reset the initialization state
        sitepalContainer.dataset.initialized = "false";

        // Notify parent
        window.parent.postMessage(
          { type: "SITEPAL_STATE_CHANGE", isListening: false },
          "*"
        );
      }

      // Add resize handler to adjust video display state when resizing
      window.addEventListener("resize", function () {
        const videoDisplay = document.querySelector(".video-display");
        if (videoDisplay) {
          if (window.innerHeight <= 700 && !isCallActive) {
            videoDisplay.classList.remove("active");
          } else if (window.innerHeight > 700) {
            videoDisplay.classList.add("active");
          }
        }
      });

      // Check for initial message from parent to sync toggle states
      window.addEventListener("message", (event) => {
        // Check if the message is from the parent frame
        if (event.source === window.parent) {
          const data = event.data;

          // Handle state synchronization
          if (data.type === "SYNC_STATE") {
            // Sync 80s mode
            if (data.isEightiesMode !== undefined) {
              isEightiesMode = data.isEightiesMode;
              updateEightiesUI(isEightiesMode);
            }

            // Sync music state
            if (data.isMusicEnabled !== undefined) {
              if (data.isMusicEnabled) {
                musicToggle.classList.add("active");
              } else {
                musicToggle.classList.remove("active");
              }
            }

            // Sync constellation state
            if (data.isConstellationsEnabled !== undefined) {
              if (data.isConstellationsEnabled) {
                constellationToggle.classList.add("active");
              } else {
                constellationToggle.classList.remove("active");
              }
            }
          }

          // Handle music state updates from parent (when music players change state)
          if (data.type === "SET_MUSIC_STATE") {
            // Update music toggle to match the music player state
            if (data.isPlaying !== undefined) {
              if (data.isPlaying) {
                musicToggle.classList.add("active");
              } else {
                musicToggle.classList.remove("active");
              }
              console.log(
                "Music toggle synchronized to player state:",
                data.isPlaying
              );
            }
          }
        }
      });

      // Styling for the music toggle
      document.addEventListener("DOMContentLoaded", function () {
        // Add music toggle style
        const musicToggle = document.getElementById("music-toggle");
        if (musicToggle) {
          // Check if music should be on by default based on screen size
          // On larger screens, music is typically enabled
          if (window.innerWidth > 768) {
            musicToggle.classList.add("active");
            // Notify parent that music should be on
            window.parent.postMessage(
              {
                type: "MUSIC_TOGGLE",
                enabled: true,
              },
              "*"
            );
          }
        }
      });

      // Add window resize handler for toggle layout
      window.addEventListener("resize", () => {
        const toggleRow = document.querySelector(".toggle-row.mobile-inline");
        if (window.innerWidth >= 768 && isEightiesMode) {
          toggleRow.classList.add("fullscreen");
        } else {
          toggleRow.classList.remove("fullscreen");
        }
      });
    </script>
  </body>
</html>
