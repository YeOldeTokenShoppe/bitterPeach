<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cyberpunk Mission Control Panel</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap"
      rel="stylesheet"
    />

    <style>
      /* Ensure full height on all devices */
      html,
      body {
        height: 100vh;
        margin: 0;
        padding: 0;
        overflow-x: hidden;
      }

      body {
        margin: 0;
        padding: 0;
        font-family: monospace;
        background-color: transparent !important;
        color: #67e8f9;
        display: flex;
        justify-content: center;
        width: 100%;
        position: relative;
        min-height: 100vh; /* Minimum height to ensure it fills viewport */
        overflow-y: auto; /* Allow vertical scrolling if needed */
      }

      .mission-control {
        width: 100%;
        max-width: 450px;
        min-height: 100vh; /* Use min-height instead of fixed height */
        background-image: linear-gradient(to bottom, #0f172a, #1e293b);
        display: flex;
        flex-direction: column;
        padding: 16px;
        border-left: 1px solid #0e7490;
        border-right: 1px solid #0e7490;
        box-shadow: 0 0 15px rgba(6, 182, 212, 0.3),
          inset 0 0 10px rgba(6, 182, 212, 0.1);
        overflow-y: auto;
        overflow-x: hidden; /* Hide horizontal scrollbar */
        position: relative;
        z-index: 1;
        box-sizing: border-box;
      }

      /* Fix panel header height */
      .panel-header {
        min-height: 60px;
        height: 60px;
        max-height: 60px;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        margin-bottom: 16px;
        padding-bottom: 8px;
        border-bottom: 1px solid #0e7490;
      }

      /* Fix panel title height */
      .panel-title {
        height: 22px;
        line-height: 1.2;
        margin: 0;
        padding: 0;
        font-size: 1.05rem;
        letter-spacing: 0.2em;
        font-weight: bold;
        color: #67e8f9;
        text-shadow: -2px 0 #ff0040, 2px 0 #00b4ff;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
      }

      .panel-subtitle {
        font-size: 0.75rem;
        line-height: 1.4;
        color: white;
        text-shadow: -1px 0 #ff0040, 1px 0 #00b4ff;
        letter-spacing: 0.1em;
        margin-top: 4px;
      }

      .video-call {
        margin-bottom: 16px;
        background-color: #000;
        border: 1px solid #134e4a;
        border-radius: 4px;
        overflow: visible;
        position: relative;
        z-index: 50;
      }

      .video-header {
        background-color: #111827;
        padding: 4px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #134e4a;
        font-size: 0.75rem;
      }

      .video-status {
        height: 8px;
        width: 8px;
        border-radius: 50%;
        background-color: #4b5563;
      }

      .video-status.active {
        background-color: #ef4444;
        animation: pulse 2s infinite;
      }

      /* Default video display state - always expanded on non-mobile screens */
      .video-display {
        height: 180px;
        position: relative;
        background: linear-gradient(45deg, #041c2c, #000);
        overflow: hidden;
        transition: height 0.3s ease-out;
      }

      /* Media query for shorter screens (likely mobile) - allow collapsing */
      @media (max-height: 700px) {
        /* Default collapsed height on mobile when inactive */
        .video-display:not(.active) {
          height: 40px;
        }

        /* When active, maintain original height */
        .video-display.active {
          height: 180px !important;
        }

        /* Add an indicator for the collapsed state */
        .video-display:not(.active)::after {
          content: "Tap to expand";
          position: absolute;
          top: 50%;
          left: 50%;
          transform: translate(-50%, -50%);
          color: #67e8f9;
          font-size: 0.75rem;
          text-shadow: 0 0 5px #06b6d4;
          opacity: 1;
          transition: opacity 0.3s ease-out;
        }

        /* Hide the tap indicator when active */
        .video-display.active::after {
          opacity: 0;
        }

        /* Add expand/collapse indicators */
        .video-display::before {
          content: "▼";
          position: absolute;
          right: 8px;
          top: 10px;
          color: #67e8f9;
          font-size: 0.7rem;
          opacity: 0.8;
          z-index: 20;
          pointer-events: none;
          transition: transform 0.3s ease-out;
        }

        .video-display.active::before {
          transform: rotate(180deg);
          top: 8px;
        }

        /* Add touch hint on first load */
        .video-display:not(.touched):not(.active)::after {
          animation: pulse 2s infinite;
        }
      }

      /* Collapsed state for the video display - REMOVE THIS as we're handling it in the media query */

      /* SitePal loading logo */
      .waiting_logo {
        position: absolute !important;
        top: 0 !important;
        left: 0 !important;
        width: 100% !important;
        height: 100% !important;
        z-index: 14;
      }

      #sitepal-container {
        position: absolute !important;
        top: 0 !important;
        left: 0 !important;
        width: 100% !important;
        height: 100% !important;
        z-index: 5 !important; /* Lower z-index during loading */
        display: none;
        -webkit-overflow-scrolling: touch;
      }

      #sitepal-container.active {
        display: block !important; /* Use !important to ensure it overrides other styles */
        z-index: 30 !important; /* Higher z-index only when active */
      }

      /* Hide SitePal loading elements */
      #sitepal-container .waiting_logo,
      #sitepal-container .loading-container,
      #sitepal-container [id*="loading"],
      #sitepal-container [class*="loading"] {
        display: none !important;
        opacity: 0 !important;
        visibility: hidden !important;
      }

      /* Style for video feed and transmission effect */
      #video-feed {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 10; /* Higher than sitepal during loading */
      }

      #deadAir {
        z-index: 20 !important; /* Ensure transmission effect is above everything during loading */
        position: relative;
      }

      /* Make sure SitePal player is visible */
      #vhss_aiPlayer {
        width: 100% !important;
        height: 100% !important;
        z-index: 20 !important;
      }

      /* Ensure video stays behind sitepal when active */
      #video-feed video {
        width: 100%;
        height: 100%;
        object-fit: cover;
        /* Add transition and initial z-index */
        transition: opacity 0.5s ease-out;
        z-index: 15; /* Ensure it's above sitepal-container (z-index 10) during effect */
        display: none; /* Hide initially */
      }

      .video-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-image: repeating-linear-gradient(
          transparent,
          transparent 1px,
          rgba(6, 182, 212, 0.05) 1px,
          rgba(6, 182, 212, 0.05) 2px
        );
        background-size: 100% 2px;
        pointer-events: none;
        z-index: 10;
        display: none;
        -webkit-overflow-scrolling: touch;
      }

      /* 3D video overlay */
      .threedy-mode .video-overlay {
        background-image: repeating-linear-gradient(
          transparent,
          transparent 1px,
          rgba(255, 0, 64, 0.05) 1px,
          rgba(0, 180, 255, 0.05) 2px
        );
        background-size: 100% 2px;
        box-shadow: inset -2px 0 10px rgba(255, 0, 64, 0.1),
          inset 2px 0 10px rgba(0, 180, 255, 0.1);
      }

      /* 80s video overlay */
      .eighties-active .video-overlay {
        background-image: repeating-linear-gradient(
          transparent,
          transparent 1px,
          rgba(217, 70, 239, 0.05) 1px,
          rgba(34, 211, 238, 0.05) 2px
        );
        background-size: 100% 2px;
        box-shadow: inset 0 0 20px rgba(217, 70, 239, 0.1);
        opacity: 0.8;
      }

      .video-gradient {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-image: linear-gradient(
          to bottom,
          transparent,
          rgba(0, 0, 0, 0.5)
        );
        pointer-events: none;
      }

      .video-feed {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        color: #4b5563;
      }

      .video-feed.offline::before,
      .video-feed.offline::after {
        content: "";
        position: absolute;
        background-color: #1f2937;
      }

      .video-feed.offline::before {
        width: 100%;
        height: 1px;
        top: 50%;
      }

      .video-feed.offline::after {
        height: 100%;
        width: 1px;
        left: 50%;
      }

      .self-view {
        position: absolute;
        bottom: 8px;
        right: 8px;
        width: 60px;
        height: 40px;
        background-color: #111827;
        border: 1px solid #0e7490;
        border-radius: 2px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        z-index: 20; /* Ensure it stays above SitePal elements */
      }

      .self-view img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .self-view .emoji-placeholder {
        font-size: 1.75rem;
        color: #67e8f9;
        text-shadow: 0 0 5px #06b6d4;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
        line-height: 1;
      }

      .live-indicator {
        position: absolute;
        bottom: 8px;
        left: 8px;
        font-size: 0.75rem;
        color: #22d3ee;
        animation: pulse 2s infinite;
      }

      .video-controls {
        background-color: #111827;
        padding: 4px;
        display: flex;
        justify-content: space-between;
        position: relative;
        z-index: 100;
      }

      .call-button {
        font-size: 0.75rem;
        font-family: monospace;
        padding: 4px 8px;
        border-radius: 4px;
        cursor: pointer;
        background-color: #1f2937;
        color: #22d3ee;
        border: 1px solid #134e4a;
        box-shadow: 0 0 5px rgba(6, 182, 212, 0.3);
        position: relative;
        z-index: 101;
      }

      .call-button.disconnect {
        color: #f87171;
        border-color: #7f1d1d;
        box-shadow: 0 0 5px rgba(220, 38, 38, 0.3);
      }

      .station-select {
        background-color: #1f2937;
        color: #22d3ee;
        font-size: 0.75rem;
        font-family: monospace;
        padding: 0 4px;
        border: 1px solid #134e4a;
        border-radius: 4px;
        box-shadow: 0 0 3px rgba(6, 182, 212, 0.2);
        position: relative;
        z-index: 101;
      }

      .button-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-bottom: 16px;
      }

      .control-button {
        background-color: #1f2937;
        border-left: 2px solid #ff0040;
        border-right: 2px solid #00b4ff;
        border-top: 1px solid transparent; /* Add transparent top/bottom for consistency */
        border-bottom: 1px solid transparent;
        border-radius: 4px;
        padding: 12px;
        color: #67e8f9;
        font-family: monospace;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center; /* Vertically center content */
        min-height: 62px; /* Ensure consistent minimum height */
        cursor: pointer;
        transition: all 0.3s;
        box-shadow: -2px 0 5px rgba(255, 0, 64, 0.3),
          2px 0 5px rgba(0, 180, 255, 0.3), 0 0 5px rgba(6, 182, 212, 0.2),
          inset 0 0 10px rgba(6, 182, 212, 0.05);
      }

      .control-button:hover {
        background-color: #374151;
        border-left: 2px solid #ff4080;
        border-right: 2px solid #40b4ff;
        box-shadow: -3px 0 10px rgba(255, 0, 64, 0.5),
          3px 0 10px rgba(0, 180, 255, 0.5);
      }

      .button-prefix {
        font-size: 0.75rem;
        line-height: 1.3;
        margin-bottom: 4px;
        opacity: 0.7;
      }

      .button-label {
        font-weight: bold;
        letter-spacing: 0.1em;
        font-size: 0.875rem;
        line-height: 1.3;
      }

      .button-indicator {
        width: 32px;
        height: 4px;
        margin-top: 4px;
        background-color: #0e7490;
        border-radius: 9999px;
      }

      .toggle-section {
        margin-bottom: 16px;
        background-color: #111827;
        padding: 12px;
        border-radius: 4px;
        border: 1px solid #134e4a;
        box-shadow: inset 0 0 10px rgba(0, 0, 0, 0.5);
      }

      .toggle-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
      }

      .toggle-row .label-switch-container {
        display: flex;
        width: 100%;
        justify-content: space-between;
        align-items: center;
      }

      .toggle-row:last-child {
        margin-bottom: 0;
      }

      .toggle-label {
        font-size: 0.875rem;
        line-height: 1.4;
      }

      .toggle-switch {
        width: 48px;
        height: 24px;
        background-color: #1f2937;
        border-radius: 9999px;
        position: relative;
        padding: 2px;
        cursor: pointer;
        transition: background-color 0.3s;
      }

      .toggle-switch.active {
        background-color: #134e4a;
        box-shadow: 0 0 5px rgba(6, 182, 212, 0.5);
      }

      .toggle-switch.eighties.active {
        background-color: #4c1d95;
        box-shadow: 0 0 5px rgba(147, 51, 234, 0.5);
      }

      .toggle-switch.music.active {
        background-color: #ca8a04;
        box-shadow: 0 0 5px rgba(234, 179, 8, 0.5);
      }

      .toggle-switch.music:hover {
        box-shadow: 0 0 8px rgba(234, 179, 8, 0.7);
      }

      .toggle-handle {
        width: 18px;
        height: 18px;
        background-color: #e5e7eb;
        border-radius: 50%;
        position: absolute;
        top: 3px;
        left: 3px;
        transition: transform 0.3s;
      }

      .toggle-switch.active .toggle-handle {
        transform: translateX(24px);
      }

      .leaderboard-header {
        width: 100%;
        background-color: #1f2937;
        border-radius: 4px;
        border: 1px solid #134e4a;
        padding: 4px;
        font-family: monospace;
        color: #22d3ee;
        font-size: 0.75rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 4px;
        cursor: pointer;
        box-shadow: 0 0 5px rgba(6, 182, 212, 0.2);
      }

      .leaderboard-content {
        background-color: #111827;
        border-radius: 4px;
        border: 1px solid #134e4a;
        padding: 8px;
        font-family: monospace;
        color: #22d3ee;
        font-size: 0.875rem;
        margin-bottom: 12px;
        box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.7);
        background-image: linear-gradient(to bottom, #0c1721, #0a0f16);
      }

      .leaderboard-header-row {
        display: flex;
        justify-content: space-between;
        font-size: 0.75rem;
        margin-bottom: 4px;
        padding-bottom: 4px;
        border-bottom: 1px solid #1f2937;
      }

      .leaderboard-scrollable {
        height: 128px;
        overflow-y: auto;
        background-image: repeating-linear-gradient(
          transparent,
          transparent 1px,
          rgba(6, 182, 212, 0.03) 1px,
          rgba(6, 182, 212, 0.03) 2px
        );
        background-size: 100% 2px;
      }

      .leaderboard-entry {
        display: flex;
        justify-content: space-between;
        padding: 4px 0;
      }

      .leaderboard-entry.top {
        color: #67e8f9;
        font-weight: bold;
        text-shadow: 0 0 5px #06b6d4;
      }

      .leaderboard-footer {
        margin-top: 8px;
        font-size: 0.75rem;
        text-align: center;
        color: #22d3ee;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .pulse-dot {
        height: 4px;
        width: 4px;
        border-radius: 50%;
        background-color: #22d3ee;
        margin-right: 4px;
        animation: pulse 2s infinite;
      }

      .status-bar {
        margin-top: 16px;
        display: flex;
        justify-content: space-between;
        margin-top: auto; /* Push status bar to the bottom */
      }

      .status-indicator {
        display: flex;
        align-items: center;
      }

      .status-light {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        margin-right: 8px;
        background-color: #ef4444;
      }

      .status-light.active {
        background-color: #22d3ee;
        animation: pulse 2s infinite;
        box-shadow: 0 0 5px #06b6d4, 0 0 5px 2px rgba(255, 255, 255, 0.7),
          -2px 0 8px #ff0040, 2px 0 8px #00b4ff;
      }

      .status-label {
        font-size: 0.75rem;
      }

      .version-info {
        font-size: 0.75rem;
        color: #4b5563;
      }

      .spacer {
        flex-grow: 1;
      }

      @keyframes pulse {
        0% {
          opacity: 1;
        }
        50% {
          opacity: 0.5;
        }
        100% {
          opacity: 1;
        }
      }

      /* Hide scrollbar for Chrome, Safari and Opera */
      .leaderboard-scrollable::-webkit-scrollbar {
        display: none;
      }

      /* Hide scrollbar for IE, Edge and Firefox */
      .leaderboard-scrollable {
        -ms-overflow-style: none; /* IE and Edge */
        scrollbar-width: none; /* Firefox */
      }

      .control-button[data-action="signal"] {
        position: relative;
      }

      .control-button[data-action="signal"]:after {
        content: "";
        position: absolute;
        top: -2px;
        left: -2px;
        right: -2px;
        bottom: -2px;
        border-radius: 6px;
        background: transparent;
        transition: all 0.3s;
      }

      .control-button[data-action="signal"].active {
        background-color: #450a0a;
        border-color: #dc2626;
      }

      .control-button[data-action="signal"].active:after {
        background: linear-gradient(45deg, #dc2626, #450a0a);
        filter: blur(8px);
        opacity: 0.6;
        z-index: -1;
      }

      .control-button[data-action="signal"] .button-indicator {
        background-color: #dc2626;
        transition: all 0.3s;
      }

      .control-button[data-action="signal"].active .button-indicator {
        animation: redPulse 2s infinite;
      }

      .toggle-switch.emergency.active {
        background-color: #991b1b;
        box-shadow: 0 0 15px rgba(239, 68, 68, 0.5);
      }

      .toggle-switch.emergency.active .toggle-handle {
        background-color: #fecaca;
      }

      #vhss-aiplayer-aiformlogs {
        display: none !important;
        opacity: 0 !important;
      }

      /* 80s mode styles */
      .mission-control.eighties-active {
        /* background-image: linear-gradient(to bottom, #0b132b, #2a1786); */
        border-left: 1px solid #d946ef;
        box-shadow: 0 0 12px rgba(217, 70, 239, 0.3),
          inset 0 0 8px rgba(217, 70, 239, 0.1);
      }

      .eighties-active .panel-title {
        height: 22px;
        line-height: 1.5;
        font-size: 0.8rem;
        color: #d946ef;
        text-shadow: 0 0 3px #d946ef, 0 0 6px #d946ef;
        font-family: "Press Start 2P", cursive;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
      }

      .eighties-active .panel-subtitle {
        height: 18px;
        line-height: 1.4;
        font-size: 0.6rem;
        color: #22d3ee;
        font-family: "Press Start 2P", cursive;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
      }

      .eighties-active .toggle-label,
      .eighties-active .button-label,
      .eighties-active .button-prefix,
      .eighties-active .status-label {
        font-family: "Press Start 2P", cursive;
        font-size: 0.6rem !important; /* Ensure override */
        line-height: 1.5 !important; /* Ensure override */
        text-shadow: 0 0 3px #d946ef !important;
      }

      /* Keep button-prefix smaller in 80s mode */
      .eighties-active .button-prefix {
        font-family: "Press Start 2P", cursive;
        font-size: 0.5rem !important;
        line-height: 1.3 !important;
        opacity: 0.8;
        text-shadow: 0 0 3px #d946ef !important;
      }

      .eighties-active .control-button {
        border: 1px solid #d946ef !important; /* Consistent 1px border */
        padding: 12px !important; /* Use same padding as base */
        min-height: 62px !important; /* Ensure override for consistency */
        box-shadow: 0 0 3px rgba(217, 70, 239, 0.3) !important;
        background-image: linear-gradient(
          to bottom,
          #0f172a,
          #2a1786
        ) !important;
        border-left: 1px solid #d946ef !important;
        border-right: 1px solid #d946ef !important;
        transition: all 0.3s;
      }

      .eighties-active .control-button:hover {
        /* background-image: linear-gradient(to bottom, #2a1786, #0f172a); */
        transform: translateY(-2px);
        box-shadow: 0 0 6px rgba(217, 70, 239, 0.5);
      }

      .eighties-active .button-indicator {
        background-color: #d946ef;
        box-shadow: 0 0 3px #d946ef;
      }

      .eighties-active .toggle-section,
      .eighties-active .leaderboard-header,
      .eighties-active .leaderboard-content {
        border-color: #d946ef;
      }

      .eighties-active .status-light.active {
        background-color: #22d3ee;
        box-shadow: 0 0 6px #22d3ee;
        animation: flicker 2s infinite;
      }

      @keyframes flicker {
        0% {
          opacity: 1;
        }
        25% {
          opacity: 0.8;
        }
        30% {
          opacity: 1;
        }
        35% {
          opacity: 0.6;
        }
        40% {
          opacity: 1;
        }
        50% {
          opacity: 0.9;
        }
        75% {
          opacity: 1;
        }
        80% {
          opacity: 0.7;
        }
        100% {
          opacity: 1;
        }
      }

      .eighties-active .panel-title {
        animation: glitch 5s infinite;
      }

      /* Color shifting for VHS effect */
      .color-shift {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        mix-blend-mode: screen;
        pointer-events: none;
        opacity: 0;
        z-index: 998;
        transition: opacity 0.3s ease;
      }

      .color-shift.active {
        opacity: 0.02;
        animation: color-drift 8s infinite;
      }

      .color-shift-red {
        background-color: #ff0000;
        transform: translateX(-1px);
      }

      .color-shift-blue {
        background-color: #0000ff;
        transform: translateX(1px);
      }

      /* Scan line effect for 80s mode */
      .scan-lines {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(
          to bottom,
          rgba(255, 255, 255, 0.02) 50%,
          rgba(0, 0, 0, 0.08) 50%
        );
        background-size: 100% 4px;
        pointer-events: none;
        z-index: 999;
        opacity: 0;
        transition: opacity 0.3s ease;
      }

      .scan-lines.active {
        opacity: 0.7;
      }

      /* Retro cursor for 80s mode */
      .eighties-active * {
        cursor: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' style='fill:none;stroke:%23ff00ff;stroke-width:2px'><rect width='8' height='12'/></svg>")
            0 0,
          auto !important;
      }

      /* Blinking text effect */
      @keyframes blink {
        0%,
        49% {
          opacity: 1;
        }
        50%,
        100% {
          opacity: 0;
        }
      }

      .eighties-active .blinking-cursor {
        display: inline-block;
        width: 8px;
        height: 12px;
        background-color: #ff00ff;
        animation: blink 1s infinite;
        margin-left: 4px;
        vertical-align: middle;
      }

      /* Button press effect */
      .eighties-active .control-button:active {
        transform: translateY(1px);
        box-shadow: 0 0 15px rgba(255, 0, 255, 1);
      }

      /* Button active state for 80s mode */
      .eighties-active .control-button.activated {
        background-image: linear-gradient(to bottom, #3a0ca3, #000000);
        border-color: #00ffff;
        box-shadow: 0 0 10px rgba(0, 255, 255, 0.6);
      }

      .eighties-active .control-button.activated .button-indicator {
        background-color: #00ffff;
        box-shadow: 0 0 5px #00ffff;
      }

      .toggle-switch.eighties:hover {
        box-shadow: 0 0 8px rgba(147, 51, 234, 0.7);
      }

      /* 3D glasses mode styles */
      .threedy-mode {
        position: relative;
        overflow: hidden;
      }

      .threedy-mode .panel-title {
        position: relative;
        text-shadow: -2px 0 #ff0040, 2px 0 #00b4ff;
        color: white;
      }

      .threedy-mode .panel-subtitle {
        position: relative;
        text-shadow: -1px 0 #ff0040, 1px 0 #00b4ff;
        color: white;
      }

      .threedy-mode .button-label,
      .threedy-mode .toggle-label,
      .threedy-mode .status-label,
      .threedy-mode #station-display {
        position: relative;
        text-shadow: -1px 0 #ff0040, 1px 0 #00b4ff;
      }

      .threedy-shadow-red,
      .threedy-shadow-blue {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        opacity: 0.03;
      }

      .threedy-shadow-red {
        box-shadow: inset 0 0 15px 2px #ff0040;
        transform: translateX(-1px);
        z-index: 10;
      }

      .threedy-shadow-blue {
        box-shadow: inset 0 0 15px 2px #00b4ff;
        transform: translateX(1px);
        z-index: 11;
      }

      .threedy-mode .control-button {
        position: relative;
        border: 1px solid transparent; /* Base border */
        border-left: 2px solid #ff0040;
        border-right: 2px solid #00b4ff;
        padding: 11px; /* Keep padding consistent */
        box-shadow: -2px 0 5px rgba(255, 0, 64, 0.3),
          2px 0 5px rgba(0, 180, 255, 0.3);
        transition: all 0.3s ease;
      }

      .threedy-mode .control-button:hover {
        border-left: 2px solid #ff4080;
        border-right: 2px solid #40b4ff;
        box-shadow: -3px 0 10px rgba(255, 0, 64, 0.5),
          3px 0 10px rgba(0, 180, 255, 0.5);
      }

      .threedy-mode .toggle-switch {
        border-left: 1px solid #ff0040;
        border-right: 1px solid #00b4ff;
        box-shadow: -1px 0 3px rgba(255, 0, 64, 0.3),
          1px 0 3px rgba(0, 180, 255, 0.3);
      }

      .threedy-mode .toggle-switch.active {
        background: linear-gradient(
          90deg,
          rgba(255, 0, 64, 0.3),
          rgba(0, 180, 255, 0.3)
        );
      }

      .threedy-mode .toggle-handle {
        box-shadow: -1px 0 2px rgba(255, 0, 64, 0.5),
          1px 0 2px rgba(0, 180, 255, 0.5);
      }

      .threedy-mode .video-call,
      .threedy-mode .toggle-section,
      .threedy-mode .leaderboard-header,
      .threedy-mode .leaderboard-content {
        border-left: 1px solid #ff0040;
        border-right: 1px solid #00b4ff;
        box-shadow: -2px 0 5px rgba(255, 0, 64, 0.2),
          2px 0 5px rgba(0, 180, 255, 0.2);
      }

      .threedy-mode .status-light.active {
        box-shadow: 0 0 5px 2px rgba(255, 255, 255, 0.7), -2px 0 8px #ff0040,
          2px 0 8px #00b4ff;
      }

      /* 3D toggle button */
      .toggle-switch.threedy-toggle.active {
        background: linear-gradient(90deg, #ff0040, #00b4ff);
        box-shadow: 0 0 10px rgba(255, 255, 255, 0.5);
      }

      .toggle-switch.threedy-toggle:hover {
        box-shadow: 0 0 8px rgba(255, 255, 255, 0.7);
      }

      /* 80s mode with 3D enhancements - remove these to keep modes separate */
      .eighties-active.threedy-mode .panel-title,
      .eighties-active.threedy-mode .panel-subtitle,
      .eighties-active.threedy-mode .toggle-label,
      .eighties-active.threedy-mode .button-label,
      .eighties-active.threedy-mode .button-prefix,
      .eighties-active.threedy-mode .control-button,
      .eighties-active.threedy-mode .status-label {
        /* Override with blank styles to prevent inheritance */
        text-shadow: none;
        border-left: none;
        border-right: none;
        box-shadow: none;
      }

      /* Override specific 80s styles to ensure they take precedence */
      .eighties-active .panel-title {
        color: #d946ef;
        text-shadow: 0 0 3px #d946ef, 0 0 6px #d946ef !important;
        font-family: "Press Start 2P", cursive;
        font-size: 0.8rem !important; /* Ensure override */
        line-height: 1.5 !important; /* Ensure override */
        animation: glitch 5s infinite;
      }

      .eighties-active .panel-subtitle {
        color: #22d3ee;
        text-shadow: 0 0 3px #22d3ee !important;
        font-family: "Press Start 2P", cursive;
        font-size: 0.6rem !important; /* Ensure override */
        line-height: 1.4 !important; /* Ensure override */
      }

      .eighties-active .toggle-label,
      .eighties-active .button-label,
      .eighties-active .button-prefix,
      .eighties-active .status-label {
        font-family: "Press Start 2P", cursive;
        font-size: 0.6rem !important; /* Ensure override */
        line-height: 1.5 !important; /* Ensure override */
        text-shadow: 0 0 3px #d946ef !important;
      }

      .eighties-active .control-button {
        border: 1px solid #d946ef !important;
        padding: 12px !important; /* Use same padding as base */
        min-height: 62px !important; /* Ensure override for consistency */
        box-shadow: 0 0 3px rgba(217, 70, 239, 0.3) !important;
        background-image: linear-gradient(
          to bottom,
          #0f172a,
          #2a1786
        ) !important;
        border-left: 1px solid #d946ef !important;
        border-right: 1px solid #d946ef !important;
        transition: all 0.3s;
      }

      .leaderboard-container {
        margin-top: 10px;
      }

      .leaderboard-header {
        width: 100%;
        background-color: #1f2937;
        border-radius: 4px;
        border: 1px solid #134e4a;
        padding: 4px;
        font-family: monospace;
        color: #22d3ee;
        font-size: 0.75rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 4px;
        cursor: pointer;
        box-shadow: 0 0 5px rgba(6, 182, 212, 0.2);
      }

      /* 3D glasses mode styles for video call */
      .threedy-mode .video-call {
        border-left: 1px solid #ff0040;
        border-right: 1px solid #00b4ff;
        box-shadow: -2px 0 5px rgba(255, 0, 64, 0.2),
          2px 0 5px rgba(0, 180, 255, 0.2);
      }

      .threedy-mode #station-display {
        position: relative;
        text-shadow: -1px 0 #ff0040, 1px 0 #00b4ff;
      }

      .threedy-mode .call-button {
        border-left: 1px solid #ff0040;
        border-right: 1px solid #00b4ff;
        box-shadow: -1px 0 3px rgba(255, 0, 64, 0.2),
          1px 0 3px rgba(0, 180, 255, 0.2);
        text-shadow: -1px 0 #ff0040, 1px 0 #00b4ff;
      }

      .threedy-mode .call-button:hover {
        box-shadow: -2px 0 5px rgba(255, 0, 64, 0.4),
          2px 0 5px rgba(0, 180, 255, 0.4);
      }

      .threedy-mode .call-button.disconnect {
        border-left: 1px solid #ff0040;
        border-right: 1px solid #00b4ff;
        text-shadow: -1px 0 #ff0040, 1px 0 #00b4ff;
      }

      .threedy-mode .station-select {
        border-left: 1px solid #ff0040;
        border-right: 1px solid #00b4ff;
        box-shadow: -1px 0 3px rgba(255, 0, 64, 0.2),
          1px 0 3px rgba(0, 180, 255, 0.2);
        text-shadow: -1px 0 #ff0040, 1px 0 #00b4ff;
      }

      .threedy-mode .station-select:hover {
        box-shadow: -2px 0 5px rgba(255, 0, 64, 0.4),
          2px 0 5px rgba(0, 180, 255, 0.4);
      }

      .threedy-mode .video-status.active {
        box-shadow: 0 0 5px #ef4444, -1px 0 5px #ff0040, 1px 0 5px #00b4ff;
      }

      /* 80s mode video call styles */
      .eighties-active .video-call {
        border: 1px solid #d946ef;
        background-color: #020617;
        box-shadow: 0 0 8px rgba(217, 70, 239, 0.3);
      }

      .eighties-active .video-header {
        background-color: #0f172a;
        border-bottom: 1px solid #d946ef;
        font-family: "Press Start 2P", cursive;
        font-size: 0.55rem;
        color: #22d3ee;
      }

      .eighties-active #station-display {
        color: #22d3ee;
        text-shadow: 0 0 3px #22d3ee;
        font-family: "Press Start 2P", cursive;
        font-size: 0.55rem;
      }

      .eighties-active .video-status.active {
        background-color: #ef4444;
        box-shadow: 0 0 5px #ef4444;
      }

      .eighties-active .video-controls {
        background-color: #0f172a;
        border-top: 1px solid #d946ef;
      }

      .eighties-active .call-button {
        font-family: "Press Start 2P", cursive;
        font-size: 0.55rem;
        background-color: #0f172a;
        border: 1px solid #d946ef;
        color: #22d3ee;
        box-shadow: 0 0 3px rgba(217, 70, 239, 0.4);
      }

      .eighties-active .call-button.disconnect {
        border-color: #ef4444;
        color: #ef4444;
        box-shadow: 0 0 3px rgba(239, 68, 68, 0.4);
      }

      .eighties-active .call-button:hover {
        background-color: #2a1786;
      }

      .eighties-active .station-select {
        font-family: "Press Start 2P", cursive;
        font-size: 0.55rem;
        background-color: #0f172a;
        border: 1px solid #d946ef;
        color: #22d3ee;
        box-shadow: 0 0 3px rgba(217, 70, 239, 0.4);
      }

      .eighties-active .station-select:hover {
        background-color: #2a1786;
      }

      /* Hide SitePal's default loading spinner */
      #sitepal-container .waiting_logo {
        display: none !important;
      }

      /* Styles for the Offline Display */
      #offline-display {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #111827; /* Equivalent to bg-gray-900 */
        color: #4b5563; /* Equivalent to text-gray-600 */
        font-size: 0.875rem; /* text-sm */
        font-family: monospace;
        z-index: 5; /* Below video during transition */
      }

      #offline-display .crosshair-h,
      #offline-display .crosshair-v {
        position: absolute;
        background-color: #374151; /* Equivalent to bg-gray-800 */
      }

      #offline-display .crosshair-h {
        width: 100%;
        height: 1px;
        top: 50%;
        left: 0;
      }

      #offline-display .crosshair-v {
        height: 100%;
        width: 1px;
        left: 50%;
        top: 0;
      }

      #offline-display .scanlines-overlay {
        position: absolute;
        inset: 0;
        background-image: repeating-linear-gradient(
          transparent,
          transparent 1px,
          rgba(6, 182, 212, 0.02) 1px,
          rgba(6, 182, 212, 0.02) 2px
        );
        background-size: 100% 2px;
        pointer-events: none;
      }
      /* End Offline Display Styles */

      /* Connect Button Pulse Animation */
      @keyframes connect-pulse {
        0% {
          box-shadow: 0 0 5px rgba(6, 182, 212, 0.3),
            0 0 8px rgba(34, 211, 238, 0.2);
          border-color: #134e4a;
        }
        50% {
          box-shadow: 0 0 10px rgba(6, 182, 212, 0.6),
            0 0 15px rgba(34, 211, 238, 0.4);
          border-color: #22d3ee;
        }
        100% {
          box-shadow: 0 0 5px rgba(6, 182, 212, 0.3),
            0 0 8px rgba(34, 211, 238, 0.2);
          border-color: #134e4a;
        }
      }

      .initial-pulse {
        animation: connect-pulse 1.5s infinite ease-in-out;
      }

      /* Signal button specific styles */
      .control-button[data-action="signal"].initial-pulse {
        border-color: #134e4a;
        background-color: #0f172a;
        box-shadow: 0 0 5px rgba(6, 182, 212, 0.3),
          0 0 8px rgba(34, 211, 238, 0.2);
      }

      .control-button[data-action="signal"].initial-pulse .button-indicator {
        background-color: #22d3ee;
        box-shadow: 0 0 5px rgba(34, 211, 238, 0.5);
      }
      /* End Signal button styles */

      /* Add UN-MUTE button style */
      .call-button.unmute {
        color: #22d3ee;
        border-color: #0e7490;
        box-shadow: 0 0 10px rgba(6, 182, 212, 0.5);
        animation: connect-pulse 1.5s infinite ease-in-out;
      }

      /* Update existing animation to pulse specifically designed for the UN-MUTE state */
      @keyframes connect-pulse {
        0% {
          box-shadow: 0 0 5px rgba(6, 182, 212, 0.3),
            0 0 8px rgba(34, 211, 238, 0.2);
          border-color: #134e4a;
        }
        50% {
          box-shadow: 0 0 10px rgba(6, 182, 212, 0.6),
            0 0 15px rgba(34, 211, 238, 0.4);
          border-color: #22d3ee;
        }
        100% {
          box-shadow: 0 0 5px rgba(6, 182, 212, 0.3),
            0 0 8px rgba(34, 211, 238, 0.2);
          border-color: #134e4a;
        }
      }

      /* 80s mode video call styles */
      .eighties-active .video-call {
        border: 1px solid #d946ef;
        background-color: #020617;
        box-shadow: 0 0 8px rgba(217, 70, 239, 0.3);
      }

      .eighties-active .video-header {
        background-color: #0f172a;
        border-bottom: 1px solid #d946ef;
        font-family: "Press Start 2P", cursive;
        font-size: 0.55rem;
        color: #22d3ee;
      }

      .eighties-active #station-display {
        color: #22d3ee;
        text-shadow: 0 0 3px #22d3ee;
        font-family: "Press Start 2P", cursive;
        font-size: 0.55rem;
      }

      .eighties-active .video-status.active {
        background-color: #ef4444;
        box-shadow: 0 0 5px #ef4444;
      }

      .eighties-active .video-controls {
        background-color: #0f172a;
        border-top: 1px solid #d946ef;
      }

      .eighties-active .call-button {
        font-family: "Press Start 2P", cursive;
        font-size: 0.55rem;
        background-color: #0f172a;
        border: 1px solid #d946ef;
        color: #22d3ee;
        box-shadow: 0 0 3px rgba(217, 70, 239, 0.4);
      }

      .eighties-active .call-button.unmute {
        border-color: #22d3ee;
        color: #d946ef;
        box-shadow: 0 0 8px rgba(34, 211, 238, 0.6);
        animation: eighties-pulse 1.5s infinite alternate;
      }

      @keyframes eighties-pulse {
        0% {
          box-shadow: 0 0 3px rgba(217, 70, 239, 0.4);
          border-color: #d946ef;
        }
        100% {
          box-shadow: 0 0 10px rgba(34, 211, 238, 0.7);
          border-color: #22d3ee;
        }
      }

      .eighties-active .call-button.disconnect {
        border-color: #ef4444;
        color: #ef4444;
        box-shadow: 0 0 3px rgba(239, 68, 68, 0.4);
      }

      .eighties-active .call-button:hover {
        background-color: #2a1786;
      }

      /* Add styles for the constellations toggle */
      .toggle-switch.constellations {
        background-color: #1e3a8a;
        /* Fixed: Use border shorthand */
        border: 1px solid #3b82f6;
      }

      .toggle-switch.constellations .toggle-handle {
        background-color: #93c5fd;
      }

      .toggle-switch.constellations.active {
        background-color: #1e40af;
        box-shadow: 0 0 15px rgba(59, 130, 246, 0.5);
      }

      .toggle-switch.constellations.active .toggle-handle {
        background-color: #bfdbfe;
        /* Add transform explicitly to increase specificity */
        transform: translateX(24px);
      }

      /* Update eighties mode styles to include constellations toggle */
      .eighties-active .toggle-switch.constellations {
        background-color: #581c87;
        border-color: #d946ef;
      }

      .eighties-active .toggle-switch.constellations .toggle-handle {
        background-color: #e879f9;
      }

      .eighties-active .toggle-switch.constellations.active {
        background-color: #6b21a8;
        box-shadow: 0 0 15px rgba(217, 70, 239, 0.5);
      }

      .eighties-active .toggle-switch.constellations.active .toggle-handle {
        background-color: #f0abfc;
      }

      /* Add responsive styles for small screens */
      @media (max-width: 480px) {
        /* Default collapsed height on mobile when inactive */
        .video-display:not(.active) {
          height: 40px;
        }

        /* When active, maintain original height */
        .video-display.active {
          height: 180px;
        }

        /* Add an indicator for the collapsed state */
        .video-display:not(.active)::after {
          content: "Tap to expand";
          position: absolute;
          top: 50%;
          left: 50%;
          transform: translate(-50%, -50%);
          color: #67e8f9;
          font-size: 0.75rem;
          text-shadow: 0 0 5px #06b6d4;
        }

        /* Add expand/collapse indicators */
        .video-display::before {
          content: "▼";
          position: absolute;
          right: 8px;
          top: 10px;
          color: #67e8f9;
          font-size: 0.7rem;
          opacity: 0.8;
          z-index: 20;
          pointer-events: none;
          transition: transform 0.3s;
        }

        .video-display.active::before {
          transform: rotate(180deg);
          top: 8px;
        }

        /* Add touch hint on first load */
        .video-display:not(.touched):not(.active)::after {
          animation: pulse 2s infinite;
        }

        /* Optimize spacing */
        .mission-control {
          padding: 12px 10px;
        }

        /* Reduce spacing between elements */
        .panel-header {
          min-height: 50px;
          height: 50px;
          max-height: 50px;
          margin-bottom: 12px;
          padding-bottom: 4px;
        }

        .video-call {
          margin-bottom: 12px;
        }

        /* Further optimize button grid */
        .button-grid {
          gap: 8px;
          margin-bottom: 12px;
        }

        /* Make buttons significantly smaller and more compact */
        .control-button {
          padding: 6px 4px;
          min-height: 48px;
        }

        .button-prefix {
          font-size: 0.65rem;
          margin-bottom: 2px;
        }

        .button-label {
          font-size: 0.8rem;
        }

        .button-indicator {
          width: 24px;
          height: 3px;
          margin-top: 3px;
        }

        /* Make toggle sections more compact */
        .toggle-section {
          padding: 8px;
          margin-bottom: 12px;
        }

        /* Style the inline toggle groups - two lines for full-size screens */
        .toggle-row.mobile-inline {
          display: flex;
          flex-wrap: wrap;
          justify-content: space-between;
          gap: 20px;
          margin-bottom: 0;
        }

        .toggle-group {
          display: flex;
          align-items: center;
          justify-content: center;
          width: 45%;
          margin-bottom: 10px;
        }

        .toggle-group:nth-child(3) {
          width: 90%;
          margin-bottom: 0;
        }

        .toggle-label {
          font-size: 0.75rem;
          margin-right: 8px;
          white-space: nowrap;
          text-align: center;
        }

        .toggle-switch {
          width: 42px;
          height: 22px;
        }

        .toggle-handle {
          width: 18px;
          height: 18px;
        }

        /* Mobile adjustments */
        @media (max-width: 767px) {
          .toggle-row.mobile-inline {
            flex-wrap: nowrap;
            gap: 0;
          }

          .toggle-group {
            width: 33%;
            margin-bottom: 0;
          }

          .toggle-group:nth-child(3) {
            width: 33%;
          }

          .toggle-label {
            font-size: 0.65rem;
            margin-right: 4px;
          }

          .toggle-switch {
            width: 36px;
            height: 20px;
          }

          .toggle-handle {
            width: 16px;
            height: 16px;
          }
        }
      }

      /* Extra small screens */
      @media (max-width: 360px) {
        /* Make video even smaller when active on very small screens */
        .video-display.active {
          height: 150px;
        }

        /* Reduce padding further */
        .mission-control {
          padding: 8px 6px;
        }

        /* Make grid buttons even more compact */
        .button-grid {
          gap: 6px;
        }

        .control-button {
          padding: 4px;
          min-height: 44px;
        }

        .button-prefix {
          font-size: 0.6rem;
          margin-bottom: 1px;
        }

        .button-label {
          font-size: 0.75rem;
          letter-spacing: 0.05em;
        }

        .button-indicator {
          width: 20px;
          height: 2px;
          margin-top: 2px;
        }

        /* Further reduce toggle spacing */
        .toggle-section {
          padding: 6px;
          margin-bottom: 8px;
        }

        .toggle-row {
          margin-bottom: 6px;
        }

        .toggle-label {
          font-size: 0.75rem;
        }

        /* Even more compact toggles for very small screens */
        .toggle-group .toggle-label {
          font-size: 0.6rem;
          margin-right: 2px;
        }

        .toggle-group .toggle-switch {
          width: 30px;
          height: 16px;
        }

        .toggle-group .toggle-handle {
          width: 12px;
          height: 12px;
          top: 2px;
        }

        .toggle-group .toggle-switch.active .toggle-handle {
          transform: translateX(14px);
        }

        /* Smaller toggle switches */
        .toggle-switch {
          width: 42px;
          height: 20px;
        }

        .toggle-switch .toggle-handle {
          width: 16px;
          height: 16px;
          top: 2px;
        }

        .toggle-switch.active .toggle-handle {
          transform: translateX(20px);
        }

        /* Even smaller leaderboard */
        .leaderboard-scrollable {
          height: 90px;
        }
      }

      /* Full-screen mode adjustments for toggle buttons */
      @media (min-width: 768px) {
        .toggle-row.mobile-inline {
          flex-wrap: wrap;
          justify-content: space-around;
          padding: 10px 0;
        }

        .toggle-group {
          width: 45%;
          margin-bottom: 15px;
          justify-content: center;
        }

        .toggle-group:nth-child(2) {
          left: 0;
          position: static;
        }

        .toggle-group:nth-child(3) {
          width: 90%;
          justify-content: center;
        }

        .toggle-group .toggle-label {
          font-size: 0.75rem;
          margin-right: 8px;
        }

        .toggle-group .toggle-switch {
          width: 42px;
          height: 22px;
        }

        .toggle-group .toggle-handle {
          width: 18px;
          height: 18px;
        }
      }

      /* Transcript section styles */
      .transcript-container {
        width: 100%;
        max-width: 450px;
        background: #0f172a;
        border: 1px solid #134e4a;
        border-radius: 4px;
        overflow: hidden;
        margin-bottom: 16px;
        transition: all 0.3s ease;
        position: relative;
      }

      .transcript-toggle-btn {
        position: relative;
        background: #1f2937;
        color: #67e8f9;
        border: 1px solid #134e4a;
        border-radius: 4px;
        width: auto;
        height: auto;
        padding: 4px 8px;
        font-size: 0.75rem;
        font-family: monospace;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        z-index: 101;
        transition: all 0.3s ease;
      }

      .transcript-toggle-btn:hover {
        background: #374151;
        box-shadow: 0 0 5px rgba(6, 182, 212, 0.5);
      }

      .transcript-toggle-btn.active {
        color: #f87171;
        border-color: #7f1d1d;
        box-shadow: 0 0 5px rgba(220, 38, 38, 0.3);
      }

      .transcript-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 6px 10px;
        background-color: #1f2937;
        border-bottom: 1px solid #134e4a;
        cursor: pointer;
      }

      .transcript-title {
        font-size: 0.75rem;
        margin: 0;
        color: #67e8f9;
      }

      .language-selector {
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .language-selector select {
        background-color: #1f2937;
        color: #22d3ee;
        font-size: 0.75rem;
        font-family: monospace;
        padding: 2px 4px;
        border: 1px solid #134e4a;
        border-radius: 4px;
        cursor: pointer;
      }

      .transcript-content {
        padding: 8px 10px;
        max-height: 120px;
        overflow-y: auto;
        line-height: 1.5;
        font-size: 0.75rem;
        transition: max-height 0.3s ease, padding 0.3s ease;
      }

      .transcript-content.collapsed {
        max-height: 0;
        padding-top: 0;
        padding-bottom: 0;
        overflow: hidden;
      }

      .transcript-segment {
        padding: 3px 0;
        transition: background-color 0.3s ease;
      }

      .transcript-segment.active {
        background-color: rgba(6, 182, 212, 0.1);
        border-left: 2px solid #06b6d4;
        padding-left: 8px;
        margin-left: -8px;
      }

      /* Hide scrollbar for Chrome, Safari and Opera */
      .transcript-content::-webkit-scrollbar {
        width: 4px;
      }

      .transcript-content::-webkit-scrollbar-track {
        background: #1f2937;
      }

      .transcript-content::-webkit-scrollbar-thumb {
        background: #134e4a;
        border-radius: 2px;
      }

      /* Transcript toggle icon animation */
      .transcript-expand-icon {
        transition: transform 0.3s ease;
      }

      .transcript-expand-icon.collapsed {
        transform: rotate(-90deg);
      }

      /* 80s mode transcript styles */
      .eighties-active .transcript-container {
        border-color: #d946ef;
        box-shadow: 0 0 8px rgba(217, 70, 239, 0.3);
      }

      .eighties-active .transcript-header {
        background-color: #0f172a;
        border-bottom: 1px solid #d946ef;
      }

      .eighties-active .transcript-title,
      .eighties-active .language-selector select {
        font-family: "Press Start 2P", cursive;
        font-size: 0.55rem;
      }

      .eighties-active .transcript-content {
        font-family: "Press Start 2P", cursive;
        font-size: 0.55rem;
        line-height: 1.8;
      }

      .eighties-active .transcript-segment.active {
        background-color: rgba(217, 70, 239, 0.1);
        border-left: 2px solid #d946ef;
      }

      .eighties-active .transcript-toggle-btn {
        font-family: "Press Start 2P", cursive;
        font-size: 0.55rem;
        background-color: #0f172a;
        border: 1px solid #d946ef;
        color: #22d3ee;
        box-shadow: 0 0 3px rgba(217, 70, 239, 0.4);
      }

      .eighties-active .transcript-toggle-btn:hover {
        background-color: #2a1786;
      }

      .eighties-active .transcript-toggle-btn.active {
        border-color: #22d3ee;
        color: #d946ef;
        box-shadow: 0 0 8px rgba(34, 211, 238, 0.6);
      }

      /* 3D mode transcript styles */
      .threedy-mode .transcript-container {
        border-left: 1px solid #ff0040;
        border-right: 1px solid #00b4ff;
        box-shadow: -2px 0 5px rgba(255, 0, 64, 0.2),
          2px 0 5px rgba(0, 180, 255, 0.2);
      }

      .threedy-mode .transcript-title,
      .threedy-mode .language-selector select {
        text-shadow: -1px 0 #ff0040, 1px 0 #00b4ff;
      }

      .threedy-mode .transcript-toggle-btn {
        border-left: 1px solid #ff0040;
        border-right: 1px solid #00b4ff;
        box-shadow: -1px 0 3px rgba(255, 0, 64, 0.2),
          1px 0 3px rgba(0, 180, 255, 0.2);
        text-shadow: -1px 0 #ff0040, 1px 0 #00b4ff;
      }

      .threedy-mode .transcript-toggle-btn:hover {
        box-shadow: -2px 0 5px rgba(255, 0, 64, 0.4),
          2px 0 5px rgba(0, 180, 255, 0.4);
      }

      /* Mobile-specific adjustments */
      @media (max-width: 480px) {
        /* Ensure transcript container takes up space */
        .transcript-container {
          min-height: 180px; /* Adjust as needed, should be >= header + content height */
          margin-bottom: 12px;
        }

        .transcript-content {
          max-height: 150px !important; /* Increased height and ensure override */
          font-size: 0.75rem; /* Slightly larger font */
        }
        
        .language-selector select {
          font-size: 0.75rem; /* Slightly larger font */
          padding: 4px 6px;  /* Increased padding for easier tapping */
          min-width: 80px; /* Ensure minimum width */
        }
        
        /* Further reduce transcript font size in 80s mode on mobile */
        .eighties-active .transcript-title,
        .eighties-active .language-selector select,
        .eighties-active .transcript-content {
          font-size: 0.55rem; 
        }
      }

      /* Keep button-prefix smaller in 80s mode with higher specificity */
      .mission-control.eighties-active .button-prefix {
        font-family: "Press Start 2P", cursive !important;
        font-size: 0.5rem !important;
        line-height: 1.3 !important;
        opacity: 0.8 !important;
        text-shadow: 0 0 3px #d946ef !important;
        letter-spacing: 0 !important;
      }

      /* Medium and larger screens - leaderboard expanded by default */
      @media (min-width: 768px) {
        #leaderboard-content {
          display: block !important;
        }
      }

      /* Mobile-specific adjustments */

      /* By default, leaderboard is displayed */
      #leaderboard-content {
        display: block;
      }
      
      /* Only hide on mobile screens */
      @media (max-width: 767px) {
        #leaderboard-content {
          display: none;
        }
        
        /* Arrow points down when collapsed */
        #leaderboard-arrow {
          content: "▼";
        }
      }

      /* Stronger pulsing effect for SIGNAL button */
      @keyframes signal-pulse {
        0% {
          box-shadow: 0 0 5px rgba(6, 182, 212, 0.3), 0 0 8px rgba(34, 211, 238, 0.2);
          border-color: #134e4a;
          transform: scale(1);
        }
        50% {
          box-shadow: 0 0 15px rgba(6, 182, 212, 0.7), 0 0 20px rgba(34, 211, 238, 0.5);
          border-color: #22d3ee;
          transform: scale(1.03);
        }
        100% {
          box-shadow: 0 0 5px rgba(6, 182, 212, 0.3), 0 0 8px rgba(34, 211, 238, 0.2);
          border-color: #134e4a;
          transform: scale(1);
        }
      }

      /* Pulsing effect for transcript CC button */
      @keyframes cc-pulse {
        0% {
          box-shadow: 0 0 3px rgba(6, 182, 212, 0.2);
          transform: scale(1);
        }
        50% {
          box-shadow: 0 0 10px rgba(6, 182, 212, 0.6);
          transform: scale(1.1);
        }
        100% {
          box-shadow: 0 0 3px rgba(6, 182, 212, 0.2);
          transform: scale(1);
        }
      }

      .control-button[data-action="signal"].initial-pulse {
        animation: signal-pulse 1.5s infinite ease-in-out;
      }

      .transcript-toggle-btn.pulse-attention {
        animation: cc-pulse 1.5s infinite ease-in-out;
      }

      /* Loading indicator styles */
      .video-loading-indicator {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 55;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #67e8f9;
        font-family: monospace;
        text-align: center;
      }

      .loading-spinner {
        width: 40px;
        height: 40px;
        border: 3px solid rgba(6, 182, 212, 0.3);
        border-radius: 50%;
        border-top-color: #67e8f9;
        animation: spin 1s linear infinite;
        margin-bottom: 10px;
      }

      @keyframes spin {
        to { transform: rotate(360deg); }
      }

      /* Disabled toggle styles */
      .toggle-switch.disabled {
        opacity: 0.5;
        cursor: not-allowed;
        pointer-events: none;
      }

      .toggle-label.disabled {
        opacity: 0.5;
      }

      /* Add stronger UN-MUTE button pulse animation */
      @keyframes connect-pulse {
        0% {
          box-shadow: 0 0 5px rgba(6, 182, 212, 0.3),
            0 0 8px rgba(34, 211, 238, 0.2);
          border-color: #134e4a;
          transform: scale(1);
        }
        50% {
          box-shadow: 0 0 15px rgba(6, 182, 212, 0.8),
            0 0 20px rgba(34, 211, 238, 0.6);
          border-color: #22d3ee;
          transform: scale(1.05);
        }
        100% {
          box-shadow: 0 0 5px rgba(6, 182, 212, 0.3),
            0 0 8px rgba(34, 211, 238, 0.2);
          border-color: #134e4a;
          transform: scale(1);
        }
      }

      /* Enhance the 80s mode UN-MUTE button animation */
      @keyframes eighties-pulse {
        0% {
          box-shadow: 0 0 3px rgba(217, 70, 239, 0.4);
          border-color: #d946ef;
          transform: scale(1);
        }
        100% {
          box-shadow: 0 0 15px rgba(34, 211, 238, 0.9);
          border-color: #22d3ee;
          transform: scale(1.08);
        }
      }

      /* Add text contrast to make UN-MUTE more visible */
      .call-button.unmute {
        color: #22d3ee;
        border-color: #0e7490;
        box-shadow: 0 0 10px rgba(6, 182, 212, 0.5);
        animation: connect-pulse 1.2s infinite ease-in-out; /* Faster animation (1.2s instead of 1.5s) */
        font-weight: bold; /* Make text bolder */
        text-shadow: 0 0 5px rgba(34, 211, 238, 0.7); /* Add glow to text */
      }

      /* Enhance 80s mode unmute button */
      .eighties-active .call-button.unmute {
        border-color: #22d3ee;
        color: #d946ef;
        box-shadow: 0 0 8px rgba(34, 211, 238, 0.6);
        animation: eighties-pulse 1.2s infinite alternate;
        font-weight: bold;
        text-shadow: 0 0 8px rgba(217, 70, 239, 0.9);
      }
    </style>
  </head>
  <body onload="if(window.innerWidth >= 768) { document.getElementById('leaderboard-content').style.display = 'block'; document.getElementById('leaderboard-arrow').textContent = '▲'; }">
    <div class="scan-lines" id="scan-lines"></div>
    <div class="color-shift color-shift-red" id="color-shift-red"></div>
    <div class="color-shift color-shift-blue" id="color-shift-blue"></div>

    <div class="mission-control" id="mission-control">
      <div class="threedy-shadow-red" id="threedy-shadow-red"></div>
      <div class="threedy-shadow-blue" id="threedy-shadow-blue"></div>
      <div class="panel-header">
        <h1 class="panel-title">INFIN8O-LUNAR</h1>
        <div class="panel-subtitle">MISSION CONTROL v2.0.80</div>
      </div>

      <!-- Video Call Section -->
      <div class="video-call">
        <div class="video-header">
          <span id="station-display">COMM:/lunar_base_alpha</span>
          <div id="call-status" class="video-status"></div>
        </div>

        <div class="video-display">
          <div id="video-feed" class="video-feed">
            <video
              id="deadAir"
              loop
              muted
              playsinline
              webkit-playsinline
              style="width: 100%; height: 100%; object-fit: cover"
            >
              <source src="/1.mp4" type="video/mp4" />
            </video>
            <!-- Add Offline Display -->
            <div id="offline-display">
              <span>SYS//OFFLINE</span>
              <div class="crosshair-h"></div>
              <div class="crosshair-v"></div>
              <div class="scanlines-overlay"></div>
            </div>
            <div
              id="sitepal-container"
              style="
                display: none;
                width: 100%;
                height: 100%;
                -webkit-overflow-scrolling: touch;
              "
            >
              <!-- </script> -->
              <script
                type="text/javascript"
                src="//vhss-d.oddcast.com/ai_embed_functions_v1.php"
              ></script>
              <script type="text/javascript">
                function initSitePal() {
                  const container =
                    document.getElementById("sitepal-container");
                  const deadAir = document.getElementById("deadAir");

                  if (container) {
                    container.innerHTML = '<div id="vhss_aiPlayer"></div>';
                    container.style.display = "block";
                  }

                  function embedNow() {
                    // Handle the scene loaded event - make sure character is visible
                    const handleSceneLoaded = () => {
                      console.log("✅ SitePal scene loaded callback triggered");

                      // Hide the transmission video effect
                      if (deadAir) {
                        deadAir.style.opacity = 0;
                        deadAir.style.zIndex = "5"; // Lower z-index once loading is complete
                        setTimeout(() => deadAir.pause(), 500);
                      }

                      // Ensure SitePal container is visible and has active class
                      if (container) {
                        container.style.display = "block";
                        container.classList.add("active");
                        container.style.zIndex = "30"; // Explicitly set high z-index when loaded

                        // Also set z-index for the vhss_aiPlayer element
                        const playerDiv =
                          document.getElementById("vhss_aiPlayer");
                        if (playerDiv) {
                          playerDiv.style.zIndex = "25";
                        }
                      }

                      // Make SitePal APIs available on window object for easier access
                      // but don't prime audio or start listening yet - wait for UN-MUTE
                      if (
                        typeof saySilent === "function" &&
                        !window.saySilent
                      ) {
                        window.saySilent = saySilent;
                        console.log("✅ Made saySilent available on window");
                      }

                      if (typeof sayText === "function" && !window.sayText) {
                        window.sayText = sayText;
                        console.log("✅ Made sayText available on window");
                      }

                      if (
                        typeof AI_vhost_api === "function" &&
                        !window.AI_vhost_api
                      ) {
                        window.AI_vhost_api = AI_vhost_api;
                        console.log("✅ Made AI_vhost_api available on window");
                      }

                      // Request microphone permission during CONNECT to avoid interruption during the greeting
                      requestMicrophonePermission();

                      // DO NOT prime audio or activate mic here - wait for UN-MUTE button
                      console.log(
                        "⏸️ Waiting for UN-MUTE before activating audio"
                      );
                    };

                    // Function to request microphone permissions ahead of time
                    function requestMicrophonePermission() {
                      console.log(
                        "🎤 Requesting microphone permission during CONNECT phase..."
                      );
                      try {
                        // Use the browser's getUserMedia API to request microphone access
                        if (
                          navigator.mediaDevices &&
                          navigator.mediaDevices.getUserMedia
                        ) {
                          navigator.mediaDevices
                            .getUserMedia({ audio: true })
                            .then((stream) => {
                              console.log("✅ Microphone permission granted");
                              // Stop all tracks to release the microphone - we're just getting permission
                              stream
                                .getTracks()
                                .forEach((track) => track.stop());
                            })
                            .catch((err) => {
                              console.warn(
                                "⚠️ Microphone permission denied or error:",
                                err
                              );
                            });
                        } else {
                          console.warn(
                            "⚠️ getUserMedia not supported in this browser"
                          );
                        }
                      } catch (e) {
                        console.error(
                          "❌ Error requesting microphone permission:",
                          e
                        );
                      }
                    }

                    // Set both callback names that SitePal might use
                    window.vh_sceneLoaded = handleSceneLoaded;
                    window.vhss_sceneLoaded = handleSceneLoaded;

                    // Add a backup timeout in case callbacks don't fire
                    setTimeout(() => {
                      console.log(
                        "⏱️ Checking if SitePal character is visible..."
                      );
                      if (
                        container &&
                        !container.classList.contains("active")
                      ) {
                        console.log(
                          "⚠️ Character not visible, forcing display"
                        );
                        handleSceneLoaded();

                        // Check if vhss_aiPlayer is actually visible
                        const playerDiv =
                          document.getElementById("vhss_aiPlayer");
                        if (playerDiv && playerDiv.innerHTML === "") {
                          console.log(
                            "⚠️ SitePal player appears empty, trying to reload..."
                          );

                          // Try embedding again
                          try {
                            playerDiv.innerHTML = "";
                            AI_vhost_embed(280, 180, 9157686, 255, 0, 1);
                            console.log(
                              "🔄 Attempted to reload SitePal character"
                            );
                          } catch (e) {
                            console.error("❌ Error reloading SitePal:", e);
                          }
                        }
                      }
                    }, 5000);

                    console.log("📱 Calling AI_vhost_embed to load SitePal...");
                    AI_vhost_embed(280, 180, 9157686, 255, 0, 1);
                  }

                  // Set up a backup timeout in case scene loaded doesn't fire
                  const sceneLoadTimeout = setTimeout(() => {
                    console.log("⚠️ Scene load timeout - backup transition");
                    if (deadAir) {
                      deadAir.style.opacity = 0;
                      setTimeout(() => deadAir.pause(), 500);
                    }
                    if (container) {
                      container.style.display = "block";
                      container.style.opacity = "1";
                    }
                    // Try to make SitePal APIs available
                    setupSitePalAPIs();
                  }, 8000); // 8-second backup

                  function setupSitePalAPIs() {
                    console.log("Setting up SitePal APIs on window...");
                    // Make SitePal APIs available on window object for easier access
                    if (typeof saySilent === "function" && !window.saySilent) {
                      window.saySilent = saySilent;
                      console.log("✅ Made saySilent available on window");
                    }

                    if (typeof sayText === "function" && !window.sayText) {
                      window.sayText = sayText;
                      console.log("✅ Made sayText available on window");
                    }

                    if (
                      typeof AI_vhost_api === "function" &&
                      !window.AI_vhost_api
                    ) {
                      window.AI_vhost_api = AI_vhost_api;
                      console.log("✅ Made AI_vhost_api available on window");
                    }

                    // Prime audio with saySilent but don't play greeting or start listening yet
                    setTimeout(() => {
                      console.log("🔇 Priming audio with saySilent(0)...");
                      try {
                        if (typeof saySilent === "function") {
                          saySilent(0);
                          console.log("✅ Initial audio priming complete");
                        } else {
                          console.warn(
                            "⚠️ saySilent not available for initial priming"
                          );
                        }
                      } catch (e) {
                        console.error("❌ Error during initial priming:", e);
                      }
                    }, 300);
                  }

                  if (typeof AI_vhost_embed !== "function") {
                    console.log("Loading SitePal scripts...");
                    const script = document.createElement("script");
                    script.src =
                      "//vhss-d.oddcast.com/vhost_embed_functions_v4.php?acc=9157686&js=1";
                    script.onload = () => {
                      console.log("✅ SitePal script loaded successfully");
                      embedNow();
                    };
                    script.onerror = (e) => {
                      console.error("❌ Failed to load SitePal script:", e);
                    };
                    document.head.appendChild(script);
                  } else {
                    console.log("SitePal script already loaded, embedding now");
                    embedNow();
                  }

                  // Add a button to request microphone access if not already present
                  const micButton = document.createElement("button");
                  micButton.innerText = "Enable Microphone";
                  micButton.onclick = () => {
                    // Combine microphone permission request and audio context resumption
                    requestMicrophonePermissionAndResume();
                  };
                  container.appendChild(micButton); // Append the button to the container

                  // Function to request microphone permissions and resume audio context
                  function requestMicrophonePermissionAndResume() {
                    displayMessage("🎤 Requesting microphone permission...");
                    try {
                      if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
                        navigator.mediaDevices.getUserMedia({ audio: true })
                          .then((stream) => {
                            displayMessage("✅ Microphone permission granted");
                            // Stop all tracks to release the microphone
                            stream.getTracks().forEach((track) => track.stop());
                            resumeAudioContext(); // Resume audio context after permission is granted
                            // Now, you can call the function to start listening or interacting with the character
                            startCharacterInteraction(); // New function to handle character interaction
                          })
                          .catch((err) => {
                            displayMessage("⚠️ Microphone permission denied or error: " + err);
                          });
                      } else {
                        displayMessage("⚠️ getUserMedia not supported in this browser");
                      }
                    } catch (e) {
                      displayMessage("❌ Error requesting microphone permission: " + e);
                    }
                  }

                  // Function to start character interaction
                  function startCharacterInteraction() {
                    // Call the SitePal API to start listening or interacting with the character
                    if (typeof startListening === "function") {
                      startListening(); // Assuming this is the function to start interaction
                      displayMessage("🎤 Character is now listening...");
                    } else {
                      displayMessage("⚠️ startListening function not available.");
                    }
                  }

                  // Function to resume the audio context
                  function resumeAudioContext() {
                    if (typeof AudioContext !== "undefined") {
                      const audioContext = new (window.AudioContext || window.webkitAudioContext)();
                      audioContext.resume().then(() => {
                        displayMessage("✅ Audio context resumed");
                      }).catch(err => {
                        displayMessage("⚠️ Failed to resume audio context: " + err);
                      });
                    }
                  }

                  // Function to display messages on the webpage
                  function displayMessage(message) {
                    const messageDiv = document.createElement("div");
                    messageDiv.innerText = message;
                    messageDiv.style.position = "fixed";
                    messageDiv.style.bottom = "10px";
                    messageDiv.style.left = "10px";
                    messageDiv.style.backgroundColor = "white";
                    messageDiv.style.padding = "10px";
                    messageDiv.style.border = "1px solid black";
                    document.body.appendChild(messageDiv);
                  }
                }
              </script>
              <script>
                const connectButton = document.getElementById("call-button");
                if (connectButton) {
                  connectButton.addEventListener("click", () => {
        
                    loadAndPrimeCharacter(); // Load and prime the character
                  });
                }
              </script>
              <div id="vhss_aiPlayer"></div>
              <!-- Add placeholder elements that SitePal expects -->
              <div id="vhss-aiplayer-aiformlogs"></div>
              <div id="vhss-aiplayer-aiformtranscript"></div>
              <div id="vhss-aiplayer-aiformstatus"></div>
              <div id="vhss-aiplayer-aiformerror"></div>
              <!-- Add the actual mic button class that SitePal uses -->
              <div
                class="vhss-aiplayer-mic-p3"
                id="vhss-aiplayer-mic-p3"
                style="display: none"
              ></div>
            </div>
          </div>
          <div class="video-overlay"></div>
          <div id="self-view" class="self-view" style="display: none"></div>
          <div id="live-indicator" class="live-indicator" style="display: none">
            LIVE//REC
          </div>
          <div class="video-gradient"></div>
        </div>

        <div class="video-controls">
          <button id="call-button" class="call-button">CONNECT</button>
          <select id="station-select" class="station-select">
            <option>LUNAR BASE ALPHA</option>
            <option>MARS OUTPOST</option>
            <option>ORBITAL STATION</option>
            <option>EARTH HQ</option>
          </select>
          <button class="transcript-toggle-btn" id="transcript-toggle-btn" style="display: none;">CC</button>
        </div>
      </div>

      <!-- Transcript Section - Added below video call but above button grid -->
      <div class="transcript-container" id="transcript-container" style="display: none;">
        <div class="transcript-header" id="transcript-header">
          <h3 class="transcript-title">Video Transcript</h3>
          <div class="language-selector">
            <select id="language-select">
              <option value="en">English</option>
              <option value="es">Español</option>
              <option value="fr">Français</option>
              <option value="de">Deutsch</option>
              <option value="ja">日本語</option>
              <option value="zh">中文</option>
              <option value="ko">한국어</option>
              <option value="pt">Português</option>
              <option value="ru">Русский</option>
              <option value="hi">हिंदी</option>
              <option value="ar">العربية</option>
              <option value="vi">Tiếng Việt</option>
            </select>
            <span class="transcript-expand-icon">▼</span>
          </div>
        </div>
        <div class="transcript-content" id="transcript-content">
          <!-- Transcript content will be populated dynamically via JavaScript -->
        </div>
      </div>

      <!-- Button Grid -->
      <div class="button-grid">
        <button class="control-button" data-action="signal">
          <span class="button-prefix">//COM</span>
          <span class="button-label">START HERE</span>
          <div class="button-indicator"></div>
        </button>

        <button class="control-button" data-action="ignition">
          <span class="button-prefix">//PRE-FLIGHT</span>
          <span class="button-label">IGNITION</span>
          <div class="button-indicator"></div>
        </button>

        <button class="control-button" data-action="launch">
          <span class="button-prefix">//SYS</span>
          <span class="button-label">LAUNCH</span>
          <div class="button-indicator"></div>
        </button>

        <button class="control-button" data-action="return">
          <span class="button-prefix">//HOME</span>
          <span class="button-label">EMERGENCY <br />EXIT</span>
          <div class="button-indicator"></div>
        </button>
      </div>

      <!-- Toggle Switches -->
      <div class="toggle-section">
        <div class="toggle-row mobile-inline">
          <div class="toggle-group music-group">
            <span class="toggle-label">MUSIC</span>
            <div id="music-toggle" class="toggle-switch music">
              <div class="toggle-handle"></div>
            </div>
          </div>
          <div class="toggle-group">
            <span class="toggle-label">80s <br />MODE</span>
            <div id="eighties-toggle" class="toggle-switch eighties">
              <div class="toggle-handle"></div>
            </div>
          </div>
          <div class="toggle-group">
            <span class="toggle-label">STAR <br />CHART</span>
            <div id="constellation-toggle" class="toggle-switch eighties">
              <div class="toggle-handle"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Remove Stereo Component -->
      <div class="collapsible-leaderboard">
        <!-- Collapsible Leaderboard -->
        <div class="leaderboard-container">
          <button id="leaderboard-toggle" class="leaderboard-header">
            <span>L34D3RBOARD//v1.2</span>
            <span id="leaderboard-arrow">▲</span>
          </button>

          <div
            id="leaderboard-content"
            class="leaderboard-content"
          >
            <div class="leaderboard-header-row">
              <span>USER_ID</span>
              <span>SCR_PTS</span>
            </div>

            <div class="leaderboard-scrollable">
              <div class="leaderboard-entry top">
                <span>Armstrong</span>
                <span>1969</span>
              </div>
              <div class="leaderboard-entry">
                <span>Aldrin</span>
                <span>1890</span>
              </div>
              <div class="leaderboard-entry">
                <span>Collins</span>
                <span>1850</span>
              </div>
              <div class="leaderboard-entry">
                <span>Lovell</span>
                <span>1800</span>
              </div>
              <div class="leaderboard-entry">
                <span>Cernan</span>
                <span>1750</span>
              </div>
            </div>

            <div class="leaderboard-footer">
              <div class="pulse-dot"></div>
              <span>LIVE_DATA//STREAM</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Status Bar -->
      <div class="status-bar">
        <div class="status-indicator">
          <div id="system-status" class="status-light active"></div>
          <span class="status-label">STATUS//OK</span>
          <span
            class="blinking-cursor"
            id="blinking-cursor"
            style="display: none"
          ></span>
        </div>
        <div class="version-info">CYBERCORE_80</div>
      </div>
    </div>

    <!-- Add script for constellation toggle -->
    <!-- <script src="constellation-toggle.js"></script> -->

    <script>
      // Initialize variables for DOM elements
      const videoDisplay = document.querySelector(".video-display");
      const toggleBtn = document.getElementById("toggle-btn");
      const resetBtn = document.getElementById("reset-btn");
      const status = document.getElementById("status");
      const callButton = document.getElementById("call-button");
      const callStatus = document.getElementById("call-status");
      const videoFeed = document.getElementById("video-feed");
      const selfView = document.getElementById("self-view");
      const liveIndicator = document.getElementById("live-indicator");
      const stationSelect = document.getElementById("station-select");
      const stationDisplay = document.getElementById("station-display");
      const eightiesToggle = document.getElementById("eighties-toggle");
      const constellationToggle = document.getElementById(
        "constellation-toggle"
      );
      const musicToggle = document.getElementById("music-toggle");
      const stereoPower = document.getElementById("stereo-power");
      const stereoNext = document.getElementById("stereo-next");
      const stereoPrev = document.getElementById("stereo-prev");
      const stereoPlayPause = document.getElementById("stereo-play-pause");

      const stereoInfo = document.getElementById("stereo-info");
      const systemStatus = document.getElementById("system-status");

      const leaderboardContent = document.getElementById("leaderboard-content");
      const leaderboardArrow = document.getElementById("leaderboard-arrow");
      const controlButtons = document.querySelectorAll(".control-button");

      // Set initial leaderboard state based on screen size
      let isLeaderboardExpanded = true; // Always expanded by default
      if (window.innerWidth < 768) {
        isLeaderboardExpanded = false; // Only collapsed on mobile
        if (leaderboardArrow) leaderboardArrow.textContent = "▼";
        if (leaderboardContent) leaderboardContent.style.display = "none";
      }

      // Helper function to load scripts
      function loadScript(src) {
        return new Promise((resolve, reject) => {
          const script = document.createElement("script");
          script.src = src;
          script.onload = resolve;
          script.onerror = reject;
          document.head.appendChild(script);
        });
      }

      // State
      let isCallActive = false;
      let isEightiesMode = false;
      let isOrientationComplete = false; // Track if orientation video has completed

      // Music toggle starts off by default
      musicToggle.classList.remove("active");

      function playClickSound() {
        try {
          const audioContext = new (window.AudioContext ||
            window.webkitAudioContext)();
          const oscillator = audioContext.createOscillator();
          const gainNode = audioContext.createGain();
          oscillator.type = "sine";
          oscillator.frequency.setValueAtTime(880, audioContext.currentTime); // A5
          gainNode.gain.setValueAtTime(0.1, audioContext.currentTime);
          gainNode.gain.exponentialRampToValueAtTime(
            0.01,
            audioContext.currentTime + 0.1
          );
          oscillator.connect(gainNode);
          gainNode.connect(audioContext.destination);
          oscillator.start();
          oscillator.stop(audioContext.currentTime + 0.1);
        } catch (e) {
          console.log("Audio context error:", e);
        }
      }

      // Add iOS detection
      const isIOS =
        /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;
      const browserIsSafari = /^((?!chrome|android).)*safari/i.test(
        navigator.userAgent
      );

    

      // Handle initial video playback for iOS
      document.addEventListener("DOMContentLoaded", () => {
        const deadAir = document.getElementById("deadAir");
        const offlineDisplay = document.getElementById("offline-display");
        const callButton = document.getElementById("call-button"); // Get call button

        offlineDisplay.style.display = "flex"; // Show offline state
        deadAir.style.display = "none"; // Hide video initially
        deadAir.pause(); // Ensure video is paused initially

        // Special handling for iOS
        if (isIOS || browserIsSafari) {
    

          // Add a click handler to the whole document to initialize audio on iOS
          document.addEventListener(
            "click",
            function iosAudioInit() {

              deadAir
                .play()
                .catch((e) => console.log("iOS initial play rejected:", e));

              // Try to prime the audio early
              try {
                if (typeof saySilent === "function") {
                  saySilent(0);
                }
              } catch (e) {
                console.log("Early audio priming failed:", e);
              }

              // Remove the listener after first click
              document.removeEventListener("click", iosAudioInit);
            },
            { once: true }
          );

          // For iOS we need to specially handle the call button click
          callButton.addEventListener(
            "click",
            function (e) {


              // If we're connecting, make sure we always show the UN-MUTE button
              if (!isCallActive) {
                window.forceUnmuteOnIOS = true;

                // Create a temporary audio context to help initialize audio system
                try {
                  const tempContext = new (window.AudioContext ||
                    window.webkitAudioContext)();
        

                  // Create and play a brief silent sound
                  const oscillator = tempContext.createOscillator();
                  const gainNode = tempContext.createGain();
                  gainNode.gain.value = 0.0001; // Nearly silent
                  oscillator.connect(gainNode);
                  gainNode.connect(tempContext.destination);
                  oscillator.start(0);
                  oscillator.stop(tempContext.currentTime + 0.001);
                } catch (e) {
                  console.warn("Temporary audio context creation failed:", e);
                }
              }

              // Try to prime audio regardless of browser
              try {
                if (typeof window.saySilent === "function") {
                  window.saySilent(0);
                  // Add a small delay before any subsequent audio operations
                  setTimeout(() => {
                    try {
                      // Try to start listening after priming
                      if (typeof AI_vhost_api === "function") {
                        AI_vhost_api("startListening");
                      }
                    } catch (err) {
                      console.log(
                        "Post-prime listening activation failed:",
                        err
                      );
                    }
                  }, 100);
                }
              } catch (err) {
                console.log("Audio priming on CONNECT click failed:", err);
              }
            },
            { capture: true }
          );
        }
      });

      // --- Audio Priming for Mobile ---
      let hasPrimed = false;
      function primeAudio() {
        if (!hasPrimed) {
          try {
            // Use SitePal's silent function if available, otherwise ignore
            if (typeof window.saySilent === "function") {
              window.saySilent(0); // Play silent audio

            } else {
              console.log("saySilent not available, skipping audio priming.");
            }
            hasPrimed = true;
          } catch (e) {
            console.error("Error during audio priming:", e);
          }
        }
      }
      // Attach priming to first user interaction
      document.addEventListener("click", primeAudio, { once: true });
      document.addEventListener("touchstart", primeAudio, { once: true });
      // --- End Audio Priming ---

      // Add a function to detect if the three-state approach is needed
      function needsUnmuteState() {
        // iOS and Safari always need the three-state approach
        if (isIOS || browserIsSafari) {

          return true;
        }

        // Mobile devices generally need the user interaction
        if (
          /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(
            navigator.userAgent
          )
        ) {

          return true;
        }

        // Check if URL parameter explicitly requests it
        const urlParams = new URLSearchParams(window.location.search);
        if (
          urlParams.get("unmute") === "true" ||
          urlParams.get("three-state") === "true"
        ) {
       
          return true;
        }

        // For Chrome and other browsers on desktop, auto-transition is generally fine
        console.log(
          "Desktop non-Safari browser detected - will use auto-transition"
        );
        return false;
      }

      // Set the global flag early
      window.needsUnmuteFlow = /iPhone|iPad|iPod|Android|Mobile/i.test(
        navigator.userAgent
      );

      // Toggle call - Refactored Logic with special iOS handling
      callButton.addEventListener("click", () => {
        console.log(
          "Call button clicked, current text:",
          callButton.textContent
        );

        if (callButton.textContent === "CONNECT") {
          // ---- Connect Flow ----

          isCallActive = true;
          window.sceneAlreadyLoaded = false; // Reset this flag when connecting
          window.allowButtonTransition = true; // Allow transitions on new connection
          window.greetingPlayed = false; // Reset greeting flag

          // Stop pulsing of START HERE button when CONNECT is clicked
          const signalButton = document.querySelector('[data-action="signal"]');
          if (signalButton) {
            signalButton.classList.remove("initial-pulse");
          }

          // Disable music and 80s mode toggles during SitePal session
          disableToggles();

          // Reset flag in case needsUnmuteState changes (e.g., browser change)
          window.needsUnmuteFlow = needsUnmuteState();

          // --- Transmission Effect Start ---
          const deadAir = document.getElementById("deadAir");
          const sitepalContainer = document.getElementById("sitepal-container");
          const offlineDisplay = document.getElementById("offline-display"); // Get offline display
          const transmissionEffectDuration = 3500; // ms - Shortened duration
          const fadeOutDuration = 500; // ms (should match CSS transition)

          // Hide offline display
          offlineDisplay.style.display = "none";

          // Make video visible and opaque, then play
          deadAir.style.display = "block";
          deadAir.style.opacity = 1;
          deadAir.style.zIndex = "20"; // Ensure transmission effect is on top during loading
          deadAir.muted = true;
          deadAir.loop = true;
          deadAir
            .play()
            .catch((e) => console.error("Transmission video play failed:", e));

          // Show SitePal container behind the video
          sitepalContainer.style.display = "block";
          sitepalContainer.style.zIndex = "5"; // Lower z-index during loading
          // --- End Transmission Effect Start ---

          // Activate call status indicator
          callStatus.classList.add("active");

          // Clean up any existing instance
          if (sitepalContainer.dataset.initialized === "true") {

            cleanupSitePal();
          }

          // Initialize SitePal
          initSitePal();
          sitepalContainer.dataset.initialized = "true";

          // Update UI
          function updateSelfView() {
            const selfView = document.getElementById("self-view");
            if (!selfView) {
              console.error("Self view element not found");
              return;
            }

            // Set a temporary placeholder
            selfView.innerHTML = '<div class="avatar-placeholder" style="width: 100%; height: 100%; background-color: #333; display: flex; justify-content: center; align-items: center; color: #888; font-size: 2rem;">?</div>';
 
            // --- Add listener for avatar response from parent --- 
            function receiveAvatarUrl(event) {
              // Optional: Add origin check for security in production
              // if (event.origin !== 'YOUR_REACT_APP_ORIGIN') return;

              if (event.data && event.data.type === "AVATAR_RESPONSE") {
                const avatarUrl = event.data.avatarUrl;
                console.log("[Iframe] Received avatar URL from parent:", avatarUrl);

                if (avatarUrl) {
                  const img = document.createElement("img");
                  img.src = avatarUrl;
                  img.alt = "User Avatar";
                  img.style.width = "100%";
                  img.style.height = "100%";
                  img.style.objectFit = "cover"; // Ensure image covers the div
                  img.onerror = () => {
                    console.error("[Iframe] Failed to load avatar image:", avatarUrl);
                    selfView.innerHTML = '<div class="avatar-placeholder" style="width: 100%; height: 100%; background-color: #333; display: flex; justify-content: center; align-items: center; color: #888; font-size: 2rem;">!</div>'; // Error state
                  };
                  selfView.innerHTML = ''; // Clear placeholder
                  selfView.appendChild(img);
                } else {
                  console.log("[Iframe] No valid avatar URL received from parent.");
                  // Keep placeholder or show a different one
                   selfView.innerHTML = '<div class="avatar-placeholder" style="width: 100%; height: 100%; background-color: #333; display: flex; justify-content: center; align-items: center; color: #888; font-size: 2rem;">🥸</div>'; // Indicate missing avatar
                }
                // Clean up listener after receiving the response (optional, depends if you expect multiple updates)
                // window.removeEventListener('message', receiveAvatarUrl);
              }
            }
            window.addEventListener('message', receiveAvatarUrl);
            // --- End listener ---

            // Request avatar from parent
            console.log("[Iframe] Requesting avatar from parent window...");
            window.parent.postMessage({ type: "REQUEST_AVATAR" }, "*");
          }

          // Ensure initSitePal calls updateSelfView *after* the element might exist
          // Or ensure updateSelfView is called at the appropriate time after DOM ready
          // Example: document.addEventListener('DOMContentLoaded', updateSelfView);

          selfView.style.display = "block";
          updateSelfView();
          liveIndicator.style.display = "block";
          stationSelect.disabled = true;

          // Set to UN-MUTE state initially instead of DISCONNECT
          callButton.textContent = "UN-MUTE";
          callButton.classList.add("unmute"); // Add a new class for styling
          callButton.classList.remove("disconnect");


          // Remove initial pulse from CONNECT button
          callButton.classList.remove("initial-pulse");

          // Special handling for iOS - maintain but don't activate mic yet
          if (isIOS || browserIsSafari) {
            console.log(
              "iOS/Safari detected - deferring mic activation until UN-MUTE"
            );

            // Try to prime audio system
            try {
              const tempContext = new (window.AudioContext ||
                window.webkitAudioContext)();
              tempContext.resume().then(() => {
                console.log("Temporary audio context resumed");
              });

              // Create and play a brief silent sound
              const oscillator = tempContext.createOscillator();
              const gainNode = tempContext.createGain();
              gainNode.gain.value = 0.0001; // Nearly silent
              oscillator.connect(gainNode);
              gainNode.connect(tempContext.destination);
              oscillator.start(0);
              oscillator.stop(tempContext.currentTime + 0.001);
            } catch (e) {
              console.warn("Temporary audio context creation failed:", e);
            }
          }

          // Expand video display when connecting
          if (videoDisplay) {
            videoDisplay.classList.add("active");
          }
        } else if (callButton.textContent === "UN-MUTE") {
          // ---- UN-MUTE Flow (Revised for Chrome Mobile) ----
          console.log("➡️ UN-MUTE clicked, activating microphone and audio (Chrome Mobile focus)...");

          // Temporarily disable button to prevent double clicks
          callButton.disabled = true;

          // Step 1: Force button state change immediately
          callButton.textContent = "DISCONNECT";
          callButton.classList.remove("unmute");
          callButton.classList.add("disconnect");

          const handleAudioContextError = () => {
            console.error("❌ Audio context error - falling back to basic functionality");
            playGreeting();
            callButton.disabled = false;
          };

          try {
            const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            audioCtx.resume()
              .then(() => {
                // Try to prime audio system
                try {
                  (window.saySilent || saySilent)?.(0);
                } catch (primeError) {
                  console.warn("⚠️ Error during audio priming:", primeError);
                }

                // Try to start listening
                try {
                  const api = window.AI_vhost_api || AI_vhost_api;
                  if (api) {
                    api("startListening");
                    window.parent.postMessage({ type: "SITEPAL_STATE_CHANGE", isListening: true }, "*");
                  } else {
                    console.warn("❌ No API found to activate microphone");
                  }
                } catch (micError) {
                  console.error("❌ Error activating microphone:", micError);
                }

                playGreeting();
                callButton.disabled = false;
              })
              .catch(handleAudioContextError);
          } catch (contextError) {
            handleAudioContextError();
          }

        } else {
          // ---- Disconnect Flow ----
          isCallActive = false;
          window.sceneAlreadyLoaded = false; // Reset scene loaded flag on disconnect
          enableToggles();
          disconnectCall();
        }
      });

      // Update station
      stationSelect.addEventListener("change", () => {
        updateStationDisplay();
      });

      // Toggle 80s mode
      eightiesToggle.addEventListener("click", () => {
        // Skip toggle if disabled
        if (eightiesToggle.classList.contains('disabled')) {
          console.log("80s mode toggle is currently disabled");
          return;
        }

        const toggleRow = document.querySelector(".toggle-row.mobile-inline");

        // Toggle the isEightiesMode state
        isEightiesMode = !isEightiesMode;

        // Update UI directly
        updateEightiesUI(isEightiesMode);

        // Apply fullscreen layout in 80s mode if screen is wide enough
        if (window.innerWidth >= 768) {
          if (isEightiesMode) {
            toggleRow.classList.add("fullscreen");
          } else {
            toggleRow.classList.remove("fullscreen");
          }
        }

        // Play toggle sound
        try {
          const audioContext = new (window.AudioContext ||
            window.webkitAudioContext)();
          const oscillator = audioContext.createOscillator();
          const gainNode = audioContext.createGain();

          oscillator.type = "sine";
          oscillator.frequency.setValueAtTime(
            isEightiesMode ? 800 : 400,
            audioContext.currentTime
          );
          oscillator.frequency.exponentialRampToValueAtTime(
            isEightiesMode ? 400 : 800,
            audioContext.currentTime + 0.1
          );

          gainNode.gain.setValueAtTime(0.1, audioContext.currentTime);
          gainNode.gain.exponentialRampToValueAtTime(
            0.01,
            audioContext.currentTime + 0.1
          );

          oscillator.connect(gainNode);
          gainNode.connect(audioContext.destination);

          oscillator.start();
          oscillator.stop(audioContext.currentTime + 0.1);
        } catch (e) {
          console.log("Audio context not supported");
        }

        // Notify parent of the mode change
        window.parent.postMessage({ type: "EIGHTIES_MODE_CHANGE" }, "*");
      });

      // Toggle music
      musicToggle.addEventListener("click", () => {
        // Skip toggle if disabled
        if (musicToggle.classList.contains('disabled')) {
 
          return;
        }

        // Toggle the active state visually
        musicToggle.classList.toggle("active");

        // Get the current state
        const isMusicEnabled = musicToggle.classList.contains("active");

        // Play toggle sound
        try {
          const audioContext = new (window.AudioContext ||
            window.webkitAudioContext)();
          const oscillator = audioContext.createOscillator();
          const gainNode = audioContext.createGain();

          oscillator.type = "sine";
          oscillator.frequency.setValueAtTime(
            isMusicEnabled ? 600 : 300,
            audioContext.currentTime
          );
          oscillator.frequency.exponentialRampToValueAtTime(
            isMusicEnabled ? 300 : 600,
            audioContext.currentTime + 0.1
          );

          gainNode.gain.setValueAtTime(0.1, audioContext.currentTime);
          gainNode.gain.exponentialRampToValueAtTime(
            0.01,
            audioContext.currentTime + 0.1
          );

          oscillator.connect(gainNode);
          gainNode.connect(audioContext.destination);

          oscillator.start();
          oscillator.stop(audioContext.currentTime + 0.1);
        } catch (e) {
          console.log("Audio context not supported");
        }

        // Notify parent of the music toggle - this will control both MusicPlayer2 and MusicPlayer3
        window.parent.postMessage(
          {
            type: "MUSIC_TOGGLE",
            enabled: isMusicEnabled,
          },
          "*"
        );
      });

      // Toggle constellations
      constellationToggle.addEventListener("click", () => {
        // We don't need to disable constellation toggle during video/calls
        // so no need to check for disabled state here

        // Toggle the active state visually
        constellationToggle.classList.toggle("active");

        // Get the current state
        const isConstellationsEnabled =
          constellationToggle.classList.contains("active");

        // Play toggle sound
        try {
          const audioContext = new (window.AudioContext ||
            window.webkitAudioContext)();
          const oscillator = audioContext.createOscillator();
          const gainNode = audioContext.createGain();

          oscillator.type = "sine";
          oscillator.frequency.setValueAtTime(
            isConstellationsEnabled ? 500 : 300,
            audioContext.currentTime
          );
          oscillator.frequency.exponentialRampToValueAtTime(
            isConstellationsEnabled ? 300 : 500,
            audioContext.currentTime + 0.1
          );

          gainNode.gain.setValueAtTime(0.1, audioContext.currentTime);
          gainNode.gain.exponentialRampToValueAtTime(
            0.01,
            audioContext.currentTime + 0.1
          );

          oscillator.connect(gainNode);
          gainNode.connect(audioContext.destination);

          oscillator.start();
          oscillator.stop(audioContext.currentTime + 0.1);
        } catch (e) {
          console.log("Audio context not supported");
        }

        // Notify parent of the constellation toggle
        window.parent.postMessage(
          {
            type: "CONSTELLATION_TOGGLE",
            enabled: isConstellationsEnabled,
          },
          "*"
        );

  
      });

      function updateEightiesUI(isActive) {
        const missionControl = document.getElementById("mission-control");
        const scanLines = document.getElementById("scan-lines");
        const colorShiftRed = document.getElementById("color-shift-red");
        const colorShiftBlue = document.getElementById("color-shift-blue");
        const blinkingCursor = document.getElementById("blinking-cursor");
        const mp3Indicator = document.getElementById("mp3-indicator");
        const threeRedShadow = document.getElementById("threedy-shadow-red");
        const threeBlueShadow = document.getElementById("threedy-shadow-blue");
        const wireframeBackdrop = document.getElementById("wireframe-backdrop");
        const videoFeed = document.getElementById("video-feed");
        const deadAir = document.getElementById("deadAir");
        const videoDisplay = document.querySelector(".video-display"); // Get video display element

        // 80s mode vaporwave video effect (inject into #video-feed, not #offline-display)
        if (videoFeed) {
          let vaporVideo = videoFeed.querySelector('video[data-vaporwave]');
          if (isActive) {
            // Hide deadAir
            if (deadAir) {
              deadAir.style.display = 'none';
              deadAir.pause && deadAir.pause();
            }
            // Add vaporwave video if not present
            if (!vaporVideo) {
              vaporVideo = document.createElement('video');
              vaporVideo.setAttribute('src', '/vaporwave-sunset.mp4');
              vaporVideo.setAttribute('loop', '');
              vaporVideo.setAttribute('muted', '');
              vaporVideo.setAttribute('autoplay', '');
              vaporVideo.setAttribute('playsinline', '');
              vaporVideo.setAttribute('webkit-playsinline', '');
              vaporVideo.setAttribute('data-vaporwave', 'true');
              vaporVideo.style.width = '100%';
              vaporVideo.style.height = '100%';
              vaporVideo.style.objectFit = 'cover';
              vaporVideo.style.position = 'absolute';
              vaporVideo.style.top = '0';
              vaporVideo.style.left = '0';
              vaporVideo.style.zIndex = '20';
              vaporVideo.style.pointerEvents = 'none';
              videoFeed.insertBefore(vaporVideo, videoFeed.firstChild); // Insert as first child
              vaporVideo.play().catch(() => {});
            } else {
              vaporVideo.style.display = '';
              vaporVideo.play().catch(() => {});
            }
          } else {
            // Show deadAir
            if (deadAir) {
              deadAir.style.display = '';
            }
            // Remove vaporwave video if present
            if (vaporVideo) {
              vaporVideo.pause();
              vaporVideo.remove();
            }
          }
        }

        // Clear any previous intervals
        if (window.eightiesInterval) {
          clearInterval(window.eightiesInterval);
          window.eightiesInterval = null;
        }

        if (isActive) {
          eightiesToggle.classList.add("active");
          if (missionControl) {
            missionControl.classList.add("eighties-active");
            missionControl.classList.remove("threedy-mode");
          }
          if (scanLines) scanLines.classList.add("active");
          if (colorShiftRed) colorShiftRed.classList.add("active");
          if (colorShiftBlue) colorShiftBlue.classList.add("active");
          if (blinkingCursor) blinkingCursor.style.display = "inline-block";

          isEightiesMode = true;

          // Hide 3D shadows in 80s mode
          if (threeRedShadow) threeRedShadow.style.display = "none";
          if (threeBlueShadow) threeBlueShadow.style.display = "none";

          // Update system status text
          const statusLabel = document.querySelector(".status-label");
          if (statusLabel) {
            statusLabel.textContent = "RETRO";
            // Remove 3D text shadows for 80s mode
            statusLabel.style.textShadow = "0 0 3px #22d3ee";
          }

          // Remove 3D text shadows from all elements in 80s mode
          document
            .querySelectorAll(
              ".control-button, .toggle-label, .status-label, .leaderboard-header"
            )
            .forEach((element) => {
              // Use appropriate 80s text shadow instead
              element.style.textShadow = "0 0 3px #d946ef";
            });

          // Add some random glitches (reduced frequency and opacity)
          window.eightiesInterval = setInterval(() => {
            if (Math.random() > 0.97 && scanLines) {
              scanLines.style.opacity = "0.6";
              setTimeout(() => {
                if (scanLines) scanLines.style.opacity = "0.7";
              }, 100);
            }
          }, 3000);

          // If music is active, notify the parent to use
          // Add class to body for additional styles
          document.body.classList.add("eighties-mode");

          // Expand video display on mobile when activating 80s mode
          if (videoDisplay && window.innerHeight <= 700) {
             videoDisplay.classList.add("active", "touched"); // Add 'touched' to prevent auto-collapse/pulse
             // Explicitly set height to ensure it overrides styles
             videoDisplay.style.height = '180px';
          }

        } else {
          eightiesToggle.classList.remove("active");
          if (missionControl) {
            missionControl.classList.remove("eighties-active");
            missionControl.classList.add("threedy-mode");
          }
          if (scanLines) scanLines.classList.remove("active");
          if (colorShiftRed) colorShiftRed.classList.remove("active");
          if (colorShiftBlue) colorShiftBlue.classList.remove("active");
          if (blinkingCursor) blinkingCursor.style.display = "none";

          // Fade out wireframe backdrop

          isEightiesMode = false;

          // Show 3D shadows when not in 80s mode
          if (threeRedShadow) threeRedShadow.style.display = "block";
          if (threeBlueShadow) threeBlueShadow.style.display = "block";

          // Hide MP3 indicator
          if (mp3Indicator) {
            mp3Indicator.style.display = "none";
          }

          // Reset status text to 3D style
          const statusLabel = document.querySelector(".status-label");
          if (statusLabel) {
            statusLabel.textContent = "3D//ACTIVE";
            statusLabel.style.textShadow = "-1px 0 #ff0040, 1px 0 #00b4ff";
          }

          // Apply 3D text shadows to all elements when not in 80s mode
          document
            .querySelectorAll(
              ".control-button, .toggle-label, .status-label, .leaderboard-header"
            )
            .forEach((element) => {
              element.style.textShadow = "-1px 0 #ff0040, 1px 0 #00b4ff";
            });

          // Remove eighties mode class from body
          document.body.classList.remove("eighties-mode");

          // Collapse video display on mobile when deactivating 80s mode (if not in a call)
          if (videoDisplay && window.innerHeight <= 700 && !isCallActive) {
            videoDisplay.classList.remove("active");
            // Reset height to allow CSS to control it
            videoDisplay.style.height = '';
          }
        }

        document.documentElement.style.setProperty(
          "--eighties-color",
          isActive ? "#2a1786" : "transparent"
        );

        // REMOVED: The problematic code that was forcing 3D mode and hiding wireframe
        // regardless of the eighties mode setting
      }

      // Notify parent that music should be hidden

      function updateLeaderboardUI() {
        // Get fresh references to the elements
        const content = document.getElementById("leaderboard-content");
        const arrow = document.getElementById("leaderboard-arrow");
        
        if (!content) return; // Exit if element not found
        
        
        // Use direct style application for guaranteed effect
        content.style.display = isLeaderboardExpanded ? "block" : "none";
        if (arrow) arrow.textContent = isLeaderboardExpanded ? "▲" : "▼";
      }

      updateLeaderboardUI(); // Initialize leaderboard state

      // Also update leaderboard state on window resize
      window.addEventListener("resize", function() {
        // Only auto-adjust the leaderboard expansion state if the user hasn't manually toggled it yet
        if (!window.leaderboardManuallyToggled) {
          isLeaderboardExpanded = window.innerWidth >= 768;
          updateLeaderboardUI();
        }
      });

      // Apply appropriate UI state based on URL parameters
      const urlParams = new URLSearchParams(window.location.search);
      const startIn80sMode = urlParams.get("eighties") === "true";

      if (startIn80sMode) {
        isEightiesMode = true;
        updateEightiesUI(true);
      } else {
        isEightiesMode = false;
        updateEightiesUI(false);

        // If not starting in 80s mode, ensure 3D effect is applied
        const missionControlPanel = document.getElementById("mission-control");
      }

      // Ensure system status is always on
      if (systemStatus) systemStatus.classList.add("active");

      // Toggle Leaderboard
      const leaderboardToggle = document.getElementById("leaderboard-toggle");
      if (leaderboardToggle) {
        leaderboardToggle.addEventListener("click", () => {
          // Toggle state
          isLeaderboardExpanded = !isLeaderboardExpanded;
          window.leaderboardManuallyToggled = true; // Mark that user manually toggled
          
          // Get direct reference to content
          const content = document.getElementById("leaderboard-content");
          const arrow = document.getElementById("leaderboard-arrow");
          
          // Apply change directly without going through updateLeaderboardUI
          if (content) {
            content.style.display = isLeaderboardExpanded ? "block" : "none";
          }
          
          if (arrow) {
            arrow.textContent = isLeaderboardExpanded ? "▲" : "▼";
          }
          

          
          playClickSound(); // Add click sound feedback
        });
      }

      // Event Listeners for Control Buttons
      document.querySelectorAll(".control-button").forEach((button) => {
        button.addEventListener("click", () => {
          playClickSound();
          const action = button.getAttribute("data-action");
          handleControlAction(action);
        });
      });

      // Handle Control Actions
      function handleControlAction(action) {
        const button = document.querySelector(`[data-action="${action}"]`);
        const indicator = button.querySelector(".button-indicator");
        if (!indicator) return;

        // Add active state to the button
        button.classList.add("active");
        indicator.classList.add("active");

        // Handle specific actions
        switch (action) {
          case "signal":
            // --- Start: Prime audio context on signal click ---
            try {
              const tempContext = new (window.AudioContext || window.webkitAudioContext)();
              // Create a dummy buffer source node - this alone might be enough
              const bufferSource = tempContext.createBufferSource();
              bufferSource.connect(tempContext.destination);
              // Resume context if needed (especially after page load)
              tempContext.resume().then(() => {

                 setTimeout(() => tempContext.close(), 500);
              }).catch(e => console.warn("AudioContext resume failed on prime:", e));
            } catch (e) {
              console.warn("AudioContext priming failed:", e);
            }
            // --- End: Prime audio context ---

            // Check if orientation is complete
            if (isOrientationComplete) {
              // If orientation is complete, handle SitePal connection like call-button
              
              const signalButtonLabel = button.querySelector(".button-label");
              if (!signalButtonLabel) break;
              
              // Get the current button state (CONNECT/UN-MUTE/DISCONNECT)
              const currentState = signalButtonLabel.textContent;
              
              if (currentState === "CONNECT") {
                // --- CONNECT Flow ---
                console.log("Signal button initiating SitePal connection with transmission effect...");
                
                isCallActive = true;
                window.sceneAlreadyLoaded = false;
                window.allowButtonTransition = true;
                window.greetingPlayed = false;
                
                // Disable music and 80s mode toggles during SitePal session
                disableToggles();
                
                // Reset flag in case needsUnmuteState changes
                window.needsUnmuteFlow = needsUnmuteState();
                
                // --- Transmission Effect Start ---
                const deadAir = document.getElementById("deadAir");
                const sitepalContainer = document.getElementById("sitepal-container");
                const offlineDisplay = document.getElementById("offline-display");
                const transmissionEffectDuration = 3500;
                const fadeOutDuration = 500;
                
                // Hide offline display
                offlineDisplay.style.display = "none";
                
                // Make video visible and opaque, then play
                deadAir.style.display = "block";
                deadAir.style.opacity = 1;
                deadAir.style.zIndex = "20";
                deadAir.muted = true;
                deadAir.loop = true;
                deadAir.play().catch((e) => console.error("Transmission video play failed:", e));
                
                // Show SitePal container behind the video
                sitepalContainer.style.display = "block";
                sitepalContainer.style.zIndex = "5";
                
                // Activate call status indicator
                const callStatus = document.getElementById("call-status");
                if (callStatus) callStatus.classList.add("active");
                
                // Clean up any existing instance
                if (sitepalContainer.dataset.initialized === "true") {
                  cleanupSitePal();
                }
                
                // Initialize SitePal
                initSitePal();
                sitepalContainer.dataset.initialized = "true";
                
                // Update self view
                const selfView = document.getElementById("self-view");
                if (selfView) {
                  selfView.style.display = "block";
                  updateSelfView();
                }
                
                const liveIndicator = document.getElementById("live-indicator");
                if (liveIndicator) liveIndicator.style.display = "block";
                
                const stationSelect = document.getElementById("station-select");
                if (stationSelect) stationSelect.disabled = true;
                
                // Update button state
                signalButtonLabel.textContent = "UN-MUTE";
                button.classList.add("unmute");
                button.classList.remove("disconnect");
                button.classList.remove("initial-pulse");
                
                // Special handling for iOS
                if (isIOS || browserIsSafari) {
                  console.log("iOS/Safari detected - deferring mic activation until UN-MUTE");
                  
                  // Try to prime audio system
                  try {
                    const tempContext = new (window.AudioContext || window.webkitAudioContext)();
                    tempContext.resume().then(() => {
                      console.log("Temporary audio context resumed");
                    });
                    
                    // Create and play a brief silent sound
                    const oscillator = tempContext.createOscillator();
                    const gainNode = tempContext.createGain();
                    gainNode.gain.value = 0.0001;
                    oscillator.connect(gainNode);
                    gainNode.connect(tempContext.destination);
                    oscillator.start(0);
                    oscillator.stop(tempContext.currentTime + 0.001);
                  } catch (e) {
                    console.warn("Temporary audio context creation failed:", e);
                  }
                }
                
                // Expand video display
                const videoDisplay = document.querySelector(".video-display");
                if (videoDisplay) {
                  videoDisplay.classList.add("active");
                }
              } else if (currentState === "UN-MUTE") {
                // --- UN-MUTE Flow ---
                console.log("Signal button in UN-MUTE state - activating microphone...");
                
                // Temporarily disable button to prevent double clicks
                button.disabled = true;
                
                // Step 1: Force button state change immediately
                signalButtonLabel.textContent = "DISCONNECT";
                button.classList.remove("unmute");
                button.classList.add("disconnect");
                
                const handleAudioContextError = () => {
                  console.error("Audio context error - falling back to basic functionality");
                  playGreeting();
                  button.disabled = false;
                };
                
                try {
                  const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                  audioCtx.resume()
                    .then(() => {
                      // Try to prime audio system
                      try {
                        (window.saySilent || saySilent)?.(0);
                      } catch (primeError) {
                        console.warn("Error during audio priming:", primeError);
                      }
                      
                      // Try to start listening
                      try {
                        const api = window.AI_vhost_api || AI_vhost_api;
                        if (api) {
                          api("startListening");
                          window.parent.postMessage({ type: "SITEPAL_STATE_CHANGE", isListening: true }, "*");
                        } else {
                          console.warn("No API found to activate microphone");
                        }
                      } catch (micError) {
                        console.error("Error activating microphone:", micError);
                      }
                      
                      playGreeting();
                      button.disabled = false;
                    })
                    .catch(handleAudioContextError);
                } catch (contextError) {
                  handleAudioContextError();
                }
              } else if (currentState === "DISCONNECT") {
                // --- Disconnect Flow ---
                console.log("Signal button in DISCONNECT state - disconnecting...");
                isCallActive = false;
                window.sceneAlreadyLoaded = false;
                enableToggles();
                disconnectCall();
                
                // Reset signal button to CONNECT AVATAR state
                const buttonLabel = button.querySelector('.button-label');
                if (buttonLabel) {
                  buttonLabel.textContent = "CONNECT";
                }
                button.classList.remove("unmute", "disconnect");
                button.classList.add("initial-pulse");
              }
            } else {
              // Check if orientation video is already playing
              const orientationVideo = document.getElementById('orientation-video');
              
              if (orientationVideo) {
                // Stop and clean up the video
                stopOrientationVideo();
                
                // Provide user feedback
                button.classList.add("active");
                setTimeout(() => {
                  button.classList.remove("active");
                }, 500);
              } else {
                playOrientationVideo();
              }
            }
            break;
          case "ignition":
  
            // Send message to parent to toggle launch mode
            window.parent.postMessage({ type: "LAUNCH_MODE_TOGGLE" }, "*");
            break;
          case "launch":

            break;
          case "return":

            // Navigate to the home page
            window.parent.postMessage({ type: "NAVIGATE_TO_HOME" }, "*");
            break;
        }

        // Remove active states after animation (except for signal when stopping video)
        if (!(action === "signal" && document.getElementById('orientation-video'))) {
          setTimeout(() => {
            button.classList.remove("active");
            indicator.classList.remove("active");
          }, 2000);
        }
      }

      // Function to stop orientation video and clean up
      function stopOrientationVideo() {
        const orientationVideo = document.getElementById('orientation-video');
        const deadAir = document.getElementById("deadAir");
        const offlineDisplay = document.getElementById("offline-display");
        const transcriptToggleBtn = document.getElementById("transcript-toggle-btn");
        const loadingIndicator = document.querySelector('.video-loading-indicator');
        const transcriptContainer = document.getElementById('transcript-container');
        
        if (!orientationVideo) return;
        
        // First stop video playback
        orientationVideo.pause();
        
        // Remove CC button pulse animation and hide it
        if (transcriptToggleBtn) {
          transcriptToggleBtn.classList.remove('pulse-attention');
          transcriptToggleBtn.style.display = 'none';
        }
        
        // Hide transcript if visible
        if (transcriptContainer && transcriptContainer.style.display !== 'none') {
          transcriptContainer.style.display = 'none';
        }
        
        // Clear transcript interval
        if (window.transcriptInterval) {
          clearInterval(window.transcriptInterval);
          window.transcriptInterval = null;
        }
        
        // Re-enable the toggles
        if (typeof enableToggles === 'function' && !isCallActive) {
          enableToggles();
        }
        
        // Remove loading indicator if present
        if (loadingIndicator) {
          loadingIndicator.remove();
        }
        
        // Start a quick fade-out transition
        orientationVideo.style.opacity = '0';
        orientationVideo.style.transition = 'opacity 0.3s ease-in-out';
        
        // After fade transition completes, remove the video and clean up
        setTimeout(() => {
          // Clean up video resources
          orientationVideo.removeAttribute('src');
          orientationVideo.load(); // Force browser to release resources
          orientationVideo.remove();
          
          // Show offline display again
          if (offlineDisplay) {
            offlineDisplay.style.display = 'flex';
            offlineDisplay.innerHTML = '<span>SYS//OFFLINE</span><div class="crosshair-h"></div><div class="crosshair-v"></div><div class="scanlines-overlay"></div>';
          }
          
          // Show deadAir again
          if (deadAir) {
            deadAir.style.display = '';
            deadAir.play().catch(e => console.log("Couldn't restart deadAir:", e));
          }
          

        }, 300); // 300ms for opacity transition
      }

 

      // At the end of the file, add this script to resize the container
      document.addEventListener("DOMContentLoaded", function () {
 
        
        // Initialize leaderboard state based on screen size
        const leaderboardContent = document.getElementById("leaderboard-content");
        const leaderboardArrow = document.getElementById("leaderboard-arrow");
        if (leaderboardContent && window.innerWidth >= 768) {
          leaderboardContent.style.display = "block";
          if (leaderboardArrow) {
            leaderboardArrow.textContent = "▲";
          }
          isLeaderboardExpanded = true;
        }
        
        // Check for reset parameter to clear orientation viewed state (for testing)
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get("resetOrientation") === "true") {
          localStorage.removeItem('orientationViewed');
        }
        
        // Check if orientation has been viewed
        const orientationViewed = localStorage.getItem('orientationViewed') === 'true';
        isOrientationComplete = orientationViewed; // Set our state variable
        
        // Make sure button states are properly initialized
        const signalButton = document.querySelector('[data-action="signal"]');
        const connectButton = document.getElementById("call-button");
        
        // Clear any existing pulse classes first
        if (signalButton) signalButton.classList.remove("initial-pulse");
        if (connectButton) connectButton.classList.remove("initial-pulse");
        
        // Then apply the correct pulse class based on state
        if (orientationViewed) {
          // If orientation has been viewed, update signal button text and pulse
          if (signalButton) {
            const buttonLabel = signalButton.querySelector('.button-label');
            if (buttonLabel) {
              buttonLabel.textContent = "CONNECT";
            }
            signalButton.classList.add("initial-pulse");
          }
          // Hide the call button since signal button now has its functionality
          if (connectButton) {
            connectButton.style.display = "none";
          }
        } else {
          // If orientation hasn't been viewed, pulse the SIGNAL button with START HERE text
          if (signalButton) {
            const buttonLabel = signalButton.querySelector('.button-label');
            if (buttonLabel) {
              buttonLabel.textContent = "START HERE";
            }
            signalButton.classList.add("initial-pulse");
          }
        }
        
        // Simple video display expansion handling (like previous version)
        const videoDisplay = document.querySelector('.video-display');
        if (videoDisplay) {
          // Initialize the display state based on screen height
          if (window.innerHeight <= 700 && !isCallActive) {
            videoDisplay.classList.remove("active");
          } else {
            videoDisplay.classList.add("active");
          }
          
          // Simple click handler for toggling
          videoDisplay.addEventListener('click', function() {
            // Add touched class to stop pulsing animation
            this.classList.add('touched');
            
            // Simple toggle for active class
            if (this.classList.contains('active')) {
              // Only collapse if we're on mobile and not in a call
              if (window.innerHeight <= 700 && !isCallActive) {
                this.classList.remove('active');
              }
            } else {
              this.classList.add('active');
              
              // Auto-collapse after 5 seconds if not in a call and on mobile
              if (window.innerHeight <= 700 && !isCallActive) {
                setTimeout(() => {
                  if (!isCallActive) {
                    this.classList.remove('active');
                  }
                }, 5000);
              }
            }
          });
        }
        
        // Function to adjust height to fill viewport
        function adjustHeight() {
          const missionControl = document.querySelector(".mission-control");
          if (missionControl) {
            const viewportHeight = window.innerHeight;
            missionControl.style.minHeight = `${viewportHeight}px`;
          }
        }

        // Run on load and resize
        adjustHeight();
        window.addEventListener("resize", adjustHeight);
      });

        });
      }

      // Helper function to handle video play errors
      function handleVideoPlayError(videoElement, offlineDisplay) {
        console.error("Video play error - handling fallback");
        
        // Hide video and show error message
        if (videoElement) {
          videoElement.style.display = 'none';
          
          // Clean up resources
          try {
            videoElement.pause();
            videoElement.removeAttribute('src');
            videoElement.load();
          } catch (e) {
            console.log("Error cleaning up video on error:", e);
          }
        }
        
        // Show offline display with error message
        if (offlineDisplay) {
          offlineDisplay.style.display = 'flex';
          offlineDisplay.innerHTML = '<span>TRANSMISSION ERROR</span><div class="crosshair-h"></div><div class="crosshair-v"></div><div class="scanlines-overlay"></div>';
        }
        
        // Enable toggles that might have been disabled
        enableToggles();
        
        // Remove any loading indicators
        const loadingIndicator = document.querySelector('.video-loading-indicator');
        if (loadingIndicator && loadingIndicator.parentNode) {
          loadingIndicator.remove();
        }
      }

      // Helper function to play the greeting
      function playGreeting() {
        console.log("    Attempting to play greeting...");
        const greetingText = "Hello, I am ready to assist you.";
        let greetingPlayed = false;

        const windowSayText = typeof window.sayText === "function";
        const windowVhostApi = typeof window.AI_vhost_api === "function";
        const localSayText = typeof sayText === "function";
        const localVhostApi = typeof AI_vhost_api === "function";

        console.log("      Available speech APIs:", { windowSayText, windowVhostApi, localSayText, localVhostApi });

        try {
          if (windowSayText) {
            window.sayText(greetingText, 9, 1, 7);
            greetingPlayed = true;
            console.log("      ✓ Greeting initiated with window.sayText");
          } else if (windowVhostApi) {
            window.AI_vhost_api("say", greetingText);
            greetingPlayed = true;
            console.log("      ✓ Greeting initiated with window.AI_vhost_api('say')");
          } else if (localSayText) {
            sayText(greetingText, 9, 1, 7);
            greetingPlayed = true;
            console.log("      ✓ Greeting initiated with local sayText");
          } else if (localVhostApi) {
            AI_vhost_api("say", greetingText);
            greetingPlayed = true;
            console.log("      ✓ Greeting initiated with local AI_vhost_api('say')");
          } else {
            console.warn("      ⚠️ No available API found to play greeting.");
          }
        } catch (e) {
          console.warn("      ⚠️ Error occurred while trying to play greeting:", e);
        }
        return greetingPlayed;
      }

      
    // </script>
    
    <!-- Initialize leaderboard arrow on desktop -->
    <script>
      // Set leaderboard arrow on page load for desktop
      document.addEventListener('DOMContentLoaded', function() {
        const arrow = document.getElementById('leaderboard-arrow');
        if (arrow && window.innerWidth >= 768) {
          arrow.textContent = '▲';
        }
      });
    </script>
    
    <!-- Immediate execution script for leaderboard -->
    <script>
      // Run immediately after page parsing
      (function() {
        if (window.innerWidth >= 768) {
          const content = document.getElementById('leaderboard-content');
          const arrow = document.getElementById('leaderboard-arrow');
          
          if (content) content.style.display = 'block';
          if (arrow) arrow.textContent = '▲';
          
          if (typeof isLeaderboardExpanded !== 'undefined') {
            isLeaderboardExpanded = true;
          }
          
          console.log('Leaderboard expanded for desktop via immediate script');
        }
      })();
    </script>

    <!-- Toggle control functions in a proper script tag -->
    <script>
      // Function to disable music and 80s toggles
      function disableToggles() {
        const musicToggle = document.getElementById("music-toggle");
        const eightiesToggle = document.getElementById("eighties-toggle");
        const musicLabel = musicToggle?.closest('.toggle-group')?.querySelector('.toggle-label');
        const eightiesLabel = eightiesToggle?.closest('.toggle-group')?.querySelector('.toggle-label');
        
        // Disable the toggle switches
        if (musicToggle) {
          musicToggle.classList.add('disabled');
          musicToggle.setAttribute('data-disabled', 'true');
        }
        
        if (eightiesToggle) {
          eightiesToggle.classList.add('disabled');
          eightiesToggle.setAttribute('data-disabled', 'true');
        }
        
        // Also dim the labels
        if (musicLabel) musicLabel.classList.add('disabled');
        if (eightiesLabel) eightiesLabel.classList.add('disabled');
        
        console.log("Toggles disabled during media playback");
      }

      // Function to re-enable music and 80s toggles
      function enableToggles() {
        const musicToggle = document.getElementById("music-toggle");
        const eightiesToggle = document.getElementById("eighties-toggle");
        const musicLabel = musicToggle?.closest('.toggle-group')?.querySelector('.toggle-label');
        const eightiesLabel = eightiesToggle?.closest('.toggle-group')?.querySelector('.toggle-label');
        
        // Re-enable the toggle switches
        if (musicToggle && musicToggle.getAttribute('data-disabled') === 'true') {
          musicToggle.classList.remove('disabled');
          musicToggle.removeAttribute('data-disabled');
        }
        
        if (eightiesToggle && eightiesToggle.getAttribute('data-disabled') === 'true') {
          eightiesToggle.classList.remove('disabled');
          eightiesToggle.removeAttribute('data-disabled');
        }
        
        // Also restore the labels
        if (musicLabel) musicLabel.classList.remove('disabled');
        if (eightiesLabel) eightiesLabel.classList.remove('disabled');
        
        console.log("Toggles re-enabled");
      }
    </script>
  </body>
</html>